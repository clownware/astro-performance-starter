{
  // Markdownlint configuration for Astro Performance Starter
  "config": {
    // Disable rules that conflict with MDX or Astro patterns
    "MD013": false, // Line length - let prettier handle this
    "MD033": false, // HTML tags allowed in MDX
    "MD041": false, // First line doesn't need to be h1 (frontmatter comes first)
    "MD046": false, // Code block style - allow both fenced and indented
    "MD024": {
      "siblings_only": true // Allow duplicate headings in different sections
    },
    "MD025": false, // Multiple h1 allowed (page title + content h1)
    "MD026": false, // Trailing punctuation in headings allowed
    "MD036": false, // Emphasis used instead of header - common in docs
    "MD040": false, // Language specification for code blocks - not always needed
    "MD051": false, // Link fragments - Astro handles these differently
    "MD053": false, // Link reference definitions - not always at end in MDX
    
    // Customize rules for better DX
    "MD003": { "style": "atx" }, // Use # style headers
    "MD004": { "style": "dash" }, // Use - for unordered lists
    "MD007": { "indent": 2 }, // Unordered list indentation
    "MD010": { "spaces_per_tab": 2 }, // Tab spacing
    "MD012": { "maximum": 2 }, // Maximum blank lines
    "MD022": { "lines_above": 1, "lines_below": 1 }, // Headers spacing
    "MD032": true, // Lists spacing
    "MD035": { "style": "---" } // Horizontal rule style
  },
  // Ensure YAML front matter is recognized and ignored by lint rules
  // This prevents false positives like MD003/MD022 on front matter lines
  "markdownlintOptions": {
    "frontMatter": "^---\\r?\\n[\\s\\S]*?\\r?\\n---\\r?\\n"
  },
  
  // File patterns to lint
  "globs": [
    "**/*.md",
    "**/*.mdx"
  ],
  
  // Ignore patterns
  "ignores": [
    "node_modules/**",
    ".pnpm/**",
    "dist/**",
    ".astro/**",
    "CHANGELOG.md", // Often auto-generated
    "**/CHANGELOG.md"
  ],
  
  // Fix mode settings
  "fix": true,
  "outputFormatters": [
    ["markdownlint-cli2-formatter-default"]
  ]
}