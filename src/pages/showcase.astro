---
import { getCollection } from "astro:content";
import markPrimary from "@/assets/brand/mark-primary.svg";
import AnimatedGradientText from "@/components/atoms/AnimatedGradientText.astro";
import Badge from "@/components/atoms/Badge.astro";
import Button from "@/components/atoms/Button.astro";
import CounterBadge from "@/components/atoms/CounterBadge.astro";
import Icon from "@/components/atoms/Icon.astro";
import Image from "@/components/atoms/Image.astro";
import ReadingProgress from "@/components/atoms/ReadingProgress.astro";
import ScrollReveal from "@/components/atoms/ScrollReveal.astro";
import SocialLink from "@/components/atoms/SocialLink.astro";
import ThemeToggle from "@/components/atoms/ThemeToggle.astro";
import Tooltip from "@/components/atoms/Tooltip.astro";
import MotionLab from "@/components/islands/MotionLab.tsx";
import SignalsCounter from "@/components/islands/SignalsCounter.tsx";
import Blockquote from "@/components/mdx/Blockquote.astro";
import Callout from "@/components/mdx/Callout.astro";
import CodeFromFile from "@/components/mdx/CodeFromFile.astro";
import Figure from "@/components/mdx/Figure.astro";
import MdxLink from "@/components/mdx/Link";
import Card from "@/components/molecules/Card.astro";
import ColorTokenSwatch from "@/components/molecules/ColorTokenSwatch.astro";
import Dialog from "@/components/molecules/Dialog.astro";
import ExpandableFeatureCard from "@/components/molecules/ExpandableFeatureCard.astro";
import PaletteBand from "@/components/molecules/PaletteBand.astro";
import PostCard from "@/components/molecules/PostCard.astro";
import ProjectCard from "@/components/molecules/ProjectCard.astro";
import ScrollSpy from "@/components/molecules/ScrollSpy.astro";
import SectionSeparator from "@/components/molecules/SectionSeparator.astro";
import ShowcaseExample from "@/components/molecules/ShowcaseExample.astro";
import Tabs from "@/components/molecules/Tabs.astro";
import TypeSpecimen from "@/components/molecules/TypeSpecimen.astro";
import Container from "@/components/structural/Container.astro";
import Grid from "@/components/structural/Grid.astro";
import ParallaxSection from "@/components/structural/ParallaxSection.astro";
import Section from "@/components/structural/Section.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedPosts } from "@/utils/blog";
import { formatPostMetadata } from "@/utils/formatDate";
import { withBase } from "@/utils/url-utils";

// ScrollSpy section list — keep IDs in sync with the <Section id="…"> values below.
const spySections = [
  { id: "system", label: "System" },
  { id: "color", label: "Color" },
  { id: "type", label: "Type" },
  { id: "motion", label: "Motion" },
  { id: "components", label: "Components" },
  { id: "content", label: "Content" },
];

// Live data for the component demos — real collection entries, not invented.
const publishedPosts = await getPublishedPosts();
const demoPost = publishedPosts[0]
  ? {
      ...publishedPosts[0],
      metadata: formatPostMetadata(publishedPosts[0].data.date, publishedPosts[0].body),
    }
  : null;
const projectEntries = await getCollection("projects");
const demoProject = projectEntries[0] ?? null;
---

<BaseLayout
  title="Design System"
  description="The Astro Performance Starter design system, demonstrated by a page styled entirely by it — colour, type, motion and components, all token-driven and zero-JS."
>
  <ReadingProgress color="gradient" />

  <div class="lg:grid lg:grid-cols-[220px_1fr] lg:gap-8 max-w-7xl mx-auto px-4 sm:px-6">
    {/* ScrollSpy sidebar — sticky on desktop, horizontal scroll on mobile */}
    <aside class="hidden lg:block">
      <div class="sticky top-24 py-8">
        <p class="text-xs font-semibold text-muted-foreground uppercase tracking-wider mb-3">
          On this page
        </p>
        <ScrollSpy sections={spySections} ariaLabel="Table of contents" />
      </div>
    </aside>

    {/* Mobile ScrollSpy — horizontal */}
    <div class="lg:hidden sticky top-16 z-40 bg-background/95 backdrop-blur-sm border-b border-border -mx-4 px-4 sm:-mx-6 sm:px-6 overflow-x-clip">
      <ScrollSpy sections={spySections} ariaLabel="Section navigation" />
    </div>

    <div class="min-w-0">
      {/* ================================================================
          HERO SECTION
          ================================================================ */}
      <ParallaxSection intensity="subtle" ariaLabel="Design system hero">
        <Section id="system" class="pt-12 pb-16 sm:pt-16 sm:pb-20">
          <div class="max-w-3xl">
            <Badge variant="primary" size="sm" class="mb-6">✦ Astro 7 · zero-JS baseline</Badge>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6 leading-[1.02]">
              <span class="block text-foreground">Restraint, then</span>
              <AnimatedGradientText as="span" speed="slow" morph class="block">one bright move.</AnimatedGradientText>
            </h1>

            <p class="text-lg sm:text-xl text-muted-foreground mb-10 max-w-2xl">
              A performance-first starter, dressed in a cold-minimal, dark-first system.
              Near-monochrome surfaces; a single animated OKLCH gradient — violet to crimson,
              deliberately taking the long way round the hue wheel — does all the talking.
              This page is styled entirely by the tokens it documents.
            </p>

            {/* Stats row — real numbers */}
            <div class="flex flex-wrap gap-8 sm:gap-12">
              <CounterBadge value={40} suffix="+" label="Components" />
              <CounterBadge value={0} suffix=" KB" label="New JS Added" />
              <CounterBadge value={95} suffix="+" label="Lighthouse" />
            </div>
          </div>
        </Section>
      </ParallaxSection>

      <SectionSeparator />

      {/* ================================================================
          SYSTEM — re-theme point of view
          ================================================================ */}
      <Section class="py-12">
        <Container>
          <ScrollReveal>
            <p class="text-sheen text-xs font-semibold uppercase tracking-wider mb-2">The point of view</p>
            <h2 class="text-3xl font-bold text-foreground mb-3">A system you can re-theme, not just read</h2>
            <p class="text-muted-foreground max-w-2xl mb-10">
              Every pixel here is painted by tokens in <code class="text-sm bg-surface px-1.5 py-0.5 rounded-md">tokens/base.json</code> —
              the swatches, the type scale, the gallery, this paragraph. Change values in one file
              and the whole system re-skins: no component edits, no hunting hardcoded colours.
            </p>
          </ScrollReveal>

          <ScrollReveal>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
              <Card>
                <div class="p-4">
                  <p class="text-xs uppercase tracking-wider text-muted-foreground mb-1">Edit</p>
                  <p class="font-mono font-semibold text-link text-sm mb-1">base.json</p>
                  <p class="text-xs text-muted-foreground">Adjust a hue, a step, the gradient stops or the fontFamily group.</p>
                </div>
              </Card>
              <Card>
                <div class="p-4">
                  <p class="text-xs uppercase tracking-wider text-muted-foreground mb-1">Run</p>
                  <p class="font-mono font-semibold text-link text-sm mb-1">pnpm tokens:build</p>
                  <p class="text-xs text-muted-foreground">Emits the <code class="text-xs">--color-*</code> and <code class="text-xs">--font-family-*</code> vars components consume.</p>
                </div>
              </Card>
              <Card>
                <div class="p-4">
                  <p class="text-xs uppercase tracking-wider text-muted-foreground mb-1">Gate</p>
                  <p class="font-mono font-semibold text-link text-sm mb-1">pnpm design:validate</p>
                  <p class="text-xs text-muted-foreground">Checks WCAG-AA contrast on the gated pairs. Fails the build on a regression.</p>
                </div>
              </Card>
              <Card>
                <div class="p-4">
                  <p class="text-xs uppercase tracking-wider text-muted-foreground mb-1">Ship</p>
                  <p class="font-mono font-semibold text-link text-sm mb-1">this page re-skins</p>
                  <p class="text-xs text-muted-foreground">Swatches, type scale, gallery and hero all reflect the new system automatically.</p>
                </div>
              </Card>
            </div>
          </ScrollReveal>
        </Container>
      </Section>

      <SectionSeparator />

      {/* ================================================================
          DESIGN TOKENS SECTION
          ================================================================ */}
      <Section id="color" class="py-16">
        <Container>
          <ScrollReveal>
            <p class="text-xs font-semibold text-link uppercase tracking-wider mb-2">Color tokens</p>
            <h2 class="text-3xl font-bold text-foreground mb-2">Full scales, fixed semantic mapping</h2>
            <p class="text-muted-foreground mb-8 max-w-2xl">
              Each family is a 50→950 scale in <a href="https://github.com/clownware/astro-performance-starter/tree/master/tokens" target="_blank" rel="noopener noreferrer" class="underline decoration-dotted underline-offset-2 hover:decoration-solid"><code class="text-sm bg-surface px-1.5 py-0.5 rounded-md">tokens/</code></a>.
              Roles are pinned: primary→violet, success→green (ADR-047 v2.1), secondary/error→rose, warning→amber, neutrals→slate.
              The bands and role chips below read the live CSS vars — toggle the theme and watch them flip.
            </p>
          </ScrollReveal>

          {/* Full 50–950 palette bands — token-driven via PaletteBand */}
          <ScrollReveal>
            <div class="flex flex-col gap-6 mb-10">
              <PaletteBand family="slate" label="neutral · 228° cool" />
              <PaletteBand family="violet" label="primary · 256°" />
              <PaletteBand family="green" label="success · 152°" />
              <PaletteBand family="rose" label="secondary / error · 344°" />
              <PaletteBand family="amber" label="warning · 38°" />
            </div>
          </ScrollReveal>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <ScrollReveal delay="none">
              <Card animated>
                <div class="p-4">
                  <h3 class="text-sm font-semibold text-foreground mb-3">Primary</h3>
                  <div class="flex flex-col gap-1">
                    <ColorTokenSwatch tokenName="primary-500" cssVar="--color-primary-500" />
                    <ColorTokenSwatch tokenName="primary-600" cssVar="--color-primary-600" />
                    <ColorTokenSwatch tokenName="primary-700" cssVar="--color-primary-700" />
                  </div>
                </div>
              </Card>
            </ScrollReveal>

            <ScrollReveal delay="short">
              <Card animated>
                <div class="p-4">
                  <h3 class="text-sm font-semibold text-foreground mb-3">Secondary</h3>
                  <div class="flex flex-col gap-1">
                    <ColorTokenSwatch tokenName="secondary-500" cssVar="--color-secondary-500" />
                    <ColorTokenSwatch tokenName="secondary-600" cssVar="--color-secondary-600" />
                    <ColorTokenSwatch tokenName="secondary-700" cssVar="--color-secondary-700" />
                  </div>
                </div>
              </Card>
            </ScrollReveal>

            <ScrollReveal delay="medium">
              <Card animated>
                <div class="p-4">
                  <h3 class="text-sm font-semibold text-foreground mb-3">Surfaces</h3>
                  <div class="flex flex-col gap-1">
                    <ColorTokenSwatch tokenName="background" cssVar="--color-background" />
                    <ColorTokenSwatch tokenName="surface" cssVar="--color-surface" />
                    <ColorTokenSwatch tokenName="foreground" cssVar="--color-foreground" />
                  </div>
                </div>
              </Card>
            </ScrollReveal>

            <ScrollReveal delay="medium">
              <Card animated>
                <div class="p-4">
                  <h3 class="text-sm font-semibold text-foreground mb-3">Roles</h3>
                  <div class="flex flex-col gap-1">
                    <ColorTokenSwatch tokenName="muted-foreground" cssVar="--color-muted-foreground" />
                    <ColorTokenSwatch tokenName="link" cssVar="--color-link" />
                    <ColorTokenSwatch tokenName="border" cssVar="--color-border" />
                    <ColorTokenSwatch tokenName="border-emphasis" cssVar="--color-border-emphasis" />
                    <ColorTokenSwatch tokenName="primary-foreground" cssVar="--color-primary-foreground" />
                  </div>
                </div>
              </Card>
            </ScrollReveal>

            <ScrollReveal delay="medium">
              <Card animated>
                <div class="p-4">
                  <h3 class="text-sm font-semibold text-foreground mb-3">Status</h3>
                  <div class="flex flex-col gap-1">
                    <ColorTokenSwatch tokenName="success" cssVar="--color-success" />
                    <ColorTokenSwatch tokenName="warning" cssVar="--color-warning" />
                    <ColorTokenSwatch tokenName="error" cssVar="--color-error" />
                  </div>
                </div>
              </Card>
            </ScrollReveal>
          </div>
        </Container>
      </Section>

      <SectionSeparator />

      {/* ================================================================
          TYPE SECTION
          ================================================================ */}
      <Section id="type" class="py-16">
        <Container>
          <ScrollReveal>
            <p class="text-xs font-semibold text-link uppercase tracking-wider mb-2">Type specimen</p>
            <h2 class="text-3xl font-bold text-foreground mb-2">A scale built from fontFamily tokens</h2>
            <p class="text-muted-foreground mb-8 max-w-2xl">
              Type is tokenized like colour. The <code class="text-sm bg-surface px-1.5 py-0.5 rounded-md">fontFamily</code>
              group (display + text) makes the face swappable — change the token and this whole
              specimen reflows. Display rides at 700 in Geist; body is Inter, a clean neutral sans.
            </p>
          </ScrollReveal>
          <ScrollReveal>
            <TypeSpecimen />
          </ScrollReveal>
        </Container>
      </Section>

      <SectionSeparator />

      {/* ================================================================
          MOTION SECTION
          ================================================================ */}
      <Section id="motion" class="py-16">
        <Container>
          <ScrollReveal>
            <p class="text-xs font-semibold text-link uppercase tracking-wider mb-2">Motion</p>
            <h2 class="text-3xl font-bold text-foreground mb-2">Live, CSS-native, reduced-motion gated</h2>
            <p class="text-muted-foreground mb-8 max-w-2xl">
              The signature gradient sits up top: two OKLCH interpolations, side by side.
              Everything here is compositor-cheap and gated behind
              <code class="text-sm bg-surface px-1.5 py-0.5 rounded-md">prefers-reduced-motion</code> — turn it on
              and every loop settles to a legible resting state.
            </p>
          </ScrollReveal>

          {/* Gradient A vs B — token-driven via AnimatedGradientText arc prop */}
          <ScrollReveal>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
              <Card>
                <div class="p-6">
                  <p class="text-xs font-mono text-muted-foreground mb-4">Gradient A — <span class="text-link">in oklch shorter hue</span> · vivid, tight</p>
                  <AnimatedGradientText as="p" arc="short" speed="slow" class="text-5xl font-bold tracking-tight">Aurora</AnimatedGradientText>
                  <p class="text-xs text-muted-foreground mt-4">Hue takes the short path violet→crimson. Reduced-motion: sweep stops, gradient holds a static frame.</p>
                </div>
              </Card>
              <Card>
                <div class="p-6">
                  <p class="text-xs font-mono text-muted-foreground mb-4">Gradient B — <span class="text-link">longer hue</span> · full rainbow sweep · shipped</p>
                  <AnimatedGradientText as="p" arc="long" speed="slow" class="text-5xl font-bold tracking-tight">Aurora</AnimatedGradientText>
                  <p class="text-xs text-muted-foreground mt-4">Hue takes the long way round the wheel. This is the variant the hero uses.</p>
                </div>
              </Card>
            </div>
          </ScrollReveal>

          {/* Conic glow + CTA sheen */}
          <ScrollReveal>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="rounded-lg border border-border p-6">
                <p class="text-xs font-mono text-muted-foreground mb-4">Conic glow + sheen · <span class="text-link">@property &lt;angle&gt;</span></p>
                <div class="flex items-center gap-4">
                  <div class="glow-border rounded-lg bg-surface px-5 py-4 text-sm font-medium">Featured</div>
                  <Button variant="primary" class="cta-sheen">Deploy</Button>
                </div>
                <p class="text-xs text-muted-foreground mt-4">One decorative loop + one specular pass. Reduced-motion: ring holds, sheen off.</p>
              </div>
              <div class="rounded-lg border border-border p-6">
                <p class="text-xs font-mono text-muted-foreground mb-4">Scroll reveal · <span class="text-link">animation-timeline: view()</span></p>
                <p class="text-sm text-muted-foreground">Every block on this page enters via the <code class="text-xs">ScrollReveal</code> component — native scroll-driven, no IntersectionObserver. A fixed <code class="text-xs">feTurbulence</code> grain adds depth on the dark surface. Reduced-motion: items render at rest, fully visible. On browsers without <code class="text-xs">animation-timeline</code> (e.g. Safari &lt; 26) reveals are simply skipped and content shows immediately — graceful, still zero-JS, no JS fallback by design (ADR-048).</p>
              </div>
            </div>
          </ScrollReveal>

          {/* The one interactive motion island — opt-in JS, clearly labelled (#250, ADR-048) */}
          <ScrollReveal>
            <ShowcaseExample
              title="MotionLab (Preact island)"
              description="Everything above is zero-JS CSS. This is the deliberate exception: a single Preact island that controls a CSS animation — play/pause and speed live in a Signal. It hydrates with client:idle, so it costs nothing until the browser is free. The gradient itself is still pure CSS, and it freezes under prefers-reduced-motion regardless of the controls."
              features={["preact-signals", "progressive-enhancement"]}
              a11yNote="Real <button>s; honours prefers-reduced-motion (animation off) even while playing"
              codeSnippet={'import MotionLab from "@/components/islands/MotionLab.tsx";\n\n&lt;MotionLab client:idle /&gt;'}
              codeLang="tsx"
            >
              <MotionLab client:idle />
            </ShowcaseExample>
          </ScrollReveal>
        </Container>
      </Section>

      <SectionSeparator />

      {/* ================================================================
          COMPONENTS — gallery intro + atoms/molecules/structural/islands/composition
          ================================================================ */}
      <Section id="components" class="pt-16 pb-4">
        <Container>
          <ScrollReveal>
            <p class="text-xs font-semibold text-link uppercase tracking-wider mb-2">Components</p>
            <h2 class="text-3xl font-bold text-foreground mb-2">The gallery, styled by the system</h2>
            <p class="text-muted-foreground max-w-2xl">
              The atoms, molecules, structural primitives, islands and real-world compositions
              below are imported live — no redesigned mockups, no hardcoded colour. Each consumes
              the same tokens documented above.
            </p>
          </ScrollReveal>
        </Container>
      </Section>

      {/* ================================================================
          ATOMS
          ================================================================ */}
      <Section id="atoms" class="py-16">
        <Container>
          <ScrollReveal>
            <h3 class="text-2xl font-bold text-foreground mb-2">Atoms</h3>
            <p class="text-muted-foreground mb-8 max-w-2xl">
              Primitive building blocks. Each is a single Astro component with TypeScript props, design token colors, and built-in accessibility.
            </p>
          </ScrollReveal>

          <div class="flex flex-col gap-8">
            {/* Badge */}
            <ScrollReveal>
              <ShowcaseExample
                title="Badge"
                description="Inline label element with variant and size options. Enhanced with prefers-contrast support for users who request higher contrast."
                features={["zero-js", "css-only", "wcag-aa"]}
                a11yNote="prefers-contrast: more — heavier borders and font weight"
                codeSnippet={'&lt;Badge variant="primary" size="sm"&gt;Primary&lt;/Badge&gt;\n&lt;Badge variant="secondary"&gt;Secondary&lt;/Badge&gt;\n&lt;Badge variant="neutral"&gt;Neutral&lt;/Badge&gt;'}
              >
                <div class="flex flex-wrap gap-2 items-center">
                  <Badge variant="primary" size="xs">Extra Small</Badge>
                  <Badge variant="primary" size="sm">Primary</Badge>
                  <Badge variant="primary" size="md">Medium</Badge>
                  <Badge variant="secondary">Secondary</Badge>
                  <Badge variant="neutral">Neutral</Badge>
                </div>
              </ShowcaseExample>
            </ScrollReveal>

            {/* Button */}
            <ScrollReveal>
              <ShowcaseExample
                title="Button"
                description="Polymorphic button/link component. Renders as <a> when href is provided, <button> otherwise. Supports disabled state with proper aria."
                features={["zero-js", "wcag-aa"]}
                a11yNote="Disabled state uses aria-disabled and removes from tab order"
                codeSnippet={'&lt;Button variant="primary"&gt;Primary&lt;/Button&gt;\n&lt;Button variant="secondary"&gt;Secondary&lt;/Button&gt;\n&lt;Button variant="ghost" size="sm"&gt;Ghost&lt;/Button&gt;'}
              >
                <div class="flex flex-wrap gap-3 items-center">
                  <Button variant="primary">Primary</Button>
                  <Button variant="secondary">Secondary</Button>
                  <Button variant="ghost" size="sm">Ghost</Button>
                  <Button variant="primary" disabled>Disabled</Button>
                </div>
              </ShowcaseExample>
            </ScrollReveal>

            {/* Tooltip with Popover API */}
            <ScrollReveal>
              <ShowcaseExample
                title="Tooltip"
                description="Hover/focus tooltip upgraded with the Popover API. Browsers that support popover='hint' get auto-dismiss and Escape-to-close. Others fall back to CSS hover/focus."
                features={["popover-api", "progressive-enhancement", "wcag-aa"]}
                a11yNote="Visible on focus + hover; Escape-to-close (Popover API)"
                codeSnippet={'&lt;Tooltip text="Helpful information" position="top"&gt;\n  Hover me\n&lt;/Tooltip&gt;'}
              >
                <div class="flex flex-wrap gap-6 items-center">
                  <Tooltip text="I appear above!" position="top">
                    <span class="underline decoration-dashed decoration-muted-foreground cursor-help">Hover (top)</span>
                  </Tooltip>
                  <Tooltip text="I appear below!" position="bottom">
                    <span class="underline decoration-dashed decoration-muted-foreground cursor-help">Hover (bottom)</span>
                  </Tooltip>
                  <Tooltip text="This tooltip uses the Popover API when supported, with @starting-style entry animation." position="right">
                    <span class="underline decoration-dashed decoration-muted-foreground cursor-help">Popover enhanced</span>
                  </Tooltip>
                </div>
              </ShowcaseExample>
            </ScrollReveal>

            {/* ScrollReveal */}
            <ScrollReveal>
              <ShowcaseExample
                title="ScrollReveal"
                description="Scroll-driven reveal animations. Replaces AOS, ScrollMagic, and GSAP ScrollTrigger with zero JavaScript. Uses animation-timeline: view() — content animates in as it enters the viewport."
                features={["scroll-driven", "zero-js", "css-only"]}
                a11yNote="prefers-reduced-motion: respected — content visible immediately"
                codeSnippet={'&lt;ScrollReveal animation="fade-up"&gt;\n  &lt;Card&gt;Content reveals on scroll&lt;/Card&gt;\n&lt;/ScrollReveal&gt;'}
              >
                <p class="text-sm text-muted-foreground mb-4">Scroll down to see these cards reveal (they use the same ScrollReveal wrapping this entire page):</p>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                  <ScrollReveal animation="slide-right">
                    <Card animated><div class="p-4 text-center text-sm">slide-right</div></Card>
                  </ScrollReveal>
                  <ScrollReveal animation="scale">
                    <Card animated><div class="p-4 text-center text-sm">scale</div></Card>
                  </ScrollReveal>
                  <ScrollReveal animation="slide-left">
                    <Card animated><div class="p-4 text-center text-sm">slide-left</div></Card>
                  </ScrollReveal>
                </div>
              </ShowcaseExample>
            </ScrollReveal>

            {/* CounterBadge */}
            <ScrollReveal>
              <ShowcaseExample
                title="CounterBadge"
                description="Animated counter using CSS @property with <integer> type and counter(). Numbers count up from 0 when scrolled into view — entirely in CSS."
                features={["css-property", "scroll-driven", "zero-js"]}
                a11yNote="role=img + aria-label exposes counter values to assistive tech"
                codeSnippet={'&lt;CounterBadge value={42} suffix="+" label="Components" /&gt;'}
              >
                <div class="flex justify-center gap-8">
                  <CounterBadge value={42} label="Answer" />
                  <CounterBadge value={100} suffix="%" label="CSS" />
                  <CounterBadge value={0} suffix=" KB" label="JavaScript" />
                </div>
              </ShowcaseExample>
            </ScrollReveal>

            {/* Icon */}
            <ScrollReveal>
              <ShowcaseExample
                title="Icon"
                description="Inline SVG from a Lucide-aligned path registry (ADR-055). currentColor means each icon takes its colour from the surrounding text token; size with utility classes."
                features={["zero-js", "wcag-aa"]}
                a11yNote="Decorative icons get aria-hidden; meaningful ones take an ariaLabel"
                codeSnippet={'&lt;Icon name="zap" class="size-6 text-primary-600" ariaLabel="Performance" /&gt;'}
              >
                <div class="flex flex-wrap items-center gap-5 text-foreground">
                  <Icon name="zap" class="size-6 text-primary-600" ariaLabel="Performance" />
                  <Icon name="shield-check" class="size-6 text-success" ariaLabel="Security" />
                  <Icon name="gauge" class="size-6 text-link" ariaLabel="Speed" />
                  <Icon name="palette" class="size-6 text-secondary-600" ariaLabel="Design" />
