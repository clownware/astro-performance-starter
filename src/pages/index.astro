---
import Badge from "@/components/atoms/Badge.astro";
import Button from "@/components/atoms/Button.astro";
import Icon from "@/components/atoms/Icon.astro";

import Card from "@/components/molecules/Card.astro";
import ExpandableFeatureCard from "@/components/molecules/ExpandableFeatureCard.astro";
import SectionSeparator from "@/components/molecules/SectionSeparator.astro";
import Container from "@/components/structural/Container.astro";
import Grid from "@/components/structural/Grid.astro";
import Section from "@/components/structural/Section.astro";
import { siteLinks } from "@/config";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type {
  Feature,
  LighthouseMetric,
  StackRationale,
  TechStackItem,
  TechTerms,
} from "@/types/content";

/**
 * Homepage feature cards showcasing template capabilities.
 * Each feature includes expandable details for comprehensive information.
 */
const features: Feature[] = [
  {
    icon: "🚀",
    title: "Performance-First Architecture",
    description:
      "Zero-JS baseline with islands architecture. Ships with 95+ Lighthouse and CI/CD performance budgets.",
    metric: "95+ Lighthouse",
    expandedDetails: [
      "Static site generation with selective hydration for optimal performance",
      "Automatic code splitting and lazy loading for JavaScript components",
      "Built-in image optimization with WebP/AVIF conversion",
      "Performance budgets enforced in CI/CD pipeline",
      "Core Web Vitals monitoring and optimization",
    ],
  },
  {
    icon: "🤖",
    title: "AI-Assisted Development",
    description:
      "Rich context documentation and prompt libraries that supercharge AI coding for 10x faster development.",
    metric: "10x Faster",
    expandedDetails: [
      "Structured documentation that AI assistants can understand and use effectively",
      "Architectural Decision Records (ADRs) for tracking design choices",
      "Phase-by-phase implementation guides with clear milestones",
      "Pattern libraries with real-world examples and anti-patterns",
      "Context-aware documentation that adapts to your project needs",
    ],
  },
  {
    icon: "🎨",
    title: "Enterprise-Grade Design System",
    description:
      "Semantic design tokens with automatic dark mode, WCAG AA compliance, and automated contrast validation.",
    metric: "WCAG AA",
    expandedDetails: [
      "Semantic color tokens that automatically adapt to light/dark themes",
      "WCAG AA contrast ratio validation in build process",
      "Consistent spacing, typography, and color scales",
      "Automated design token generation from source files",
      "Theme switching with system preference detection",
    ],
  },
  {
    icon: "⚡",
    title: "Next-Gen Opinionated Toolchain",
    description:
      "Biome replaces ESLint + Prettier with 20x speed. TypeScript strict mode and automated quality gates.",
    metric: "20x Faster",
    expandedDetails: [
      "Biome replaces ESLint + Prettier with 20x performance improvement",
      "TypeScript strict mode catches errors before they reach production",
      "Git hooks for automated code quality checks",
      "Conventional commits with automated changelog generation",
      "Dependency vulnerability scanning and updates",
    ],
  },
  {
    icon: "🧩",
    title: "Production-Ready Components",
    description:
      "Battle-tested atomic design system with accessible primitives, responsive layouts, and TypeScript interfaces.",
    metric: "Type-Safe",
    expandedDetails: [
      "Atomic design methodology: atoms, molecules, organisms, templates",
      "Accessible components with proper ARIA attributes",
      "Responsive design patterns built into every component",
      "TypeScript interfaces for type-safe component props",
      "Reusable structural components for consistent layouts",
    ],
  },
  {
    icon: "🏗️",
    title: "Robust Page Templates",
    description:
      "Portfolio-ready pages included: About, Projects, Blog, Contact. Launch with professional content, not empty shells.",
    metric: "Ready to Ship",
    expandedDetails: [
      "Professional About page with skills showcase and responsive design",
      "Projects portfolio with grid layouts and detailed case studies",
      "Blog system with MDX support and content collections",
      "Contact forms with Cloudflare Pages integration",
      "Responsive navigation and footer components",
    ],
  },
];

/**
 * Technical term definitions for tooltips and glossary.
 * Provides context-aware explanations for AI-assisted development.
 */
const techTerms: TechTerms = {
  // biome-ignore lint/style/useNamingConvention: proper noun dictionary key
  Biome:
    "A fast, all-in-one toolchain that replaces ESLint and Prettier with 20x better performance",
  // biome-ignore lint/style/useNamingConvention: proper noun dictionary key
  Preact:
    "A lightweight 3KB alternative to React with the same API, perfect for interactive components",
  // biome-ignore lint/style/useNamingConvention: proper noun dictionary key
  TypeScript:
    "JavaScript with type safety that catches errors during development instead of production",
  // biome-ignore lint/style/useNamingConvention: proper noun dictionary key
  Astro:
    "A modern web framework that delivers zero JavaScript by default with optional interactive islands",
  "Tailwind CSS": "A utility-first CSS framework that lets you build designs directly in your HTML",
  // biome-ignore lint/style/useNamingConvention: proper noun dictionary key
  Sharp:
    "High-performance image processing library that automatically optimizes images for the web",
  // biome-ignore lint/style/useNamingConvention: proper noun dictionary key
  Playwright: "Cross-browser testing framework that works with Chrome, Firefox, Safari, and Edge",
  // biome-ignore lint/style/useNamingConvention: proper noun dictionary key
  Vitest: "Lightning-fast unit testing framework built on Vite with hot module replacement",
  "WCAG AA":
    "Web Content Accessibility Guidelines level AA - the standard for accessible web content",
  "Islands Architecture":
    "A pattern where interactive components are isolated islands in a sea of static HTML",
  "Zero-JS baseline":
    "The site works perfectly without JavaScript, then progressively enhances with interactivity",
};

/**
 * Lighthouse performance metrics for the starter template.
 * Reflects ideal conditions with empty starter content.
 */
const metrics: LighthouseMetric[] = [
  { label: "Performance", score: "95+", icon: "🚀" },
  { label: "Accessibility", score: "100", icon: "♿" },
  { label: "Best Practices", score: "100", icon: "🛡️" },
  { label: "SEO", score: "100", icon: "🔍" },
];

/**
 * Technology stack with versions, descriptions, and benefits.
 * Organized by category for clear understanding of architecture.
 */
const techStack: TechStackItem[] = [
  {
    name: "Astro",
    version: "v5.x",
    description: "Static site generator with islands",
    benefit: "Zero-JS by default, blazing fast performance",
    category: "Framework",
  },
  {
    name: "TypeScript",
    version: "v5.9.2",
    description: "Type-safe JavaScript with strict mode",
    benefit: "Catch errors early, better DX",
    category: "Language",
  },
  {
    name: "Tailwind CSS",
    version: "v3.4.4",
    description: "Utility-first CSS framework",
    benefit: "Rapid styling, consistent design system",
    category: "Styling",
  },
  {
    name: "Biome",
    version: "v2.2.4",
    description: "All-in-one toolchain for web projects",
    benefit: "20x faster than ESLint + Prettier combined",
    category: "Tooling",
  },
  {
    name: "Preact",
    version: "v10.x",
    description: "Lightweight React alternative",
    benefit: "3KB runtime, familiar React-like syntax",
    category: "Interactivity",
  },
  {
    name: "Playwright",
    version: "v1.x",
    description: "End-to-end testing",
    benefit: "Reliable cross-browser testing automation",
    category: "E2E Testing",
  },
  {
    name: "Vitest",
    version: "v2.x",
    description: "Fast unit testing powered by Vite",
    benefit: "Lightning-fast test execution and hot reload",
    category: "Unit Testing",
  },
  {
    name: "Sharp",
    version: "v0.34.x",
    description: "High-performance image processing",
    benefit: "Automatic conversion, responsive images",
    category: "Image Processing",
  },
];

/**
 * Rationale for technology stack choices.
 * Explains the "why" behind each architectural decision.
 */
const stackRationale: StackRationale = {
  performance:
    "Every tool chosen prioritizes speed and efficiency, from Astro's zero-JS baseline to Biome's 20x faster linting.",
  developerExperience:
    "Modern tooling with TypeScript strict mode, hot reload, and comprehensive testing ensures productive development.",
  productionReady:
    "Battle-tested tools used by major companies, with strong community support and active maintenance.",
  futureProof:
    "Latest versions of stable technologies that will continue to evolve with web standards.",
};
---

<BaseLayout
  title="Astro Performance Starter | Production-Ready Template for AI-Assisted Development"
  description="Build blazing-fast websites with Astro's modern architecture. Zero-JS baseline, 100/100 Lighthouse scores, and AI-optimized documentation for rapid development."
  preconnectDomains={["https://github.com"]}
>
  <!-- Hero Section -->
  <Section ariaLabel="Hero section" class="relative overflow-hidden flex flex-col items-center justify-center text-center min-h-[calc(100vh-4rem)]">
    <!-- Background gradient -->
    <div
      class="absolute inset-x-0 top-[-10rem] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[-20rem]"
      aria-hidden="true"
    >
      <div class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-primary-500 to-primary-700 opacity-20 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]"></div>
    </div>
    
    <Container>
      <div class="mx-auto max-w-4xl text-center">
        <Badge class="mb-4 sm:mb-6 bg-primary-100 text-primary-800 text-sm sm:text-base px-3 sm:px-4 py-1.5 sm:py-2">
          <span aria-hidden="true">🎆</span> Production-Ready Astro Template
        </Badge>
        
        <h1 class="text-3xl sm:text-4xl lg:text-6xl font-extrabold tracking-tight text-foreground-primary">
          Astro Performance Starter.
          <br>
          <span class="bg-gradient-to-r from-primary-600 to-secondary-600 bg-clip-text text-transparent">
           Just set your agent loose on the docs.
          </span>
        </h1>
        
        <p class="mt-3 sm:mt-4 text-base sm:text-lg leading-6 sm:leading-7 text-foreground-secondary">
          Build blazing-fast websites with Astro's modern architecture. Zero-JS baseline, 100/100 Lighthouse scores, and AI-optimized documentation for rapid development.
        </p>
        
        <div class="mt-4 sm:mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-6">
          <Button href={siteLinks.github} variant="primary" class="text-sm sm:text-base h-10 sm:h-12 px-4 sm:px-6" rel="noopener noreferrer" target="_blank">
            <Icon name="github" class="w-4 h-4 sm:w-5 sm:h-5 mr-2" decorative />
            View on GitHub
          </Button>
          {siteLinks.docs && (
          <Button href={`${siteLinks.docs}/getting-started/`} variant="secondary" class="text-sm sm:text-base h-10 sm:h-12 px-4 sm:px-6" data-astro-prefetch>
            <span aria-hidden="true">📖</span> View Documentation →
          </Button>
          )}
        </div>
        
        <ul class="mt-3 sm:mt-4 text-xs sm:text-sm text-foreground-subtle flex flex-wrap items-center justify-center gap-x-4 gap-y-1" role="list" aria-label="Key features">
          <li class="flex items-center gap-1">
            <span aria-hidden="true">✓</span>
            <span><span class="sr-only">Included: </span>TypeScript strict mode</span>
          </li>
          <li class="flex items-center gap-1" aria-hidden="true">•</li>
          <li class="flex items-center gap-1">
            <span aria-hidden="true">✓</span>
            <span><span class="sr-only">Included: </span>Biome 20x faster linting</span>
          </li>
          <li class="flex items-center gap-1" aria-hidden="true">•</li>
          <li class="flex items-center gap-1">
            <span aria-hidden="true">✓</span>
            <span><span class="sr-only">Included: </span>WCAG AA compliant</span>
          </li>
        </ul>
      </div>
    </Container>
    <!-- Scroll Indicator -->
    <div class="absolute inset-x-0 bottom-4 flex flex-col items-center">
      <a href="#performance" class="group flex flex-col items-center text-foreground-secondary hover:text-primary-600 transition-colors" aria-label="Scroll to next section">
        <span class="text-xs sm:text-sm font-medium mb-1 sm:mb-2 opacity-75 group-hover:opacity-100 transition-opacity">Explore below</span>
        <Icon name="arrow-down" class="w-5 h-5 sm:w-6 sm:h-6 animate-bounce" decorative />
      </a>
    </div>
  </Section>

  <!-- Lighthouse Metrics Showcase -->
  <Section id="performance" ariaLabel="Performance metrics section" class="relative bg-background-secondary">
    <SectionSeparator />
    <Container>
      <div class="text-center">
        <h2 class="text-3xl font-bold text-foreground-primary">
          <span aria-hidden="true">🎯</span> Lighthouse Performance Scores
        </h2>
        <p class="mt-4 text-lg text-foreground-secondary">
          Optimized for Core Web Vitals and search engine performance
        </p>
      </div>
      
      <ul class="mt-4 sm:mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4 list-none" role="list" aria-label="Lighthouse performance metrics">
        {metrics.map((metric) => (
          <li>
            <Card class="border-2 border-primary-300 bg-background-secondary p-6 text-center h-full">
              <div class="text-3xl font-bold text-primary-600" aria-label={`${metric.label} score: ${metric.score}`}>
                <span aria-hidden="true">{metric.icon}</span>
                {metric.score}
              </div>
              <div class="mt-1 text-sm font-medium text-foreground-secondary">{metric.label}</div>
            </Card>
          </li>
        ))}
      </ul>
      
      <div class="mt-8 text-center space-y-4">
        <p class="text-sm text-foreground-subtle">
          Scores reflect ideal conditions (empty starter). Real-world results may vary by deployment and content.
        </p>
        
        <!-- Live Quality Badge -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          {siteLinks.pagespeed && (
          <a 
            href={siteLinks.pagespeed}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary-100 hover:bg-primary-200 text-primary-800 transition-colors group"
            aria-label="View live Lighthouse scores on PageSpeed Insights"
          >
            <span class="text-sm font-medium">🎯 View Live Scores</span>
            <svg class="w-4 h-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          )}
          
          <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-secondary-100 text-secondary-800 text-xs font-medium">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Verified by CI
          </span>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Key Features -->
  <Section id="features" ariaLabel="Key features section" class="relative">
    <SectionSeparator />
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-foreground-primary sm:text-4xl">
          Why Choose This Template?
        </h2>
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 text-sm text-foreground-subtle">
        </div>
      </div>
      
      <Grid class="mt-12 gap-8">
        {features.map((feature) => (
          <ExpandableFeatureCard
            icon={feature.icon}
            title={feature.title}
            description={feature.description}
            metric={feature.metric}
            expandedDetails={feature.expandedDetails}
            techTerms={techTerms}
          />
        ))}
      </Grid>
    </Container>
  </Section>

  <!-- Tech Stack -->
  <Section id="tech-stack" ariaLabel="Technology stack section" class="bg-background-secondary relative">
    <SectionSeparator />
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold text-foreground-primary">
          <span aria-hidden="true">🛠️</span> Modern Tech Stack
        </h2>
        <p class="mt-4 text-lg text-foreground-secondary">
          Carefully selected tools for optimal developer experience
        </p>
      </div>
      
      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {techStack.map((tech) => (
          <Card class="p-6 text-center hover:shadow-lg transition-shadow group">
            <div class="mb-3">
              <Badge class="bg-secondary-100 text-secondary-800 text-xs">
                {tech.category}
              </Badge>
            </div>
            <h3 class="font-semibold text-foreground-primary text-lg mb-2">{tech.name}</h3>
            <p class="text-sm text-primary-600 font-mono font-medium mb-3">{tech.version}</p>
            <p class="text-sm text-foreground-secondary mb-3 leading-relaxed">{tech.description}</p>
            <div class="mt-4 pt-4 border-t border-dashed border-border-default">
              <p class="text-xs text-foreground-subtle italic group-hover:text-foreground-secondary transition-colors">
                                {tech.benefit}              </p>
            </div>
          </Card>
        ))}
      </div>
      
      <!-- Why This Stack Section -->
      <div class="mt-12 mx-auto max-w-4xl">
        <div class="text-center mb-8">
          <h3 class="text-2xl font-bold text-foreground-primary mb-4">
            <span aria-hidden="true">🤔</span> Why This Stack?
          </h3>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <Card class="p-6">
            <h4 class="font-semibold text-foreground-primary mb-3 flex items-center">
              <span aria-hidden="true">⚡</span> Performance First
            </h4>
            <p class="text-sm text-foreground-secondary leading-relaxed">
              {stackRationale.performance}
            </p>
          </Card>
          
          <Card class="p-6">
            <h4 class="font-semibold text-foreground-primary mb-3 flex items-center">
              <span aria-hidden="true">🎯</span> Developer Experience
            </h4>
            <p class="text-sm text-foreground-secondary leading-relaxed">
              {stackRationale.developerExperience}
            </p>
          </Card>
          
          <Card class="p-6">
            <h4 class="font-semibold text-foreground-primary mb-3 flex items-center">
              <span aria-hidden="true">🏭</span> Production Ready
            </h4>
            <p class="text-sm text-foreground-secondary leading-relaxed">
              {stackRationale.productionReady}
            </p>
          </Card>
          
          <Card class="p-6">
            <h4 class="font-semibold text-foreground-primary mb-3 flex items-center">
              <span aria-hidden="true">🔮</span> Future Proof
            </h4>
            <p class="text-sm text-foreground-secondary leading-relaxed">
              {stackRationale.futureProof}
            </p>
          </Card>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Implementation Tiers (ADR-033) -->
  <Section id="implementation" ariaLabel="Implementation tiers section" class="relative">
    <SectionSeparator />
    <Container>
      <div class="mx-auto max-w-5xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-foreground-primary">
            <span aria-hidden="true">🛤️</span> Progressive Implementation
          </h2>
          <p class="mt-4 text-lg text-foreground-secondary">
            One path, three natural stopping points. Go as far as your project needs.
          </p>
        </div>
        
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
          <!-- Foundation Tier -->
          <Card class="p-6 bg-red-50 border-2 border-red-200">
            <div class="mb-4">
              <Badge class="bg-red-100 text-red-800 text-xs">Phases 0–4</Badge>
              <h3 class="mt-3 text-xl font-bold text-red-800">
                <span aria-hidden="true">🏗️</span> Foundation
              </h3>
            </div>
            <p class="text-red-700 mb-6">
              Working site skeleton with design system, content schemas, and build pipeline.
            </p>
            <ul class="text-sm text-red-600 space-y-2 mb-6" role="list" aria-label="Foundation tier features">
              <li class="flex items-start gap-2">
                <span aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Astro + TypeScript + Tailwind + Biome</span>
              </li>
              <li class="flex items-start gap-2">
                <span aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Content Collections schemas</span>
              </li>
              <li class="flex items-start gap-2">
                <span aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Design tokens system</span>
              </li>
              <li class="flex items-start gap-2">
                <span aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>CI pipeline</span>
              </li>
            </ul>
            <p class="text-xs text-red-500 italic">Everyone does these — pre-configured in template.</p>
          </Card>
          
          <!-- Build Tier -->
          <Card class="p-6 bg-amber-50 border-2 border-amber-200">
            <div class="mb-4">
              <Badge class="bg-amber-100 text-amber-800 text-xs">Phases 5–8</Badge>
              <h3 class="mt-3 text-xl font-bold text-amber-800">
                <span aria-hidden="true">⚡</span> Build
              </h3>
            </div>
            <p class="text-amber-700 mb-6">
              Complete site with components, pages, content, and quality assurance.
            </p>
            <ul class="text-sm text-amber-600 space-y-2 mb-6" role="list" aria-label="Build tier features">
              <li class="flex items-start gap-2">
                <span aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>UI components (scope to your needs)</span>
              </li>
              <li class="flex items-start gap-2">
                <span aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Page sections and layouts</span>
              </li>
              <li class="flex items-start gap-2">
                <span aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Content creation</span>
              </li>
              <li class="flex items-start gap-2">
                <span aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Quality assurance</span>
              </li>
            </ul>
            <p class="text-xs text-amber-500 italic">Make it yours — scope each phase to your goals.</p>
          </Card>
          
          <!-- Polish Tier -->
          <Card class="p-6 bg-emerald-50 border-2 border-emerald-200">
            <div class="mb-4">
              <Badge class="bg-emerald-100 text-emerald-800 text-xs">Phases 9–12</Badge>
              <h3 class="mt-3 text-xl font-bold text-emerald-800">
                <span aria-hidden="true">🏆</span> Polish
              </h3>
            </div>
            <p class="text-emerald-700 mb-6">
              Production-hardened site with performance optimization and monitoring.
            </p>
            <ul class="text-sm text-emerald-600 space-y-2 mb-6" role="list" aria-label="Polish tier features">
              <li class="flex items-start gap-2">
                <span aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Performance budget enforcement</span>
              </li>
              <li class="flex items-start gap-2">
                <span aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Deployment configuration</span>
              </li>
              <li class="flex items-start gap-2">
                <span aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Documentation and AI context</span>
              </li>
              <li class="flex items-start gap-2">
                <span aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Post-launch monitoring</span>
              </li>
            </ul>
            <p class="text-xs text-emerald-500 italic">Production-harden — stop when goals are met.</p>
          </Card>
        </div>
        
        <div class="mt-8 text-center">
          {siteLinks.docs ? (
          <Button href={`${siteLinks.docs}/getting-started/`} variant="primary" data-astro-prefetch>
            View Implementation Guide →
          </Button>
          ) : (
          <Button href="/docs/README.md" variant="primary">
            View Implementation Guide →
          </Button>
          )}
        </div>
      </div>
    </Container>
  </Section>

  <!-- CTA Section -->
  <Section ariaLabel="Call to action section" class="relative bg-foreground-primary">
    <SectionSeparator />
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold text-background-primary">
          Ready to Build Something Amazing?
        </h2>
        <p class="mt-4 text-lg text-background-secondary">
          Join developers using AI-assisted workflows to ship faster than ever
        </p>
        
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
          {siteLinks.docs ? (
          <Button href={`${siteLinks.docs}/getting-started/`} variant="primary" size="lg" data-astro-prefetch>
            <span aria-hidden="true">🚀</span> Get Started Now
          </Button>
          ) : (
          <Button href={siteLinks.github} variant="primary" size="lg" rel="noopener noreferrer" target="_blank">
            <span aria-hidden="true">🚀</span> Get Started Now
          </Button>
          )}
          <Button href={siteLinks.github} variant="secondary" size="lg" rel="noopener noreferrer" target="_blank">
            <span aria-hidden="true">🐈</span> View on GitHub
          </Button>
        </div>
        
        <div class="mt-8 text-sm text-background-secondary">
          <span aria-hidden="true">🔒</span> MIT Licensed <span aria-hidden="true">•</span> <span aria-hidden="true">🎆</span> Production Ready <span aria-hidden="true">•</span> <span aria-hidden="true">🤖</span> AI Optimized
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
