---
import Badge from "@/components/atoms/Badge.astro";
import Button from "@/components/atoms/Button.astro";

import Card from "@/components/molecules/Card.astro";
import ExpandableFeatureCard from "@/components/molecules/ExpandableFeatureCard.astro";
import Container from "@/components/structural/Container.astro";
import Grid from "@/components/structural/Grid.astro";
import Section from "@/components/structural/Section.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const features = [
  {
    icon: "🚀",
    title: "Performance-First Architecture",
    description:
      "Zero-JS baseline with islands architecture. Ships with 95+ Lighthouse and CI/CD performance budgets.",
    metric: "95+ Lighthouse",
    expandedDetails: [
      "Static site generation with selective hydration for optimal performance",
      "Automatic code splitting and lazy loading for JavaScript components",
      "Built-in image optimization with WebP/AVIF conversion",
      "Performance budgets enforced in CI/CD pipeline",
      "Core Web Vitals monitoring and optimization",
    ],
  },
  {
    icon: "🤖",
    title: "AI-Assisted Development",
    description:
      "Rich context documentation and prompt libraries that supercharge AI coding for 10x faster development.",
    metric: "10x Faster",
    expandedDetails: [
      "Structured documentation that AI assistants can understand and use effectively",
      "Architectural Decision Records (ADRs) for tracking design choices",
      "Phase-by-phase implementation guides with clear milestones",
      "Pattern libraries with real-world examples and anti-patterns",
      "Context-aware documentation that adapts to your project needs",
    ],
  },
  {
    icon: "🎨",
    title: "Enterprise-Grade Design System",
    description:
      "Semantic design tokens with automatic dark mode, WCAG AA compliance, and automated contrast validation.",
    metric: "WCAG AA",
    expandedDetails: [
      "Semantic color tokens that automatically adapt to light/dark themes",
      "WCAG AA contrast ratio validation in build process",
      "Consistent spacing, typography, and color scales",
      "Automated design token generation from source files",
      "Theme switching with system preference detection",
    ],
  },
  {
    icon: "⚡",
    title: "Next-Gen Opinionated Toolchain",
    description:
      "Biome replaces ESLint + Prettier with 20x speed. TypeScript strict mode and automated quality gates.",
    metric: "20x Faster",
    expandedDetails: [
      "Biome replaces ESLint + Prettier with 20x performance improvement",
      "TypeScript strict mode catches errors before they reach production",
      "Git hooks for automated code quality checks",
      "Conventional commits with automated changelog generation",
      "Dependency vulnerability scanning and updates",
    ],
  },
  {
    icon: "🧩",
    title: "Production-Ready Components",
    description:
      "Battle-tested atomic design system with accessible primitives, responsive layouts, and TypeScript interfaces.",
    metric: "Type-Safe",
    expandedDetails: [
      "Atomic design methodology: atoms, molecules, organisms, templates",
      "Accessible components with proper ARIA attributes",
      "Responsive design patterns built into every component",
      "TypeScript interfaces for type-safe component props",
      "Reusable structural components for consistent layouts",
    ],
  },
  {
    icon: "🏗️",
    title: "Robust Page Templates",
    description:
      "Portfolio-ready pages included: About, Projects, Blog, Contact. Launch with professional content, not empty shells.",
    metric: "Ready to Ship",
    expandedDetails: [
      "Professional About page with skills showcase and responsive design",
      "Projects portfolio with grid layouts and detailed case studies",
      "Blog system with MDX support and content collections",
      "Contact forms with Cloudflare Pages integration",
      "Responsive navigation and footer components",
    ],
  },
];

// Technical term definitions for tooltips
const techTerms: Record<string, string> = {
  // biome-ignore lint/style/useNamingConvention: proper noun dictionary key
  Biome:
    "A fast, all-in-one toolchain that replaces ESLint and Prettier with 20x better performance",
  // biome-ignore lint/style/useNamingConvention: proper noun dictionary key
  Preact:
    "A lightweight 3KB alternative to React with the same API, perfect for interactive components",
  // biome-ignore lint/style/useNamingConvention: proper noun dictionary key
  TypeScript:
    "JavaScript with type safety that catches errors during development instead of production",
  // biome-ignore lint/style/useNamingConvention: proper noun dictionary key
  Astro:
    "A modern web framework that delivers zero JavaScript by default with optional interactive islands",
  "Tailwind CSS": "A utility-first CSS framework that lets you build designs directly in your HTML",
  // biome-ignore lint/style/useNamingConvention: proper noun dictionary key
  Sharp:
    "High-performance image processing library that automatically optimizes images for the web",
  // biome-ignore lint/style/useNamingConvention: proper noun dictionary key
  Playwright: "Cross-browser testing framework that works with Chrome, Firefox, Safari, and Edge",
  // biome-ignore lint/style/useNamingConvention: proper noun dictionary key
  Vitest: "Lightning-fast unit testing framework built on Vite with hot module replacement",
  "WCAG AA":
    "Web Content Accessibility Guidelines level AA - the standard for accessible web content",
  "Islands Architecture":
    "A pattern where interactive components are isolated islands in a sea of static HTML",
  "Zero-JS baseline":
    "The site works perfectly without JavaScript, then progressively enhances with interactivity",
};

const metrics = [
  { label: "Performance", score: "95+", icon: "🚀" },
  { label: "Accessibility", score: "100", icon: "♿" },
  { label: "Best Practices", score: "100", icon: "🛡️" },
  { label: "SEO", score: "100", icon: "🔍" },
];

const techStack = [
  {
    name: "Astro",
    version: "v5.x",
    description: "Static site generator with islands",
    benefit: "Zero-JS by default, blazing fast performance",
    category: "Framework",
  },
  {
    name: "TypeScript",
    version: "v5.8.3",
    description: "Type-safe JavaScript with strict mode",
    benefit: "Catch errors early, better DX",
    category: "Language",
  },
  {
    name: "Tailwind CSS",
    version: "v3.4.4",
    description: "Utility-first CSS framework",
    benefit: "Rapid styling, consistent design system",
    category: "Styling",
  },
  {
    name: "Biome",
    version: "v2.0.6",
    description: "All-in-one toolchain for web projects",
    benefit: "20x faster than ESLint + Prettier combined",
    category: "Tooling",
  },
  {
    name: "Preact",
    version: "v10.x",
    description: "Lightweight React alternative",
    benefit: "3KB runtime, familiar React-like syntax",
    category: "Interactivity",
  },
  {
    name: "Playwright",
    version: "v1.x",
    description: "End-to-end testing",
    benefit: "Reliable cross-browser testing automation",
    category: "E2E Testing",
  },
  {
    name: "Vitest",
    version: "v2.x",
    description: "Fast unit testing powered by Vite",
    benefit: "Lightning-fast test execution and hot reload",
    category: "Unit Testing",
  },
  {
    name: "Sharp",
    version: "v0.x",
    description: "High-performance image processing",
    benefit: "Automatic conversion, responsive images",
    category: "Image Processing",
  },
];

const stackRationale = {
  performance:
    "Every tool chosen prioritizes speed and efficiency, from Astro's zero-JS baseline to Biome's 20x faster linting.",
  developerExperience:
    "Modern tooling with TypeScript strict mode, hot reload, and comprehensive testing ensures productive development.",
  productionReady:
    "Battle-tested tools used by major companies, with strong community support and active maintenance.",
  futureProof:
    "Latest versions of stable technologies that will continue to evolve with web standards.",
};
---

<BaseLayout
  title="Astro Performance Starter | Production-Ready Template for AI-Assisted Development"
  description="Build blazing-fast websites with Astro's modern architecture. Zero-JS baseline, 100/100 Lighthouse scores, and AI-optimized documentation for rapid development."
>
  <!-- Hero Section -->
  <Section class="relative overflow-hidden flex flex-col items-center justify-center text-center min-h-[calc(100vh-4rem)]">
    <!-- Background gradient -->
    <div
      class="absolute inset-x-0 top-[-10rem] -z-10 transform-gpu overflow-hidden blur-3xl sm:top-[-20rem]"
      aria-hidden="true"
    >
      <div class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-primary-500 to-primary-700 opacity-20 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]"></div>
    </div>
    
    <Container>
      <div class="mx-auto max-w-4xl text-center">
        <Badge class="mb-4 sm:mb-6 bg-primary-100 text-primary-800 text-sm sm:text-base px-3 sm:px-4 py-1.5 sm:py-2">
          🎆 Production-Ready Astro Template
        </Badge>
        
        <h1 class="text-3xl sm:text-4xl lg:text-6xl font-extrabold tracking-tight text-foreground-primary">
          Astro Performance Starter.
          <br>
          <span class="bg-gradient-to-r from-primary-600 to-secondary-600 bg-clip-text text-transparent">
           Beyond Opinionated.
          </span>
        </h1>
        
        <p class="mt-3 sm:mt-4 text-base sm:text-lg leading-6 sm:leading-7 text-foreground-secondary">
          Build blazing-fast websites with Astro's modern architecture. Zero-JS baseline, 100/100 Lighthouse scores, and AI-optimized documentation for rapid development.
        </p>
        
        <div class="mt-4 sm:mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-6">
          <Button href="https://github.com/clownware/astro-starter-template" variant="primary" class="text-sm sm:text-base h-10 sm:h-12 px-4 sm:px-6">
            <svg class="w-4 h-4 sm:w-5 sm:h-5 mr-2" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.30.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
            View on GitHub
          </Button>
          <Button href="https://astro.clownware.org/getting-started/quick-track-deploy" variant="secondary" class="text-sm sm:text-base h-10 sm:h-12 px-4 sm:px-6">
            📖 View Documentation →
          </Button>
        </div>
        
        <div class="mt-3 sm:mt-4 text-xs sm:text-sm text-foreground-subtle">
          ✓ TypeScript strict mode • ✓ Biome 20x faster linting • ✓ WCAG AA compliant
        </div>
      </div>
    </Container>
    <!-- Scroll Indicator -->
    <div class="absolute inset-x-0 bottom-4 flex flex-col items-center">
      <a href="#performance" class="group flex flex-col items-center text-foreground-secondary hover:text-primary-600 transition-colors" aria-label="Scroll to next section">
        <span class="text-xs sm:text-sm font-medium mb-1 sm:mb-2 opacity-75 group-hover:opacity-100 transition-opacity">Explore below</span>
        <svg class="w-5 h-5 sm:w-6 sm:h-6 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </a>
    </div>
  </Section>

  <!-- Lighthouse Metrics Showcase -->
  <Section id="performance" class="relative bg-background-secondary">
    <!-- Section separator -->
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary-300 to-transparent opacity-50"></div>
    <Container>
      <div class="text-center">
        <h2 class="text-3xl font-bold text-foreground-primary">
          🎯 Lighthouse Performance Scores
        </h2>
        <p class="mt-4 text-lg text-foreground-secondary">
          Optimized for Core Web Vitals and search engine performance
        </p>
      </div>
      
      <div class="mt-4 sm:mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
        {metrics.map((metric) => (
          <Card class="border-2 border-primary-300 bg-background-secondary p-6 text-center">
            <div class="text-3xl font-bold text-primary-600">{metric.score}</div>
            <div class="mt-1 text-sm font-medium text-foreground-secondary">{metric.label}</div>

          </Card>
        ))}
      </div>
      
      <div class="mt-8 text-center">
        <p class="text-sm text-foreground-subtle">
          Scores reflect ideal conditions (empty starter). Real-world results may vary by deployment and content.
        </p>
      </div>
    </Container>
  </Section>

  <!-- Key Features -->
  <Section id="features" class="relative">
    <!-- Section separator -->
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary-300 to-transparent opacity-50"></div>
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-foreground-primary sm:text-4xl">
          Why Choose This Template?
        </h2>
        <div class="mt-6 flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 text-sm text-foreground-subtle">
        </div>
      </div>
      
      <Grid class="mt-12 gap-8">
        {features.map((feature) => (
          <ExpandableFeatureCard
            icon={feature.icon}
            title={feature.title}
            description={feature.description}
            metric={feature.metric}
            expandedDetails={feature.expandedDetails}
            techTerms={techTerms}
          />
        ))}
      </Grid>
    </Container>
  </Section>

  <!-- Tech Stack -->
  <Section id="tech-stack" class="bg-background-secondary relative">
    <!-- Section separator -->
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary-300 to-transparent opacity-50"></div>
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold text-foreground-primary">
          🛠️ Modern Tech Stack
        </h2>
        <p class="mt-4 text-lg text-foreground-secondary">
          Carefully selected tools for optimal developer experience
        </p>
      </div>
      
      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {techStack.map((tech) => (
          <Card class="p-6 text-center hover:shadow-lg transition-shadow group">
            <div class="mb-3">
              <Badge class="bg-secondary-100 text-secondary-800 text-xs">
                {tech.category}
              </Badge>
            </div>
            <h3 class="font-semibold text-foreground-primary text-lg mb-2">{tech.name}</h3>
            <p class="text-sm text-primary-600 font-mono font-medium mb-3">{tech.version}</p>
            <p class="text-sm text-foreground-secondary mb-3 leading-relaxed">{tech.description}</p>
            <div class="mt-4 pt-4 border-t border-dashed border-border-default">
              <p class="text-xs text-foreground-subtle italic group-hover:text-foreground-secondary transition-colors">
                                {tech.benefit}              </p>
            </div>
          </Card>
        ))}
      </div>
      
      <!-- Why This Stack Section -->
      <div class="mt-12 mx-auto max-w-4xl">
        <div class="text-center mb-8">
          <h3 class="text-2xl font-bold text-foreground-primary mb-4">
            🤔 Why This Stack?
          </h3>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <Card class="p-6">
            <h4 class="font-semibold text-foreground-primary mb-3 flex items-center">
              ⚡ Performance First
            </h4>
            <p class="text-sm text-foreground-secondary leading-relaxed">
              {stackRationale.performance}
            </p>
          </Card>
          
          <Card class="p-6">
            <h4 class="font-semibold text-foreground-primary mb-3 flex items-center">
              🎯 Developer Experience
            </h4>
            <p class="text-sm text-foreground-secondary leading-relaxed">
              {stackRationale.developerExperience}
            </p>
          </Card>
          
          <Card class="p-6">
            <h4 class="font-semibold text-foreground-primary mb-3 flex items-center">
              🏭 Production Ready
            </h4>
            <p class="text-sm text-foreground-secondary leading-relaxed">
              {stackRationale.productionReady}
            </p>
          </Card>
          
          <Card class="p-6">
            <h4 class="font-semibold text-foreground-primary mb-3 flex items-center">
              🔮 Future Proof
            </h4>
            <p class="text-sm text-foreground-secondary leading-relaxed">
              {stackRationale.futureProof}
            </p>
          </Card>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Implementation Tracks -->
  <Section id="implementation" class="relative">
    <!-- Section separator -->
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary-300 to-transparent opacity-50"></div>
    <Container>
      <div class="mx-auto max-w-4xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-foreground-primary">
            🛤️ Choose Your Implementation Track
          </h2>
          <p class="mt-4 text-lg text-foreground-secondary">
            Structured paths based on your timeline and goals
          </p>
        </div>
        
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
          <!-- MVP Track -->
          <Card class="p-6 bg-primary-50 border-2 border-primary-200">
            <div class="mb-4">
              <h3 class="text-xl font-bold text-primary-800">
                ⚡ MVP Track
              </h3>
            </div>
            <p class="text-primary-700 mb-6">
              Launch a minimum viable product with essential features and performance optimization.
            </p>
            <ul class="text-sm text-primary-600 space-y-2 mb-6">
              <li>✓ Core pages and navigation</li>
              <li>✓ Performance optimization</li>
              <li>✓ SEO and accessibility</li>
              <li>✓ Basic deployment</li>
            </ul>
            <Button href="https://astro.clownware.org/tracks/mvp-track-guide" variant="primary" class="w-full">
              Start MVP Track →
            </Button>
          </Card>
          
          <!-- Showcase Track -->
          <Card class="p-6 bg-secondary-50 border-2 border-secondary-200">
            <div class="mb-4">
              <h3 class="text-xl font-bold text-secondary-800">
                🏆 Showcase Track
              </h3>
            </div>
            <p class="text-secondary-700 mb-6">
              Build a portfolio-worthy project with advanced features and comprehensive documentation.
            </p>
            <ul class="text-sm text-secondary-600 space-y-2 mb-6">
              <li>✓ Advanced animations</li>
              <li>✓ Complex interactions</li>
              <li>✓ Content management</li>
              <li>✓ Advanced deployment</li>
            </ul>
            <Button href="https://astro.clownware.org/tracks/showcase-track-guide" variant="primary" class="w-full">
              Start Showcase Track →
            </Button>
          </Card>
        </div>
      </div>
    </Container>
  </Section>

  <!-- CTA Section -->
  <Section class="relative bg-foreground-primary">
    <!-- Section separator -->
    <div class="absolute top-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-primary-300 to-transparent opacity-50"></div>
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold text-background-primary">
          Ready to Build Something Amazing?
        </h2>
        <p class="mt-4 text-lg text-background-secondary">
          Join developers using AI-assisted workflows to ship faster than ever
        </p>
        
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
          <Button href="https://astro.clownware.org/getting-started/quick-track-deploy" variant="primary" size="lg">
            🚀 Get Started Now
          </Button>
          <Button href="https://github.com/clownware/astro-starter-template" variant="secondary" size="lg">
            🐈 View on GitHub
          </Button>
        </div>
        
        <div class="mt-8 text-sm text-background-secondary">
          🔒 MIT Licensed • 🎆 Production Ready • 🤖 AI Optimized
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
