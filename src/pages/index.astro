---
import Badge from "@/components/atoms/Badge.astro";
import Button from "@/components/atoms/Button.astro";

import Card from "@/components/molecules/Card.astro";
import Container from "@/components/structural/Container.astro";
import Grid from "@/components/structural/Grid.astro";
import Section from "@/components/structural/Section.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

const features = [
  {
    icon: "🚀",
    title: "Performance-First Architecture",
    description:
      "Zero-JS baseline targeting 100/100 Lighthouse scores with strict quality gates enforced by Biome and CI/CD.",
    metric: "95+ Performance",
  },
  {
    icon: "🤖",
    title: "AI-Optimized Documentation",
    description:
      "12-phase implementation guides, ADRs, and pattern libraries designed for rich, coherent AI context.",
    metric: "12 Phases",
  },
  {
    icon: "🎨",
    title: "Token-Driven Design System",
    description:
      "Full dark mode support with WCAG AA accessibility and automated contrast validation built into CI.",
    metric: "Design Tokens",
  },
  {
    icon: "⚡",
    title: "Modern Toolchain",
    description:
      "Biome for 20x faster linting, TypeScript strict mode, and automated versioning with Husky hooks.",
    metric: "20x Faster",
  },
  {
    icon: "🔧",
    title: "Production-Ready Components",
    description:
      "Atomic design with structural primitives, optimized Image wrapper, and zero-config Tailwind setup.",
    metric: "Zero Config",
  },
  {
    icon: "📚",
    title: "Multiple Implementation Tracks",
    description:
      "Choose MVP Track (2-3 weeks) or Showcase Track (4-6 weeks) with comprehensive deployment guides.",
    metric: "2 Tracks",
  },
];

const metrics = [
  { label: "Performance", score: "95+", icon: "🚀" },
  { label: "Accessibility", score: "100", icon: "♿" },
  { label: "Best Practices", score: "100", icon: "🛡️" },
  { label: "SEO", score: "100", icon: "🔍" },
];

const techStack = [
  { name: "Astro", version: "v5.x", description: "Modern web framework" },
  { name: "TypeScript", version: "v5.8.3", description: "Strict mode enabled" },
  { name: "Tailwind CSS", version: "v3.4.4", description: "Utility-first styling" },
  { name: "Biome", version: "v2.0.6", description: "20x faster linting" },
  { name: "Preact", version: "v10.x", description: "Interactive islands" },
  { name: "Playwright", version: "v1.x", description: "E2E testing" },
  { name: "Vitest", version: "v2.x", description: "Fast unit testing" },
  { name: "Sharp", version: "v0.x", description: "Image optimization" },
];
---

<BaseLayout
  title="Astro Performance Starter | Production-Ready Template for AI-Assisted Development"
  description="Build blazing-fast websites with Astro's modern architecture. Zero-JS baseline, 100/100 Lighthouse scores, and AI-optimized documentation for rapid development."
>
  <!-- Hero Section -->
  <Section class="relative overflow-hidden pt-16 pb-32">
    <!-- Background gradient -->
    <div class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80" aria-hidden="true">
      <div class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[36.125rem] -translate-x-1/2 rotate-[30deg] bg-gradient-to-tr from-blue-500 to-purple-600 opacity-20 sm:left-[calc(50%-30rem)] sm:w-[72.1875rem]"></div>
    </div>
    
    <Container>
      <div class="mx-auto max-w-4xl text-center">
        <Badge class="mb-6 bg-blue-50 text-blue-700 dark:bg-blue-900/20 dark:text-blue-300 text-base px-4 py-2">
          🎆 Production-Ready Astro Template
        </Badge>
        
        <h1 class="text-5xl font-extrabold tracking-tight text-gray-900 dark:text-white sm:text-7xl">
          Astro Performance Starter.
          <span class="bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
           Beyond Opinionated.
          </span>
        </h1>
        
        <p class="mt-8 text-xl leading-8 text-gray-600 dark:text-gray-300">
          Zero-JS baseline • Strict Quality Gates • 12-phase AI-optimized documentation
          <br class="hidden sm:block" />
          10x idea to production with comprehensive guides and modern toolchain.
        </p>
        
        <div class="mt-12 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
          <Button href="https://github.com/clownware/astro-starter-template" variant="primary">
            View on GitHub
          </Button>
          <Button href="https://astro.clownware.org" variant="secondary">
            View Documentation →
          </Button>
        </div>
        
        <div class="mt-8 text-sm text-gray-500 dark:text-gray-400">
          ✓ TypeScript strict mode • ✓ Biome 20x faster linting • ✓ WCAG AA compliant
        </div>
      </div>
    </Container>
  </Section>

  <!-- Lighthouse Metrics Showcase -->
  <Section class="bg-gray-50 dark:bg-gray-900/50">
    <Container>
      <div class="text-center">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white">
          🏆 Target Performance Metrics
        </h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">
          Lighthouse scores out of the box with strict quality gates
        </p>
      </div>
      
      <div class="mt-12 grid grid-cols-2 gap-6 sm:grid-cols-4">
        {metrics.map((metric) => (
          <Card class="text-center p-6 bg-white dark:bg-gray-800 border-2 border-green-200 dark:border-green-800">
            <div class="text-3xl mb-3">{metric.icon}</div>
            <div class="text-3xl font-bold text-green-600 dark:text-green-400">{metric.score}</div>
            <div class="text-sm font-medium text-gray-700 dark:text-gray-300 mt-1">{metric.label}</div>
          </Card>
        ))}
      </div>
      
      <div class="mt-8 text-center">
        <p class="text-sm text-gray-500 dark:text-gray-400">
          Scores reflect ideal conditions (empty starter). Real-world results may vary by deployment and content.
        </p>
      </div>
    </Container>
  </Section>

  <!-- Key Features -->
  <Section>
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
          Why Choose This Template?
        </h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">
          Built for developers who want to ship fast without compromising on quality
        </p>
      </div>
      
      <Grid class="mt-16 gap-8">
        {features.map((feature) => (
          <Card class="relative p-8 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 hover:border-blue-300 dark:hover:border-blue-600 transition-colors">
            <div class="flex items-start justify-between mb-4">
              <div class="flex items-start space-x-4 flex-1">
                <div class="text-2xl" aria-hidden="true">{feature.icon}</div>
                <div class="flex-1">
                  <h3 class="text-lg font-semibold text-gray-900 dark:text-white pr-4">
                    {feature.title}
                  </h3>
                </div>
              </div>
              <Badge class="bg-blue-50 text-blue-700 dark:bg-blue-900/20 dark:text-blue-300 text-xs shrink-0">
                {feature.metric}
              </Badge>
            </div>
            <p class="text-gray-600 dark:text-gray-300 ml-12">
              {feature.description}
            </p>
          </Card>
        ))}
      </Grid>
    </Container>
  </Section>

  <!-- Tech Stack -->
  <Section class="bg-gray-50 dark:bg-gray-900/50">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white">
          🛠️ Modern Tech Stack
        </h2>
        <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">
          Carefully selected tools for excellent developer experience
        </p>
      </div>
      
      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {techStack.map((tech) => (
          <Card class="p-6 text-center bg-white dark:bg-gray-800 hover:border-blue-300 dark:hover:border-blue-600 transition-colors">
            <h3 class="font-semibold text-gray-900 dark:text-white">{tech.name}</h3>
            <p class="text-sm text-blue-600 dark:text-blue-400 font-mono font-medium">{tech.version}</p>
            <p class="text-sm text-gray-600 dark:text-gray-300 mt-1">{tech.description}</p>
          </Card>
        ))}
      </div>
    </Container>
  </Section>

  <!-- Implementation Tracks -->
  <Section>
    <Container>
      <div class="mx-auto max-w-4xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl font-bold text-gray-900 dark:text-white">
            🛤️ Choose Your Implementation Track
          </h2>
          <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">
            Structured paths based on your timeline and goals
          </p>
        </div>
        
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
          <!-- MVP Track -->
          <Card class="p-8 bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 border-2 border-green-200 dark:border-green-800">
            <div class="mb-4">
              <h3 class="text-xl font-bold text-green-800 dark:text-green-300">
                ⚡ MVP Track
              </h3>
            </div>
            <p class="text-green-700 dark:text-green-300 mb-6">
              Launch a minimum viable product with essential features and performance optimization.
            </p>
            <ul class="text-sm text-green-600 dark:text-green-400 space-y-2 mb-6">
              <li>✓ Core pages and navigation</li>
              <li>✓ Performance optimization</li>
              <li>✓ SEO and accessibility</li>
              <li>✓ Basic deployment</li>
            </ul>
            <Button href="https://astro.clownware.org/tracks/mvp-track-guide" variant="primary" class="w-full">
              Start MVP Track →
            </Button>
          </Card>
          
          <!-- Showcase Track -->
          <Card class="p-8 bg-gradient-to-br from-purple-50 to-indigo-50 dark:from-purple-900/20 dark:to-indigo-900/20 border-2 border-purple-200 dark:border-purple-800">
            <div class="mb-4">
              <h3 class="text-xl font-bold text-purple-800 dark:text-purple-300">
                🏆 Showcase Track
              </h3>
            </div>
            <p class="text-purple-700 dark:text-purple-300 mb-6">
              Build a portfolio-worthy project with advanced features and comprehensive documentation.
            </p>
            <ul class="text-sm text-purple-600 dark:text-purple-400 space-y-2 mb-6">
              <li>✓ Advanced animations</li>
              <li>✓ Complex interactions</li>
              <li>✓ Content management</li>
              <li>✓ Advanced deployment</li>
            </ul>
            <Button href="https://astro.clownware.org/tracks/showcase-track-guide" variant="primary" class="w-full">
              Start Showcase Track →
            </Button>
          </Card>
        </div>
      </div>
    </Container>
  </Section>

  <!-- CTA Section -->
  <Section class="bg-gray-900 dark:bg-black">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold text-white">
          Ready to Build Something Amazing?
        </h2>
        <p class="mt-4 text-lg text-gray-300">
          Join developers using AI-assisted workflows to ship faster than ever
        </p>
        
        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
          <Button href="https://astro.clownware.org/getting-started/quick-track-deploy" variant="primary" size="lg">
            🚀 Get Started Now
          </Button>
          <Button href="https://github.com/clownware/astro-starter-template" variant="secondary" size="lg">
            🐈 View on GitHub
          </Button>
        </div>
        
        <div class="mt-8 text-sm text-gray-400">
          🔒 MIT Licensed • 🎆 Production Ready • 🤖 AI Optimized
        </div>
      </div>
    </Container>
  </Section>
</BaseLayout>
