---
import Badge from "@/components/atoms/Badge.astro";
import Button from "@/components/atoms/Button.astro";
import Icon from "@/components/atoms/Icon.astro";

import ScrollReveal from "@/components/atoms/ScrollReveal.astro";
import Card from "@/components/molecules/Card.astro";
import ExpandableFeatureCard from "@/components/molecules/ExpandableFeatureCard.astro";
import PostCard from "@/components/molecules/PostCard.astro";
import SectionSeparator from "@/components/molecules/SectionSeparator.astro";
import Container from "@/components/structural/Container.astro";
import Grid from "@/components/structural/Grid.astro";
import Section from "@/components/structural/Section.astro";
import { siteLinks } from "@/config";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Feature, LighthouseMetric, StackRationale, TechStackItem } from "@/types/content";
import { getPublishedPosts } from "@/utils/blog";
import { formatPostMetadata } from "@/utils/formatDate";
import { withBase } from "@/utils/url-utils";

/**
 * Homepage feature cards showcasing template capabilities.
 * Each feature includes expandable details for comprehensive information.
 */
const features: Feature[] = [
  {
    icon: "🚀",
    title: "Performance-First Architecture",
    description:
      "Zero-JS baseline with islands architecture. Ships with 95+ Lighthouse and CI/CD performance budgets.",
    metric: "95+ Lighthouse",
    expandedDetails: [
      "Static site generation with selective hydration for optimal performance",
      "Automatic code splitting and lazy loading for JavaScript components",
      "Built-in image optimization with WebP/AVIF conversion",
      "Performance budgets enforced in CI/CD pipeline",
      "Core Web Vitals monitoring and optimization",
    ],
  },
  {
    icon: "🤖",
    title: "Agentic Discipline Built In",
    description:
      "Layered AI constitution, role-separated workflow, and halt-on-violation CI gates. Your agent works under the same rules you do.",
    metric: "Halt-on-Violation",
    expandedDetails: [
      "Layered constitution: CLAUDE.md + .claude/engineering.md + .claude/workflow.md + .claude/stack.md",
      "Role-separated workflow: Architect plans, Coder implements, Reviewer verifies (.claude/roles/)",
      "pnpm quality:ci halts on any violation — broken tests, lint, types, and markdown all block merge",
      "Every AI-readable rule names its halt condition with a stated reason, not soft guidance",
      "Pattern source: Uncle Bob's Clean AI: Agentic Discipline series",
    ],
  },
  {
    icon: "🎨",
    title: "Enterprise-Grade Design System",
    description:
      "Semantic design tokens with automatic dark mode, WCAG AA compliance, and automated contrast validation.",
    metric: "WCAG AA",
    expandedDetails: [
      "Semantic color tokens that automatically adapt to light/dark themes",
      "WCAG AA contrast ratio validation in build process",
      "Consistent spacing, typography, and color scales",
      "Automated design token generation from source files",
      "Theme switching with system preference detection",
      "CSS @theme inline — tokens live in CSS, no JS config file",
    ],
  },
  {
    icon: "⚡",
    title: "Next-Gen Opinionated Toolchain",
    description:
      "Biome replaces ESLint + Prettier with 20x speed. Tailwind v4 CSS-native config. TypeScript strict mode and automated quality gates.",
    metric: "20x Faster",
    expandedDetails: [
      "Biome replaces ESLint + Prettier with 20x performance improvement",
      "TypeScript strict mode catches errors before they reach production",
      "Git hooks for automated code quality checks",
      "Conventional commits with automated changelog generation",
      "Dependency vulnerability scanning and updates",
    ],
  },
  {
    icon: "🧩",
    title: "Production-Ready Components",
    description:
      "Battle-tested atomic design system with accessible primitives, responsive layouts, and TypeScript interfaces.",
    metric: "Type-Safe",
    expandedDetails: [
      "Atomic design methodology: atoms, molecules, organisms, templates",
      "Accessible components with proper ARIA attributes",
      "Responsive design patterns built into every component",
      "TypeScript interfaces for type-safe component props",
      "Reusable structural components for consistent layouts",
    ],
  },
  {
    icon: "🏗️",
    title: "Robust Page Templates",
    description:
      "Portfolio-ready pages included: About, Projects, Blog, Contact. Launch with professional content, not empty shells.",
    metric: "Ready to Ship",
    expandedDetails: [
      "Professional About page with skills showcase and responsive design",
      "Projects portfolio with grid layouts and detailed case studies",
      "Blog system with MDX support and content collections",
      "Contact forms with Cloudflare Pages integration",
      "Responsive navigation and footer components",
    ],
  },
];

/**
 * Lighthouse performance metrics for the starter template.
 * Reflects ideal conditions with empty starter content.
 */
const metrics: LighthouseMetric[] = [
  { label: "Performance", score: "95+", icon: "🚀" },
  { label: "Accessibility", score: "100", icon: "♿" },
  { label: "Best Practices", score: "100", icon: "🛡️" },
  { label: "SEO", score: "100", icon: "🔍" },
];

/**
 * Technology stack with versions, descriptions, and benefits.
 * Organized by category for clear understanding of architecture.
 */
const techStack: TechStackItem[] = [
  {
    name: "Astro",
    version: "v6",
    description: "Content Layer API, View Transitions, Islands",
    benefit: "Type-safe content, named view transitions, selective hydration",
    category: "Framework",
  },
  {
    name: "TypeScript",
    version: "v5",
    description: "Type-safe JavaScript with strict mode",
    benefit: "Catch errors early, better DX",
    category: "Language",
  },
  {
    name: "Tailwind CSS",
    version: "v4",
    description: "CSS-native config — no tailwind.config.js",
    benefit: "@theme in CSS, Lightning CSS compiler, zero JS config overhead",
    category: "Styling",
  },
  {
    name: "Biome",
    version: "v2",
    description: "All-in-one toolchain for web projects",
    benefit: "20x faster than ESLint + Prettier combined",
    category: "Tooling",
  },
  {
    name: "Preact",
    version: "v10",
    description: "Lightweight React alternative",
    benefit: "3KB runtime, familiar React-like syntax",
    category: "Interactivity",
  },
  {
    name: "Playwright",
    version: "v1",
    description: "End-to-end testing",
    benefit: "Reliable cross-browser testing automation",
    category: "E2E Testing",
  },
  {
    name: "Vitest",
    version: "v4",
    description: "Fast unit testing powered by Vite",
    benefit: "Lightning-fast test execution and hot reload",
    category: "Unit Testing",
  },
  {
    name: "Astro Container API",
    version: "experimental_",
    description: "Microtests for every .astro atom and molecule",
    benefit: "Sub-second component-contract verification (ADR-040)",
    category: "Component Testing",
  },
  {
    name: "Stryker",
    version: "v9",
    description: "Mutation testing nightly via GitHub Actions",
    benefit: "Verifies tests actually fail when code breaks (ADR-042)",
    category: "Mutation Testing",
  },
  {
    name: "Sharp",
    version: "v0.34.x",
    description: "High-performance image processing",
    benefit: "Automatic conversion, responsive images",
    category: "Image Processing",
  },
];

/**
 * Rationale for technology stack choices.
 * Explains the "why" behind each architectural decision.
 */
const stackRationale: StackRationale = {
  performance:
    "Every tool chosen prioritizes speed and efficiency, from Astro's zero-JS baseline to Biome's 20x faster linting.",
  developerExperience:
    "Modern tooling with TypeScript strict mode, hot reload, and comprehensive testing ensures productive development.",
  productionReady:
    "Battle-tested tools used by major companies, with strong community support and active maintenance.",
  futureProof:
    "Latest versions of stable technologies that will continue to evolve with web standards.",
};

const latestPosts = (await getPublishedPosts()).slice(0, 3);
const latestPostsWithMetadata = latestPosts.map((post) => ({
  ...post,
  metadata: formatPostMetadata(post.data.date, post.body),
}));
---

<BaseLayout
  title="Astro Performance Starter — Agentic Discipline Built In"
  description="Build blazing-fast websites with Astro's modern architecture. Zero-JS baseline, 95+ Lighthouse scores, and a layered AI constitution with halt-on-violation enforcement."
>
  <!-- Hero Section -->
  <Section ariaLabel="Hero section" class="relative overflow-hidden flex flex-col items-center justify-center text-center min-h-[calc(100vh-4rem)]">
    <!-- Background gradient -->
    <div
      class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80"
      aria-hidden="true"
    >
      <div class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-linear-to-tr from-primary-500 to-primary-700 opacity-20 sm:left-[calc(50%-30rem)] sm:w-288.75"></div>
    </div>

    <Container>
      <div class="mx-auto max-w-4xl text-center">
        <Badge transition:name="hero-badge" class="mb-4 sm:mb-6 bg-primary-100 text-primary-800 text-sm sm:text-base px-3 sm:px-4 py-1.5 sm:py-2">
          Astro 6 + Tailwind v4 Starter
        </Badge>

        <h1 transition:name="hero-heading" class="text-3xl sm:text-4xl lg:text-6xl font-extrabold tracking-tight text-foreground">
          Astro Performance Starter.
        </h1>
        <p class="mt-2 text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight">
          {/* Shared view-transition name — the gradient sub-line glides into the
              gradient headline on /showcase and /how-it-works (ADR-048 #2). */}
          <span transition:name="hero-grad" class="bg-linear-to-r from-primary-600 to-secondary-600 bg-clip-text text-transparent">
            Point your AI agent at the docs and ship.
          </span>
        </p>

        <p class="mt-3 sm:mt-4 text-base sm:text-lg leading-relaxed text-muted-foreground max-w-2xl mx-auto">
          Build blazing-fast websites with Astro's zero-JS architecture — 95+ Lighthouse scores out of the box. Ships with implementation guides, Claude Code skills, and context docs for your coding agent.
        </p>

        {/* TODO: Make GitHub repo public — visitors currently see a 404 */}
        <div class="mt-4 sm:mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row sm:gap-6">
          <Button href={siteLinks.github} variant="primary" class="cta-sheen text-sm sm:text-base h-10 sm:h-12 px-4 sm:px-6" rel="noopener noreferrer" target="_blank">
            <Icon name="github" class="size-4 sm:size-5 mr-2" decorative />
            Clone the Template
          </Button>
          {siteLinks.docs && (
          <Button href={`${siteLinks.docs}/getting-started/`} variant="secondary" class="text-sm sm:text-base h-10 sm:h-12 px-4 sm:px-6" data-astro-prefetch>
            <span aria-hidden="true">📖</span> View Documentation →
          </Button>
          )}
        </div>

        <ul class="mt-3 sm:mt-4 text-xs sm:text-sm text-muted-foreground flex flex-wrap items-center justify-center gap-x-4 gap-y-1" role="list" aria-label="Key features">
          <li class="flex items-center gap-1">
            <span aria-hidden="true">✓</span>
            <span><span class="sr-only">Included: </span>TypeScript strict mode</span>
          </li>
          <li class="flex items-center gap-1" aria-hidden="true">•</li>
          <li class="flex items-center gap-1">
            <span aria-hidden="true">✓</span>
            <span><span class="sr-only">Included: </span>CSS-native Tailwind config</span>
          </li>
          <li class="flex items-center gap-1" aria-hidden="true">•</li>
          <li class="flex items-center gap-1">
            <span aria-hidden="true">✓</span>
            <span><span class="sr-only">Included: </span>View Transitions built-in</span>
          </li>
        </ul>
      </div>
    </Container>
    <!-- Scroll Indicator -->
    <div class="absolute inset-x-0 bottom-4 flex flex-col items-center">
      <a href="#performance" class="no-underline group flex flex-col items-center text-muted-foreground hover:text-link transition-colors" aria-label="Scroll to next section">
        <span class="text-xs sm:text-sm font-medium mb-1 sm:mb-2 opacity-75 group-hover:opacity-100 transition-opacity">Explore below</span>
        <Icon name="arrow-down" class="size-5 sm:size-6 animate-bounce motion-reduce:animate-none" decorative />
      </a>
    </div>
  </Section>

  <!-- Lighthouse Metrics Showcase -->
  <Section id="performance" ariaLabel="Performance metrics section" class="relative bg-surface">
    <SectionSeparator />
    <Container>
      <ScrollReveal>
        <div class="text-center">
          <h2 class="text-3xl font-bold text-foreground text-balance">
            <span aria-hidden="true" class="mr-1.5">🎯</span> Quality Metrics
          </h2>
          <p class="mt-4 text-lg text-muted-foreground">
            Lighthouse for runtime performance · Stryker for test-quality verification (ADR-042)
          </p>
        </div>
      </ScrollReveal>

      <ul class="mt-4 sm:mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4 list-none" role="list" aria-label="Lighthouse performance metrics">
        {metrics.map((metric) => (
          <li>
            <Card class="border-2 border-primary-300 bg-surface p-6 text-center h-full">
              <div class="text-3xl font-bold text-link" aria-label={`${metric.label} score: ${metric.score}`}>
                <span aria-hidden="true">{metric.icon}</span>
                {metric.score}
              </div>
              <div class="mt-1 text-sm font-medium text-muted-foreground">{metric.label}</div>
            </Card>
          </li>
        ))}
      </ul>

      <div class="mt-8 text-center flex flex-col gap-4">
        <p class="text-sm text-muted-foreground">
          Scores reflect ideal conditions (empty starter). Real-world results may vary by deployment and content.
        </p>

        <!-- Live Quality Badge -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
          {siteLinks.pagespeed && (
          <a
            href={siteLinks.pagespeed}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-primary-100 hover:bg-primary-200 text-primary-800 transition-colors group"
            aria-label="View live Lighthouse scores on PageSpeed Insights"
          >
            <span class="text-sm font-medium"><span aria-hidden="true">🎯</span> View Live Scores</span>
            <svg class="size-4 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </a>
          )}

          <a
            href={`${siteLinks.github}/actions`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-secondary-100 text-secondary-800 hover:bg-secondary-200 text-xs font-medium transition-colors"
            aria-label="View CI verification results on GitHub (opens in new tab)"
          >
            <svg class="size-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Verified by CI
          </a>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Key Features -->
  <Section id="features" ariaLabel="Key features section" class="relative">
    <SectionSeparator />
    <Container>
      <ScrollReveal>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl text-balance">
          Why Choose This Template?
        </h2>
        <p class="mt-4 text-base text-muted-foreground max-w-xl mx-auto">
          Six production-tested capabilities — from zero-JS performance to AI-ready documentation — ready to customise from day one.
        </p>
      </div>
      </ScrollReveal>

      {/* Hero cards — the two differentiators */}
      <div class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-8">
        {features.slice(0, 2).map((feature) => (
          <ExpandableFeatureCard
            icon={feature.icon}
            title={feature.title}
            description={feature.description}
            metric={feature.metric}
            expandedDetails={feature.expandedDetails}
          />
        ))}
      </div>

      {/* Supporting capabilities */}
      <Grid class="mt-8 gap-8">
        {features.slice(2).map((feature) => (
          <ExpandableFeatureCard
            icon={feature.icon}
            title={feature.title}
            description={feature.description}
            metric={feature.metric}
            expandedDetails={feature.expandedDetails}
          />
        ))}
      </Grid>
    </Container>
  </Section>

  <!-- Implementation Tiers (ADR-033) -->
  <Section id="implementation" ariaLabel="Implementation tiers section" class="relative">
    <SectionSeparator />
    <Container>
      <div class="mx-auto max-w-5xl">
        <ScrollReveal>
          <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-foreground text-balance">
              What You Get on Clone
            </h2>
            <p class="mt-4 text-lg text-muted-foreground">
              Foundation is done. Build has demo content ready to replace. Polish guides you to production.
            </p>
          </div>
        </ScrollReveal>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
          <!-- Foundation Tier -->
          <Card class="p-6 border-l-4 border-l-secondary-500">
            <div class="mb-4">
              <Badge variant="secondary" size="xs">✅ Done</Badge>
              <h3 class="mt-3 text-xl font-bold text-foreground flex items-center gap-2">
                <span aria-hidden="true">🏗️</span> Foundation
              </h3>
            </div>
            <p class="text-muted-foreground mb-6">
              Architecture, tooling, and design system — pre-configured and working. You never touch this unless you're making architectural changes.
            </p>
            <ul class="text-sm text-muted-foreground flex flex-col gap-2 mb-6" role="list" aria-label="Foundation tier features">
              <li class="flex items-start gap-2 not-last:border-b not-last:border-border not-last:pb-2">
                <span class="text-secondary-500 mt-0.5" aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Astro + TypeScript + Tailwind + Biome</span>
              </li>
              <li class="flex items-start gap-2 not-last:border-b not-last:border-border not-last:pb-2">
                <span class="text-secondary-500 mt-0.5" aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Content Collections schemas</span>
              </li>
              <li class="flex items-start gap-2 not-last:border-b not-last:border-border not-last:pb-2">
                <span class="text-secondary-500 mt-0.5" aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Design tokens system</span>
              </li>
              <li class="flex items-start gap-2 not-last:border-b not-last:border-border not-last:pb-2">
                <span class="text-secondary-500 mt-0.5" aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Layered AI constitution (CLAUDE.md + .claude/)</span>
              </li>
              <li class="flex items-start gap-2 not-last:border-b not-last:border-border not-last:pb-2">
                <span class="text-secondary-500 mt-0.5" aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Halt-on-violation CI gates</span>
              </li>
            </ul>
            <p class="text-xs text-muted-foreground italic">Clone the repo and this is already running.</p>
          </Card>

          <!-- Build Tier -->
          <Card class="p-6 border-l-4 border-l-warning-600">
            <div class="mb-4">
              <Badge variant="neutral" size="xs">📦 Demo Included</Badge>
              <h3 class="mt-3 text-xl font-bold text-foreground flex items-center gap-2">
                <span aria-hidden="true">⚡</span> Build
              </h3>
            </div>
            <p class="text-muted-foreground mb-6">
              Components, page templates, blog posts, and case studies — all built with real content. Replace the demo content with your own brand and copy.
            </p>
            <ul class="text-sm text-muted-foreground flex flex-col gap-2 mb-6" role="list" aria-label="Build tier features">
              <li class="flex items-start gap-2 not-last:border-b not-last:border-border not-last:pb-2">
                <span class="text-warning mt-0.5" aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Atoms, molecules &amp; organism components</span>
              </li>
              <li class="flex items-start gap-2 not-last:border-b not-last:border-border not-last:pb-2">
                <span class="text-warning mt-0.5" aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Page templates for every section</span>
              </li>
              <li class="flex items-start gap-2 not-last:border-b not-last:border-border not-last:pb-2">
                <span class="text-warning mt-0.5" aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Blog, projects &amp; case study content</span>
              </li>
              <li class="flex items-start gap-2 not-last:border-b not-last:border-border not-last:pb-2">
                <span class="text-warning mt-0.5" aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Container API microtests for every atom &amp; molecule</span>
              </li>
              <li class="flex items-start gap-2 not-last:border-b not-last:border-border not-last:pb-2">
                <span class="text-warning mt-0.5" aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Test-first discipline enforced in CI (ADR-037)</span>
              </li>
            </ul>
            <p class="text-xs text-muted-foreground italic">Your agent works under the same constitution — every component has a contract test.</p>
          </Card>

          <!-- Polish Tier -->
          <Card class="p-6 border-l-4 border-l-success-600">
            <div class="mb-4">
              <Badge variant="primary" size="xs">📋 Guided</Badge>
              <h3 class="mt-3 text-xl font-bold text-foreground flex items-center gap-2">
                <span aria-hidden="true">🏆</span> Polish
              </h3>
            </div>
            <p class="text-muted-foreground mb-6">
              Performance budgets, deployment configuration, and monitoring. Follow the implementation guides when you're ready to go live.
            </p>
            <ul class="text-sm text-muted-foreground flex flex-col gap-2 mb-6" role="list" aria-label="Polish tier features">
              <li class="flex items-start gap-2 not-last:border-b not-last:border-border not-last:pb-2">
                <span class="text-success mt-0.5" aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Performance budget enforcement</span>
              </li>
              <li class="flex items-start gap-2 not-last:border-b not-last:border-border not-last:pb-2">
                <span class="text-success mt-0.5" aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Deployment configuration</span>
              </li>
              <li class="flex items-start gap-2 not-last:border-b not-last:border-border not-last:pb-2">
                <span class="text-success mt-0.5" aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Documentation and AI context</span>
              </li>
              <li class="flex items-start gap-2 not-last:border-b not-last:border-border not-last:pb-2">
                <span class="text-success mt-0.5" aria-hidden="true">✓</span>
                <span><span class="sr-only">Included: </span>Mutation testing as quality verification (ADR-042)</span>
              </li>
            </ul>
            <p class="text-xs text-muted-foreground italic">Each phase has a clear scope — go as far as your project needs.</p>
          </Card>
        </div>

        <div class="mt-8 text-center">
          {siteLinks.docs ? (
          <Button href={`${siteLinks.docs}/getting-started/`} variant="primary" data-astro-prefetch>
            View Implementation Guide →
          </Button>
          ) : (
          <Button href={siteLinks.github} variant="primary" rel="noopener noreferrer" target="_blank">
            View on GitHub →
          </Button>
          )}
        </div>
      </div>
    </Container>
  </Section>

  <!-- Tech Stack -->
  <Section id="tech-stack" ariaLabel="Technology stack section" class="bg-surface relative">
    <SectionSeparator />
    <Container>
      <ScrollReveal>
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold text-foreground text-balance">
            <span aria-hidden="true" class="mr-1.5">🛠️</span> Modern Tech Stack
          </h2>
          <p class="mt-4 text-lg text-muted-foreground">
            Carefully selected tools for optimal developer experience
          </p>
        </div>
      </ScrollReveal>

      <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {techStack.map((tech) => (
          <Card class="p-6 text-center hover:shadow-lg transition-shadow group">
            <div class="mb-3">
              <Badge class="bg-secondary-100 text-secondary-800 text-xs">
                {tech.category}
              </Badge>
            </div>
            <h3 class="font-semibold text-foreground text-lg mb-2">{tech.name}</h3>
            <p class="text-sm text-link font-mono font-medium mb-3">{tech.version}</p>
            <p class="text-sm text-muted-foreground mb-3 leading-relaxed">{tech.description}</p>
            <div class="mt-4 pt-4 border-t border-dashed border-border">
              <p class="text-xs text-muted-foreground group-hover:text-muted-foreground transition-colors">
                {tech.benefit}
              </p>
            </div>
          </Card>
        ))}
      </div>

      <!-- Why This Stack Section -->
      <div class="mt-12 mx-auto max-w-4xl">
        <div class="text-center mb-8">
          <h3 class="text-2xl font-bold text-foreground mb-4">
            <span aria-hidden="true" class="mr-1.5">🤔</span> Why This Stack?
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <Card class="p-6">
            <h4 class="font-semibold text-foreground mb-3 flex items-center gap-2">
              <span aria-hidden="true">⚡</span> Performance First
            </h4>
            <p class="text-sm text-muted-foreground leading-relaxed">
              {stackRationale.performance}
            </p>
          </Card>

          <Card class="p-6">
            <h4 class="font-semibold text-foreground mb-3 flex items-center gap-2">
              <span aria-hidden="true">🎯</span> Developer Experience
            </h4>
            <p class="text-sm text-muted-foreground leading-relaxed">
              {stackRationale.developerExperience}
            </p>
          </Card>

          <Card class="p-6">
            <h4 class="font-semibold text-foreground mb-3 flex items-center gap-2">
              <span aria-hidden="true">🏭</span> Production Ready
            </h4>
            <p class="text-sm text-muted-foreground leading-relaxed">
              {stackRationale.productionReady}
            </p>
          </Card>

          <Card class="p-6">
            <h4 class="font-semibold text-foreground mb-3 flex items-center gap-2">
              <span aria-hidden="true">🔮</span> Future Proof
            </h4>
            <p class="text-sm text-muted-foreground leading-relaxed">
              {stackRationale.futureProof}
            </p>
          </Card>
        </div>
      </div>
    </Container>
  </Section>

  <!-- CTA Section -->
  <Section ariaLabel="Call to action section" class="relative bg-linear-to-br from-primary-600 to-secondary-600">
    <Container>
      <div class="mx-auto max-w-2xl text-center">
        <h2 class="text-3xl font-bold text-primary-foreground text-balance">
          Clone it. Own it. Ship it.
        </h2>
        <p class="mt-4 text-lg text-primary-foreground">
          One clone. Astro 6, Tailwind v4, and a layered AI constitution with halt-on-violation gates — ready to go.
        </p>

        <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row sm:gap-6">
          <Button href={siteLinks.github} variant="primary" size="lg" rel="noopener noreferrer" target="_blank">
            <Icon name="github" class="size-5 mr-2" decorative />
            Clone the Template
          </Button>
          {siteLinks.docs && (
          <Button href={`${siteLinks.docs}/getting-started/`} variant="secondary" size="lg" data-astro-prefetch>
            Get Started Now →
          </Button>
          )}
        </div>

        <div class="mt-8 text-sm text-primary-foreground">
          <span aria-hidden="true">🔒</span> MIT Licensed <span aria-hidden="true">•</span> <span aria-hidden="true">⚡</span> Astro 6 + Tailwind v4 <span aria-hidden="true">•</span> <span aria-hidden="true">🤖</span> Agentic Discipline
        </div>
      </div>
    </Container>
  </Section>

  <!-- Latest Posts -->
  {latestPostsWithMetadata.length > 0 && (
    <Section id="latest-posts" ariaLabel="Latest blog posts section" class="relative">
      <SectionSeparator />
      <Container>
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl text-balance">
            From the Blog
          </h2>
          <p class="mt-4 text-lg text-muted-foreground">
            Latest thoughts on Astro, performance, and modern web development.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {latestPostsWithMetadata.map((post) => (
            <PostCard post={post} />
          ))}
        </div>

        <div class="mt-10 text-center">
          <Button href={withBase("/blog/")} variant="secondary">
            View all posts →
          </Button>
        </div>
      </Container>
    </Section>
  )}
</BaseLayout>
