---
import type { CollectionEntry } from "astro:content";
import { getCollection, getEntry } from "astro:content";

import Badge from "@/components/atoms/Badge.astro";
import Button from "@/components/atoms/Button.astro";
import Image from "@/components/atoms/Image.astro";
import SocialLink from "@/components/atoms/SocialLink.astro";
import { socialLinks as configSocialLinks } from "@/config";
import avatarImage from "@/images/avatar-placeholder.png";
import BaseLayout from "@/layouts/BaseLayout.astro";

// Fetch bio data from content collection
const bioEntry = await getEntry("bio", "default");
const bioData = bioEntry?.data;
const displayName = bioData?.name ?? "Your Name";
const displayTitle = bioData?.title ?? "Developer";

// Fetch and sort experience entries from content collection
const allExperiences: CollectionEntry<"experience">[] = await getCollection("experience");
const sortedExperiences = allExperiences.sort((a, b) => a.data.order - b.data.order);

// Typed alias for bio skills to avoid implicit-any in JSX map callbacks
type SkillGroup = { category: string; items: string[] };
const bioSkills: SkillGroup[] = bioData?.skills ?? [];

// Format date range for experience entries
function formatPeriod(startDate: Date, endDate?: Date, current?: boolean): string {
  const start = startDate.getFullYear();
  if (current) {
    return `${start} - Present`;
  }
  const end = endDate?.getFullYear() ?? "Present";
  return `${start} - ${end}`;
}
---

<BaseLayout
  title="About"
  description={`Learn about ${displayName}'s journey as a developer, skills, and experience building modern web applications.`}
  image="/og-about.svg"
>
  <div>
    <!-- Hero Section -->
    <section class="bg-linear-to-br from-primary-100 to-secondary-100 pt-16 pb-8 sm:pt-24 sm:pb-12">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <div class="mb-8">
            <Image
              src={avatarImage}
              alt="Profile photo"
              class="mx-auto h-32 w-32 rounded-full object-cover shadow-lg ring-4 ring-background-primary"
              width={128}
              height={128}
              loading="eager"
            />
          </div>
          <h1 class="text-4xl font-bold tracking-tight text-foreground-primary sm:text-6xl">
            Hi, I'm {displayName}
          </h1>
          <p class="mt-6 text-lg leading-8 text-foreground-secondary">
            {displayTitle}. I build fast, accessible websites using modern tooling — zero JavaScript by default, interactivity only where it matters.
          </p>
        </div>
      </div>
    </section>

    <!-- Bio Section -->
    <section class="pt-16 sm:pt-12">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl">
          <h2 class="text-3xl font-bold tracking-tight text-foreground-primary sm:text-4xl mb-8">
            My Story
          </h2>
          <div class="prose prose-lg max-w-none">
            <!-- CUSTOMIZE: Replace these paragraphs with your own story. -->
            <p class="leading-relaxed mb-6">
              I'm a developer focused on performance-first web architecture.
              I believe the best websites ship zero JavaScript by default and
              add interactivity only where it genuinely improves the user experience.
            </p>
            <p class="leading-relaxed mb-6">
              Over the years, I've worked across the stack — from design systems
              and component libraries to CI/CD pipelines and deployment infrastructure.
              I'm particularly passionate about accessibility, automated testing,
              and developer tooling that makes teams faster.
            </p>
            <p class="leading-relaxed">
              This portfolio was built with the Astro Performance Starter, a template
              designed to deliver 95+ Lighthouse scores out of the box. It ships with
              working AI development workflows, a semantic design token system, and
              automated quality gates.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    {bioSkills.length > 0 && (
    <section class="bg-background-secondary py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-foreground-primary sm:text-4xl mb-4">
            Skills & Technologies
          </h2>
          <p class="text-lg leading-8 text-foreground-secondary mb-12">
            Technologies I work with to build modern web applications
          </p>
        </div>
        <div class="mx-auto max-w-4xl">
          <div class="space-y-8">
            {bioSkills.map((skillGroup: SkillGroup) => (
              <div>
                <h3 class="text-sm font-semibold text-foreground-secondary uppercase tracking-wider mb-3 text-center">
                  {skillGroup.category}
                </h3>
                <ul class="flex flex-wrap justify-center gap-3" role="list" aria-label={`${skillGroup.category} skills`}>
                  {skillGroup.items.map((skill: string) => (
                    <li class="transition-transform duration-200 hover:scale-105">
                      <Badge variant="primary" size="sm">
                        {skill}
                      </Badge>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
    )}

    <!-- Experience Section -->
    {sortedExperiences.length > 0 && (
    <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl">
          <h2 class="text-3xl font-bold tracking-tight text-foreground-primary sm:text-4xl mb-12">
            Experience
          </h2>
          <ol class="space-y-8" role="list" aria-label="Work experience timeline">
            {sortedExperiences.map((exp: CollectionEntry<"experience">) => (
              <li class="relative pl-8 pb-8 border-l-2 border-border-primary last:border-l-0 last:pb-0">
                <div class="absolute -left-2 top-0 h-4 w-4 rounded-full bg-primary-600 ring-4 ring-background-primary" aria-hidden="true"></div>
                <article>
                  <div class="space-y-2">
                    <h3 class="text-xl font-semibold text-foreground-primary">
                      {exp.data.title}
                    </h3>
                    <div class="flex flex-col sm:flex-row sm:items-center sm:gap-4">
                      <p class="text-primary-600 font-medium">
                        {exp.data.company}
                      </p>
                      <p class="text-sm text-foreground-secondary">
                        {formatPeriod(exp.data.startDate, exp.data.endDate, exp.data.current)}
                      </p>
                      {exp.data.location && (
                      <p class="text-sm text-foreground-subtle">
                        {exp.data.location}
                      </p>
                      )}
                    </div>
                    <p class="text-foreground-secondary leading-relaxed">
                      {exp.data.description}
                    </p>
                    {exp.data.technologies && exp.data.technologies.length > 0 && (
                    <div class="pt-2">
                      <ul class="flex flex-wrap gap-2" role="list" aria-label={`Technologies used at ${exp.data.company}`}>
                        {exp.data.technologies.map((tech: string) => (
                          <li>
                            <Badge variant="neutral" size="xs">
                              {tech}
                            </Badge>
                          </li>
                        ))}
                      </ul>
                    </div>
                    )}
                  </div>
                </article>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
    )}

    <!-- Social Links Section -->
    <section class="bg-background-secondary py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-foreground-primary sm:text-4xl mb-4">
            Let's Connect
          </h2>
          <p class="text-lg leading-8 text-foreground-secondary mb-8">
            Find me on these platforms or reach out directly
          </p>
          <div class="flex justify-center gap-6">
            {configSocialLinks.github && (
            <SocialLink
              platform="github"
              href={configSocialLinks.github}
              class="text-lg"
            />
            )}
            {configSocialLinks.linkedin && (
            <SocialLink
              platform="linkedin"
              href={configSocialLinks.linkedin}
              class="text-lg"
            />
            )}
            {configSocialLinks.twitter && (
            <SocialLink
              platform="twitter"
              href={configSocialLinks.twitter}
              class="text-lg"
            />
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action Section -->
    <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-foreground-primary sm:text-4xl mb-4">
            Ready to Work Together?
          </h2>
          <p class="text-lg leading-8 text-foreground-secondary mb-8">
            I'm always interested in new opportunities and exciting projects.
            Let's discuss how we can bring your ideas to life.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <Button
              href="/contact"
              variant="primary"
              size="lg"
              class="inline-flex items-center"
              data-astro-prefetch
            >
              Get In Touch
            </Button>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
