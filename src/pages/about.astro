---
import { type CollectionEntry, getCollection, getEntry, render } from "astro:content";
import AnimatedGradientText from "@/components/atoms/AnimatedGradientText.astro";
import Badge from "@/components/atoms/Badge.astro";
import Button from "@/components/atoms/Button.astro";
import ScrollReveal from "@/components/atoms/ScrollReveal.astro";
import SocialLink from "@/components/atoms/SocialLink.astro";
import { socialLinks as configSocialLinks } from "@/config";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/utils/url-utils";

// Bio + experience are sourced from content collections so the About page is
// content-driven, not hardcoded. See ADR-054 (demo persona).
const bio = await getEntry("bio", "default");
if (!bio) {
  throw new Error("Missing bio entry: src/content/bio/default.mdx");
}
// biome-ignore lint/style/useNamingConvention: render() returns Content; PascalCase required to use as JSX tag
const { Content: BioContent } = await render(bio);

type ExperienceEntry = CollectionEntry<"experience">;
const experienceEntries = await getCollection("experience");
const experiences = experienceEntries.sort(
  (a: ExperienceEntry, b: ExperienceEntry) => a.data.order - b.data.order,
);

interface SkillGroup {
  category: string;
  items: string[];
}
const skillGroups: SkillGroup[] = (bio.data.skills ?? []) as SkillGroup[];

const formatPeriod = (start: Date, end: Date | undefined, current: boolean) => {
  const startYear = start.getFullYear();
  if (current) {
    return `${startYear} – Present`;
  }
  const endYear = end ? end.getFullYear() : startYear;
  return `${startYear} – ${endYear}`;
};
---

<BaseLayout
  title="About"
  description="Learn about my journey as a full-stack developer, my skills, and experience building modern web applications."
  image="/og-about.png"
>
  <div>
    <!-- Hero Section -->
    <section class="pt-16 pb-8 sm:pt-24 sm:pb-12">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <div class="mb-8">
            {/* Native <img> bypasses Astro's image pipeline so the embedded
                cursor-blink CSS animation in state-idle.svg survives unchanged.
                The SVG paints its own slate-950 background; rounded-full on the
                <img> clips to a disc. */}
            <img
              src={bio.data.avatar.src}
              alt={`${bio.data.name} — ${bio.data.title}`}
              class="mx-auto h-32 w-32 rounded-full shadow-lg ring-4 ring-background"
              width={128}
              height={128}
              loading="eager"
              decoding="async"
            />
          </div>
          <ScrollReveal>
            <h1 transition:name="hero-heading" class="text-4xl font-bold tracking-tight text-foreground sm:text-6xl">
              Hi, I'm <AnimatedGradientText as="span" morph>{bio.data.name}</AnimatedGradientText>
            </h1>
            <p class="mt-6 text-lg leading-8 text-muted-foreground">
              {bio.data.title}{bio.data.location ? ` · ${bio.data.location}` : ""}
            </p>
          </ScrollReveal>
        </div>
      </div>
    </section>

    <!-- Bio Section -->
    <section class="pt-16 pb-16 sm:pt-12 sm:pb-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl">
          <div class="prose prose-lg max-w-none prose-headings:text-foreground prose-p:text-muted-foreground">
            <BioContent />
          </div>
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section class="bg-surface py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-4">
            Skills & Technologies
          </h2>
          <p class="text-lg leading-8 text-muted-foreground mb-12">
            Technologies I work with to build modern web applications
          </p>
        </div>
        <div class="mx-auto max-w-4xl flex flex-col gap-8">
          {skillGroups.map((group: SkillGroup) => (
            <div>
              <h3 class="text-sm font-semibold uppercase tracking-wider text-muted-foreground mb-3 text-center">
                {group.category}
              </h3>
              <ul class="flex flex-wrap justify-center gap-3" role="list" aria-label={`${group.category} skills`}>
                {group.items.map((skill: string) => (
                  <li class="transition-transform duration-200 hover:scale-105">
                    <Badge variant="primary" size="sm">
                      {skill}
                    </Badge>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Experience Section -->
    <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl">
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-12">
            Experience
          </h2>
          <ol class="space-y-8" role="list" aria-label="Work experience timeline">
            {experiences.map((exp: ExperienceEntry) => (
              <li class="relative pl-8 pb-8 border-l-2 border-border last:border-l-0 last:pb-0">
                <div class="absolute -left-2 top-0 h-4 w-4 rounded-full bg-primary-600 ring-4 ring-background" aria-hidden="true"></div>
                <article>
                  <div class="space-y-2">
                    <h3 class="text-xl font-semibold text-foreground">
                      {exp.data.title}
                    </h3>
                    <div class="flex flex-col sm:flex-row sm:items-center sm:gap-4">
                      <p class="text-link font-medium">
                        {exp.data.company}
                      </p>
                      <p class="text-sm text-muted-foreground">
                        <time>{formatPeriod(exp.data.startDate, exp.data.endDate, exp.data.current)}</time>
                      </p>
                    </div>
                    <p class="text-muted-foreground leading-relaxed">
                      {exp.data.description}
                    </p>
                  </div>
                </article>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <!-- Social Links Section -->
    <section class="bg-surface py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-4">
            Let's Connect
          </h2>
          <p class="text-lg leading-8 text-muted-foreground mb-8">
            Find me on these platforms or reach out directly
          </p>
          <div class="flex justify-center gap-6">
            {configSocialLinks.github && (
            <SocialLink 
              platform="github" 
              href={configSocialLinks.github}
              class="text-lg"
            />
            )}
            {configSocialLinks.linkedin && (
            <SocialLink 
              platform="linkedin" 
              href={configSocialLinks.linkedin}
              class="text-lg"
            />
            )}
            {configSocialLinks.twitter && (
            <SocialLink
              platform="twitter"
              href={configSocialLinks.twitter}
              class="text-lg"
            />
            )}
          </div>
          {bio.data.social?.email && (
            <div class="mt-8">
              <Button
                href={`mailto:${bio.data.social.email}`}
                variant="primary"
                size="lg"
                class="inline-flex items-center"
              >
                Email Me Directly
              </Button>
            </div>
          )}
        </div>
      </div>
    </section>

    <!-- Call to Action Section -->
    <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center">
          <h2 class="text-3xl font-bold tracking-tight text-foreground sm:text-4xl mb-4">
            Ready to Work Together?
          </h2>
          <p class="text-lg leading-8 text-muted-foreground mb-8">
            I'm always interested in new opportunities and exciting projects. 
            Let's discuss how we can bring your ideas to life.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <Button
              href={withBase("/contact/")}
              variant="primary"
              size="lg"
              class="inline-flex items-center"
              data-astro-prefetch
            >
              Get In Touch
            </Button>
            <Button
              variant="secondary"
              size="lg"
              class="inline-flex items-center opacity-50 cursor-not-allowed"
              disabled
              aria-disabled="true"
              title="Resume coming soon"
            >
              Download Resume
            </Button>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
