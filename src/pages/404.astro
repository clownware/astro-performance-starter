---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="404 - Page Not Found"
  description="The page you're looking for doesn't exist."
  noindex={true}
>
  <div class="container flex min-h-[60vh] flex-col items-center justify-center text-center">
    <h1 class="mb-4 text-6xl font-bold">404</h1>
    <p class="mb-8 text-xl text-foreground/60">
      Oops! The page you're looking for doesn't exist.
    </p>
    <a
      href="/"
      class="rounded-lg bg-primary px-6 py-3 text-primary-foreground hover:bg-primary/90 focus-visible:ring-2 focus-visible:ring-ring"
    >
      Go Home
    </a>
  </div>
</BaseLayout>
