---
import Badge from "@/components/atoms/Badge.astro";
import Button from "@/components/atoms/Button.astro";
import SocialLink from "@/components/atoms/SocialLink.astro";
import Card from "@/components/molecules/Card.astro";
import ContactForm from "@/components/molecules/ContactForm.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/utils/url-utils";

// Contact information from environment variables
const contactEmail = import.meta.env.PUBLIC_CONTACT_EMAIL || "hello@example.com";
const contactPhone = import.meta.env.PUBLIC_CONTACT_PHONE || "+1234567890";
const contactPhoneDisplay = import.meta.env.PUBLIC_CONTACT_PHONE_DISPLAY || "+1 (234) 567-890";
const contactLocation = import.meta.env.PUBLIC_CONTACT_LOCATION || "San Francisco, CA";
const contactTimezone = import.meta.env.PUBLIC_CONTACT_TIMEZONE || "Mon-Fri, 9AM-6PM PST";
const contactChatHours = import.meta.env.PUBLIC_CONTACT_CHAT_HOURS || "Mon-Fri, 9AM-5PM EST";

// Social media links from environment variables
const socialGithub = import.meta.env.PUBLIC_SOCIAL_GITHUB || "https://github.com/example";
const socialLinkedIn =
  import.meta.env.PUBLIC_SOCIAL_LINKEDIN || "https://linkedin.com/company/example";
const socialTwitter = import.meta.env.PUBLIC_SOCIAL_TWITTER || "https://twitter.com/example";

// Declarative contact methods data structure
interface ContactMethod {
  icon: string;
  iconLabel: string;
  title: string;
  description: string;
  action?: {
    href: string;
    label: string;
  };
  badge?: {
    text: string;
    role: "status" | "presentation";
    additionalInfo?: string;
  };
}

const contactMethods: ContactMethod[] = [
  {
    icon: "📧",
    iconLabel: "Email icon",
    title: "Email",
    description: "For detailed inquiries or project discussions",
    action: {
      href: `mailto:${contactEmail}`,
      label: contactEmail,
    },
  },
  {
    icon: "💬",
    iconLabel: "Chat icon",
    title: "Live Chat",
    description: "Quick questions? Chat with us in real-time",
    badge: {
      text: "Online now",
      role: "status",
      additionalInfo: contactChatHours,
    },
  },
  {
    icon: "📞",
    iconLabel: "Phone icon",
    title: "Phone",
    description: "Prefer to talk? Schedule a call with our team",
    action: {
      href: `tel:${contactPhone}`,
      label: contactPhoneDisplay,
    },
  },
];

// Location and availability data structure
interface LocationInfo {
  icon: string;
  iconLabel: string;
  text: string;
  badge: string;
}

const locationInfo: LocationInfo[] = [
  {
    icon: "📍",
    iconLabel: "Location pin",
    text: contactLocation,
    badge: "Remote-friendly",
  },
  {
    icon: "🕒",
    iconLabel: "Clock",
    text: contactTimezone,
    badge: "Quick response",
  },
  {
    icon: "🌍",
    iconLabel: "Globe",
    text: "Serving clients worldwide",
    badge: "Global reach",
  },
];

// Response expectations data structure
interface ResponseExpectation {
  icon: string;
  iconLabel: string;
  bgClass: string;
  title: string;
  description: string;
}

const responseExpectations: ResponseExpectation[] = [
  {
    icon: "⚡",
    iconLabel: "Lightning bolt",
    bgClass: "bg-surface",
    title: "Quick Response",
    description: "We'll acknowledge your message within 2 hours during business hours",
  },
  {
    icon: "🎯",
    iconLabel: "Target",
    bgClass: "bg-secondary-100 dark:bg-secondary-900",
    title: "Detailed Follow-up",
    description: "Within 24 hours, we'll provide a comprehensive response to your inquiry",
  },
  {
    icon: "🤝",
    iconLabel: "Handshake",
    bgClass: "bg-primary-100 dark:bg-primary-900",
    title: "Next Steps",
    description: "We'll schedule a call or meeting to discuss your project in detail",
  },
];
---

<BaseLayout
  title="Contact Us"
  description="Get in touch with our team. We'd love to hear from you and discuss your project needs."
>
  <div>
    <!-- Hero Section -->
    <section class="bg-linear-to-br from-primary-50 to-secondary-50 dark:from-primary-950 dark:to-secondary-950 py-16">
      <div class="container mx-auto px-4">
        <div class="max-w-3xl mx-auto text-center">
          <h1 class="text-4xl md:text-5xl font-bold text-foreground mb-6">
            Let's Start a Conversation
          </h1>
          <p class="text-xl text-muted-foreground mb-8 leading-relaxed">
            Whether you have a question, want to discuss a project, or just want to say hello, 
            we're here to help. Choose the method that works best for you.
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            <Badge role="presentation">Available for new projects</Badge>
            <Badge role="presentation">Remote-friendly</Badge>
            <Badge role="presentation">Quick response time</Badge>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Content -->
    <section class="py-16 mt-8">
      <div class="container mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-12 max-w-6xl mx-auto">
          
          <!-- Contact Form Section -->
          <div class="space-y-8">
            <div class="text-center lg:text-left">
              <h2 class="text-3xl font-bold text-foreground mb-4">
                Send us a message
              </h2>
              <p class="text-muted-foreground mb-6">
                Fill out the form below and we'll get back to you within 24 hours.
              </p>
            </div>
            
            <!-- Primary Component Showcase: ContactForm -->
            <!--
              `action` resolves to "<BASE>/contact" so the path respects the
              deployment base (e.g. /astro-performance-starter on GitHub Pages
              sub-path deploys). The form ships with `data-static-form-name`
              for static-form services (Netlify Forms, Formspree, etc.). Static
              deploys (GitHub Pages, Cloudflare Pages without Functions) need a
              third-party form backend or this will POST to a 404. Configure
              your service of choice and update the action prop accordingly.
            -->
            <ContactForm action={withBase("/contact")} />
            
            <div class="text-sm text-muted-foreground text-center lg:text-left">
              <p>
                By submitting this form, you agree to our privacy policy. 
                We'll never share your information with third parties.
              </p>
            </div>
          </div>

          <!-- Alternative Contact Methods -->
          <div class="space-y-8">
            <div class="text-center lg:text-left">
              <h2 class="text-3xl font-bold text-foreground mb-4">
                Other ways to reach us
              </h2>
              <p class="text-muted-foreground mb-6">
                Prefer a different communication method? We've got you covered.
              </p>
            </div>

            <!-- Contact Methods using Card components with declarative mapping -->
            <div class="space-y-6">
              {contactMethods.map((method) => (
                <Card class="p-6">
                  <div class="flex items-start space-x-4">
                    <div class="shrink-0 w-12 h-12 bg-primary-100 dark:bg-primary-900 rounded-lg flex items-center justify-center">
                      <span class="text-2xl" aria-hidden="true">{method.icon}</span>
                    </div>
                    <div class="flex-1">
                      <h3 class="text-lg font-semibold text-foreground mb-2">{method.title}</h3>
                      <p class="text-muted-foreground mb-3">
                        {method.description}
                      </p>
                      {method.action && (
                        <Button 
                          href={method.action.href}
                          variant="secondary" 
                          size="sm"
                        >
                          {method.action.label}
                        </Button>
                      )}
                      {method.badge && (
                        <div class="flex items-center space-x-2">
                          <Badge role={method.badge.role}>{method.badge.text}</Badge>
                          {method.badge.additionalInfo && (
                            <span class="text-sm text-muted-foreground">
                              {method.badge.additionalInfo}
                            </span>
                          )}
                        </div>
                      )}
                    </div>
                  </div>
                </Card>
              ))}
            </div>

            <!-- Social Media Links -->
            <div class="pt-8 border-t border-border">
              <h3 class="text-xl font-semibold text-foreground mb-4">
                Follow us on social media
              </h3>
              <div class="flex space-x-4">
                <SocialLink 
                  platform="github" 
                  href={socialGithub}
                  showIcon={true}
                />
                <SocialLink 
                  platform="linkedin" 
                  href={socialLinkedIn}
                  showIcon={true}
                />
                <SocialLink 
                  platform="twitter" 
                  href={socialTwitter}
                  showIcon={true}
                />
              </div>
            </div>

            <!-- Location & Availability -->
            <div class="pt-8 border-t border-border">
              <h3 class="text-xl font-semibold text-foreground mb-4">
                Location & Availability
              </h3>
              <div class="space-y-4">
                {locationInfo.map((info) => (
                  <div class="flex items-center space-x-3">
                    <span class="text-muted-foreground" aria-hidden="true">{info.icon}</span>
                    <span class="text-foreground">{info.text}</span>
                    <Badge role="presentation">{info.badge}</Badge>
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Response Expectations -->
    <!-- Focus order: Grid flows naturally left-to-right, top-to-bottom for keyboard navigation -->
    <section class="py-16 bg-background-surface">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl font-bold text-foreground mb-8">
            What to expect after reaching out
          </h2>
          <div class="grid md:grid-cols-3 gap-8">
            {responseExpectations.map((expectation) => (
              <div class="space-y-4">
                <div class={`w-16 h-16 ${expectation.bgClass} rounded-full flex items-center justify-center mx-auto`}>
                  <span class="text-2xl" aria-hidden="true">{expectation.icon}</span>
                </div>
                <h3 class="text-xl font-semibold text-foreground">
                  {expectation.title}
                </h3>
                <p class="text-muted-foreground">
                  {expectation.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
