---
import { type CollectionEntry, getCollection } from "astro:content";
import Badge from "@/components/atoms/Badge.astro";
import Button from "@/components/atoms/Button.astro";
import ProjectCard from "@/components/molecules/ProjectCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

// Load project entries from content collection and sort by publishedDate (desc)
const entries = await getCollection(
  "projects",
  ({ data }: CollectionEntry<"projects">) => !data.draft,
);

// Project item shape used for UI rendering
interface ProjectItem {
  title: string;
  description: string;
  image: string;
  techStack: string[];
  demoUrl?: string;
  githubUrl?: string;
  href: string;
  date: Date;
  tags: string[];
}

// Transform to simple objects for UI
const projects: ProjectItem[] = entries
  .sort(
    (a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) =>
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .map((entry: CollectionEntry<"projects">) => ({
    title: entry.data.title,
    description: entry.data.description,
    image: entry.data.cardImage
      ? typeof entry.data.cardImage === "string"
        ? entry.data.cardImage
        : entry.data.cardImage.src
      : entry.data.cover
        ? typeof entry.data.cover === "string"
          ? entry.data.cover
          : entry.data.cover.src
        : "/logo.svg",
    techStack: entry.data.technologies ?? [],
    demoUrl: entry.data.externalUrl ?? undefined,
    githubUrl: entry.data.githubUrl ?? undefined,
    href: `/projects/${entry.slug}/`,
    date: entry.data.date,
    tags: entry.data.tags ?? [],
  }));

// Pagination configuration
const projectsPerPage = 6;
const hasMoreProjects = projects.length > projectsPerPage;
const displayedProjects = projects.slice(0, projectsPerPage);

// Extract unique tech stack items for filtering
const allTechStack = [
  ...new Set(projects.flatMap((project: ProjectItem) => project.techStack)),
].sort();

const pageTitle = "Projects";
const pageDescription =
  "Explore our portfolio of web development projects showcasing modern technologies and best practices.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image="/og-default.svg"
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Page Header -->
    <div class="mb-12 text-center">
      <h1 class="mb-4 text-4xl font-bold tracking-tight text-foreground-default sm:text-5xl">
        {pageTitle}
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-foreground-subtle">
        {pageDescription}
      </p>
    </div>

    <!-- Filter Controls -->
    <section class="mb-12" aria-labelledby="filter-heading">
      <h2 id="filter-heading" class="mb-4 text-center text-xl font-bold text-foreground-default">Filter by Technology</h2>
      <div class="flex flex-wrap justify-center gap-3">
        <Button 
          variant="ghost" 
          size="sm"
          class="filter-btn active"
          data-filter="all"
        >
          All Projects
        </Button>
        {allTechStack.map((tech) => (
          <Badge 
            class="cursor-pointer hover:bg-primary-200 dark:hover:bg-primary-800 transition-colors duration-200 filter-badge" 
            data-filter={tech.toLowerCase()}
            role="button"
            tabindex="0"
            aria-pressed="false"
          >
            {tech}
          </Badge>
        ))}
      </div>
    </section>

    <!-- Projects Grid -->
    <section class="text-center" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="mb-8 text-center text-2xl font-bold text-foreground-default">All Projects</h2>
      <div id="projects-grid" class="flex flex-wrap justify-center gap-8" aria-live="polite" aria-atomic="false">
        {displayedProjects.map((project) => (
          <ProjectCard
            class="w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.333rem)] project-card-item"
            title={project.title}
            description={project.description}
            image={project.image}
            techStack={project.techStack}
            demoUrl={project.demoUrl}
            githubUrl={project.githubUrl}
            href={project.href}
            date={project.date}
            tags={project.tags}
            data-tech-stack={project.techStack.map((tech) => tech.toLowerCase()).join(' ')}
          />
        ))}
      </div>
    </section>

    <!-- Empty State (hidden by default, shown when no projects match filter) -->
    <div id="empty-state" class="hidden text-center py-12">
      <div class="text-6xl mb-4" aria-hidden="true">🔍</div>
      <h3 class="text-xl font-semibold text-foreground-primary mb-2">
        No projects found
      </h3>
      <p class="text-foreground-secondary mb-6">
        Try selecting a different technology filter or view all projects.
      </p>
      <Button 
        variant="primary" 
        size="md"
        class="reset-filter-btn"
      >
        Show All Projects
      </Button>
    </div>

    <!-- Load More Section (only shown when there are more projects) -->
    {hasMoreProjects && (
      <section class="text-center mt-12" id="load-more-section">
        <p class="text-foreground-secondary mb-6">
          Showing <span id="shown-count">{displayedProjects.length}</span> of {projects.length} projects
        </p>
        <Button 
          variant="secondary" 
          size="lg"
          class="inline-flex items-center load-more-btn"
        >
          <span class="mr-2" aria-hidden="true">📂</span>
          Load More Projects
        </Button>
      </section>
    )}
    
    <!-- Hidden projects data for client-side loading -->
    {hasMoreProjects && (
      <script type="application/json" id="remaining-projects" is:inline set:html={JSON.stringify(projects.slice(projectsPerPage))} />
    )}
  </div>
</BaseLayout>

<script lang="js" is:inline>
  // Client-side filtering and load more functionality
  document.addEventListener('DOMContentLoaded', () => {
    const filterButtons = document.querySelectorAll('.filter-btn');
    const filterBadges = document.querySelectorAll('.filter-badge');
    const projectCards = document.querySelectorAll('[data-tech-stack]');
    const emptyState = document.getElementById('empty-state');
    const resetButton = document.querySelector('.reset-filter-btn');
    const loadMoreBtn = document.querySelector('.load-more-btn');
    const projectsGrid = document.getElementById('projects-grid');
    const shownCount = document.getElementById('shown-count');
    const loadMoreSection = document.getElementById('load-more-section');

    // Load more functionality
    if (loadMoreBtn) {
      loadMoreBtn.addEventListener('click', () => {
        const remainingProjectsScript = document.getElementById('remaining-projects');
        if (!remainingProjectsScript) return;

        const remainingProjects = JSON.parse(remainingProjectsScript.textContent);
        
        // Create project card HTML for remaining projects
        remainingProjects.forEach((project) => {
          const cardWrapper = document.createElement('a');
          cardWrapper.href = project.href;
          cardWrapper.className = 'block w-full focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500 rounded-lg transition-shadow duration-300 hover:shadow-lg w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.333rem)] project-card-item';
          
          const techStackAttr = project.techStack.map(t => t.toLowerCase()).join(' ');
          cardWrapper.setAttribute('data-tech-stack', techStackAttr);
          
          // Simplified card HTML (matches ProjectCard structure)
          cardWrapper.innerHTML = `
            <article class="w-full project-card bg-background-secondary border border-primary rounded-lg overflow-hidden transition-all duration-300 hover:shadow-lg hover:border-primary-300 focus-within:ring-2 focus-within:ring-primary-500">
              <div class="project-card__image-container relative overflow-hidden">
                <img src="${project.image}" alt="Screenshot of ${project.title} project" class="project-card__image w-full h-48 object-cover transition-transform duration-300 hover:scale-105" loading="lazy" decoding="async" />
              </div>
              <div class="project-card__content p-6">
                <header class="project-card__header mb-4">
                  <h3 class="project-card__title text-xl font-semibold text-foreground-primary mb-2">${project.title}</h3>
                  <p class="project-card__description text-foreground-secondary leading-relaxed">${project.description}</p>
                </header>
                ${project.tags && project.tags.length > 0 ? `
                  <div class="project-card__tags mb-4">
                    <div class="flex items-center gap-2 mb-2">
                      <span class="text-xs font-medium text-foreground-secondary uppercase tracking-wide">Categories</span>
                    </div>
                    <ul class="flex flex-wrap gap-2" role="list">
                      ${project.tags.map(tag => `<li><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary-100 text-primary-800">${tag}</span></li>`).join('')}
                    </ul>
                  </div>
                ` : ''}
                <div class="project-card__tech-stack mb-6">
                  <div class="flex items-center gap-2 mb-2">
                    <span class="text-xs font-medium text-foreground-secondary uppercase tracking-wide">Technologies</span>
                  </div>
                  <ul class="flex flex-wrap gap-2" role="list">
                    ${project.techStack.map(tech => `<li><span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-secondary-100 text-secondary-800">${tech}</span></li>`).join('')}
                  </ul>
                </div>
              </div>
            </article>
          `;
          
          projectsGrid.appendChild(cardWrapper);
        });

        // Update count and hide load more button
        if (shownCount) {
          const totalCards = document.querySelectorAll('.project-card-item').length;
          shownCount.textContent = totalCards;
        }
        if (loadMoreSection) {
          loadMoreSection.style.display = 'none';
        }
      });
    }

    // Filter functionality
    const filterProjects = (filterValue) => {
      let visibleCount = 0;
      const allCards = document.querySelectorAll('[data-tech-stack]');

      allCards.forEach((card) => {
        const techStack = card.getAttribute('data-tech-stack') || '';
        const shouldShow = filterValue === 'all' || techStack.includes(filterValue);
        card.style.display = shouldShow ? 'block' : 'none';
        if (shouldShow) visibleCount++;
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount !== 0);
      }

      filterButtons.forEach((btn) => btn.classList.remove('active'));
      filterBadges.forEach((badge) => {
        badge.classList.remove('active');
        badge.setAttribute('aria-pressed', 'false');
      });
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filterValue = button.getAttribute('data-filter') ?? 'all';
        filterProjects(filterValue);
        button.classList.add('active');
      });
    });

    filterBadges.forEach((badge) => {
      // Click handler
      const handleActivate = () => {
        const filterValue = badge.getAttribute('data-filter') ?? 'all';
        filterProjects(filterValue);
        badge.classList.add('active');
        badge.setAttribute('aria-pressed', 'true');
      };

      badge.addEventListener('click', handleActivate);
      
      // Keyboard handler (Enter or Space)
      badge.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          handleActivate();
        }
      });
    });

    resetButton?.addEventListener('click', () => {
      filterProjects('all');
      filterButtons.forEach((btn) => {
        if (btn.getAttribute('data-filter') === 'all') {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
    });
  });
</script>

<style>
  .filter-btn.active {
    @apply bg-primary-600 text-white;
  }
  .filter-btn:focus-visible {
    @apply ring-2 ring-primary-500 ring-offset-2;
  }
  .filter-badge.active {
    @apply bg-primary-600 text-white;
  }
  .filter-badge:focus-visible {
    @apply ring-2 ring-primary-500 ring-offset-2 outline-none;
  }
  [data-tech-stack] {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  [data-tech-stack][style*="display: none"] {
    opacity: 0;
    transform: scale(0.95);
  }
</style>
