---
import { type CollectionEntry, getCollection } from "astro:content";
import type { ImageMetadata } from "astro";
import Button from "@/components/atoms/Button.astro";
import ProjectCard from "@/components/molecules/ProjectCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { withBase } from "@/utils/url-utils";

// Load project entries from content collection and sort by publishedDate (desc)
const entries = await getCollection(
  "projects",
  ({ data }: CollectionEntry<"projects">) => !data.draft,
);

// Project item shape used for UI rendering
interface ProjectItem {
  title: string;
  description: string;
  image: ImageMetadata | string;
  techStack: string[];
  demoUrl?: string;
  githubUrl?: string;
  href: string;
  date: Date;
  tags: string[];
}

/**
 * Helper function to resolve project image
 * Returns ImageMetadata when available (enables astro:assets optimization),
 * falls back to string path for external URLs or missing images.
 */
function getProjectImage(entry: CollectionEntry<"projects">): ImageMetadata | string {
  // Try cardImage first (preferred for cards)
  if (entry.data.cardImage) {
    return entry.data.cardImage;
  }

  // Fall back to cover image
  if (entry.data.cover) {
    return entry.data.cover;
  }

  // Default fallback
  return withBase("/logo.svg");
}

// Transform to simple objects for UI
const projects: ProjectItem[] = entries
  .sort(
    (a: CollectionEntry<"projects">, b: CollectionEntry<"projects">) =>
      new Date(b.data.date).getTime() - new Date(a.data.date).getTime(),
  )
  .map((entry: CollectionEntry<"projects">) => ({
    title: entry.data.title,
    description: entry.data.description,
    image: getProjectImage(entry),
    techStack: entry.data.technologies ?? [],
    demoUrl: entry.data.externalUrl ?? undefined,
    githubUrl: entry.data.githubUrl ?? undefined,
    href: withBase(`/projects/${entry.id}/`),
    date: entry.data.date,
    tags: entry.data.tags ?? [],
  }));

/**
 * Pagination configuration
 * Shows first 6 projects on initial load, with "Load More" for remaining.
 *
 * NOTE: If project count exceeds 20, consider switching to Astro's built-in
 * paginate() for server-side pagination with URL-based pages.
 * See ADR-015 for pagination strategy details.
 */
const projectsPerPage = 6;
const hasMoreProjects = projects.length > projectsPerPage;
const displayedProjects = projects.slice(0, projectsPerPage);

// Extract unique tech stack items for filtering
const allTechStack = [
  ...new Set(projects.flatMap((project: ProjectItem) => project.techStack)),
].sort();

const pageTitle = "Projects";
const pageDescription =
  "Explore our portfolio of web development projects showcasing modern technologies and best practices.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  image="/og-default.png"
>
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Page Header -->
    <div class="mb-12 text-center">
      <h1 class="mb-4 text-4xl font-bold tracking-tight text-foreground-default sm:text-5xl">
        {pageTitle}
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-muted-foreground">
        {pageDescription}
      </p>
    </div>

    <!-- Filter Controls -->
    <section class="mb-12" aria-labelledby="filter-heading">
      <h2 id="filter-heading" class="mb-4 text-center text-xl font-bold text-foreground-default">Filter by Technology</h2>
      <div class="flex flex-wrap justify-center gap-3">
        <button
          type="button"
          class="filter-btn active inline-flex items-center px-3 py-1.5 rounded-md text-sm font-medium border border-border bg-surface text-foreground transition-colors duration-200 hover:bg-primary-200 dark:hover:bg-primary-800 cursor-pointer"
          data-filter="all"
          aria-pressed="true"
        >
          All Projects
        </button>
        {allTechStack.map((tech) => (
          <button
            type="button"
            class="filter-badge inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-200 cursor-pointer hover:bg-primary-200 dark:hover:bg-primary-800 transition-colors duration-200"
            data-filter={tech.toLowerCase()}
            aria-pressed="false"
          >
            {tech}
          </button>
        ))}
      </div>
    </section>

    <!-- Projects Grid -->
    <section class="text-center" aria-labelledby="projects-heading">
      <h2 id="projects-heading" class="mb-8 text-center text-2xl font-bold text-foreground-default">All Projects</h2>
      <div id="projects-grid" class="flex flex-wrap justify-center gap-8" aria-live="polite" aria-atomic="false">
        {displayedProjects.map((project) => (
          <ProjectCard
            class="w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.333rem)] project-card-item"
            title={project.title}
            description={project.description}
            image={project.image}
            techStack={project.techStack}
            demoUrl={project.demoUrl}
            githubUrl={project.githubUrl}
            href={project.href}
            date={project.date}
            tags={project.tags}
            data-tech-stack={project.techStack.map((tech) => tech.toLowerCase()).join(' ')}
          />
        ))}
      </div>
    </section>

    <!-- Empty State (hidden by default, shown when no projects match filter) -->
    <div id="empty-state" class="hidden text-center py-12">
      <div class="text-6xl mb-4" aria-hidden="true">🔍</div>
      <h3 class="text-xl font-semibold text-foreground mb-2">
        No projects found
      </h3>
      <p class="text-muted-foreground mb-6">
        Try selecting a different technology filter or view all projects.
      </p>
      <Button 
        variant="primary" 
        size="md"
        class="reset-filter-btn"
      >
        Show All Projects
      </Button>
    </div>

    <!-- Load More Section (only shown when there are more projects) -->
    {hasMoreProjects && (
      <section class="text-center mt-12" id="load-more-section">
        <p class="text-muted-foreground mb-6">
          Showing <span id="shown-count">{displayedProjects.length}</span> of {projects.length} projects
        </p>
        <Button 
          variant="secondary" 
          size="lg"
          class="inline-flex items-center load-more-btn"
        >
          <span class="mr-2" aria-hidden="true">📂</span>
          Load More Projects
        </Button>
      </section>
    )}
    
    <!-- Hidden projects data for client-side loading -->
    {hasMoreProjects && (
      <script type="application/json" id="remaining-projects" is:inline set:html={JSON.stringify(
        projects.slice(projectsPerPage).map(p => ({
          ...p,
          image: typeof p.image === "string" ? p.image : p.image.src,
        }))
      )} />
    )}
  </div>
</BaseLayout>

<script>
  /**
   * Client-side filtering and load more functionality
   * 
   * Uses vanilla JavaScript instead of Preact island per ADR-001:
   * - Simple DOM manipulation without complex state management
   * - No need for reactive framework overhead
   * - Keeps bundle size minimal (~80 lines)
   * - Progressive enhancement: filtering works, load more is optional
   * 
   * Performance: Script is automatically deferred by Astro's build process
   * and will not block page rendering.
   */
  
  interface ProjectData {
    title: string;
    description: string;
    image: string;
    techStack: string[];
    tags?: string[];
    href: string;
  }

  // Wrapped as a named function so it can run both on initial load *and* on
  // every Astro view-transition swap. Astro's ClientRouter does not re-fire
  // DOMContentLoaded when navigating between pages and inline module scripts
  // do not re-execute on swap, so a plain DOMContentLoaded listener never
  // re-attaches click handlers to freshly-rendered filter buttons after a
  // soft navigation. This was the underlying cause of the projects filter
  // appearing entirely inert when reached from another page.
  function setupProjectsFilter() {
    const filterButtons = document.querySelectorAll<HTMLElement>('.filter-btn');
    const filterBadges = document.querySelectorAll<HTMLElement>('.filter-badge');
    // Bail if we're not on the projects page (e.g. astro:after-swap on a
    // different route).
    if (filterButtons.length === 0 && filterBadges.length === 0) return;
    const emptyState = document.getElementById('empty-state');
    const resetButton = document.querySelector<HTMLElement>('.reset-filter-btn');
    const loadMoreBtn = document.querySelector<HTMLElement>('.load-more-btn');
    const projectsGrid = document.getElementById('projects-grid');
    const shownCount = document.getElementById('shown-count');
    const loadMoreSection = document.getElementById('load-more-section');

    // Load more functionality
    if (loadMoreBtn && projectsGrid) {
      loadMoreBtn.addEventListener('click', () => {
        const remainingProjectsScript = document.getElementById('remaining-projects');
        if (!remainingProjectsScript || !remainingProjectsScript.textContent) return;

        const remainingProjects = JSON.parse(remainingProjectsScript.textContent) as ProjectData[];
        
        // Create project card HTML for remaining projects
        remainingProjects.forEach((project: ProjectData) => {
          const cardWrapper = document.createElement('a');
          cardWrapper.href = project.href;
          cardWrapper.className = 'block w-full focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary-500 rounded-lg transition-shadow duration-300 hover:shadow-lg w-full md:w-[calc(50%-1rem)] lg:w-[calc(33.333%-1.333rem)] project-card-item';
          
          const techStackAttr = project.techStack.map((t: string) => t.toLowerCase()).join(' ');
          cardWrapper.setAttribute('data-tech-stack', techStackAttr);
          
          // Build card DOM safely — avoids innerHTML to prevent XSS if data source changes
          const article = document.createElement('article');
          article.className = 'w-full project-card bg-surface border border-border rounded-lg overflow-hidden transition-all duration-300 hover:shadow-lg hover:border-primary-300 focus-within:ring-2 focus-within:ring-primary-500';

          const imageContainer = document.createElement('div');
          imageContainer.className = 'project-card__image-container relative overflow-hidden';
          const img = document.createElement('img');
          img.src = project.image;
          img.alt = `Screenshot of ${project.title} project`;
          img.className = 'project-card__image w-full h-48 object-cover transition-transform duration-300 hover:scale-105';
          img.loading = 'lazy';
          img.decoding = 'async';
          imageContainer.appendChild(img);
          article.appendChild(imageContainer);

          const content = document.createElement('div');
          content.className = 'project-card__content p-6';

          const header = document.createElement('header');
          header.className = 'project-card__header mb-4';
          const h3 = document.createElement('h3');
          h3.className = 'project-card__title text-xl font-semibold text-foreground mb-2';
          h3.textContent = project.title;
          const desc = document.createElement('p');
          desc.className = 'project-card__description text-muted-foreground leading-relaxed';
          desc.textContent = project.description;
          header.appendChild(h3);
          header.appendChild(desc);
          content.appendChild(header);

          const buildBadgeList = (items: string[], labelText: string, badgeClasses: string) => {
            const wrapper = document.createElement('div');
            wrapper.className = labelText === 'Categories' ? 'project-card__tags mb-4' : 'project-card__tech-stack mb-6';
            const labelRow = document.createElement('div');
            labelRow.className = 'flex items-center gap-2 mb-2';
            const label = document.createElement('span');
            label.className = 'text-xs font-medium text-muted-foreground uppercase tracking-wide';
            label.textContent = labelText;
            labelRow.appendChild(label);
            wrapper.appendChild(labelRow);
            const ul = document.createElement('ul');
            ul.className = 'flex flex-wrap gap-2';
            ul.setAttribute('role', 'list');
            items.forEach((item: string) => {
              const li = document.createElement('li');
              const span = document.createElement('span');
              span.className = `inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${badgeClasses}`;
              span.textContent = item;
              li.appendChild(span);
              ul.appendChild(li);
            });
            wrapper.appendChild(ul);
            return wrapper;
          };

          if (project.tags && project.tags.length > 0) {
            content.appendChild(buildBadgeList(project.tags, 'Categories', 'bg-primary-100 text-primary-800'));
          }
          content.appendChild(buildBadgeList(project.techStack, 'Technologies', 'bg-secondary-100 text-secondary-800'));

          article.appendChild(content);
          cardWrapper.appendChild(article);
          
          projectsGrid.appendChild(cardWrapper);
        });

        // Update count and hide load more button
        if (shownCount) {
          const totalCards = document.querySelectorAll('.project-card-item').length;
          shownCount.textContent = String(totalCards);
        }
        if (loadMoreSection) {
          loadMoreSection.style.display = 'none';
        }
      });
    }

    // Filter functionality
    const filterProjects = (filterValue: string) => {
      let visibleCount = 0;
      const allCards = document.querySelectorAll<HTMLElement>('[data-tech-stack]');

      allCards.forEach((card: HTMLElement) => {
        const techStack = card.getAttribute('data-tech-stack') || '';
        const shouldShow = filterValue === 'all' || techStack.includes(filterValue);
        card.style.display = shouldShow ? 'block' : 'none';
        if (shouldShow) visibleCount++;
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount !== 0);
      }

      // Reset both the .active class AND aria-pressed on every control before the
      // caller marks the newly-selected one. Without the aria-pressed reset, the
      // initial "All Projects" button (which ships aria-pressed="true") stays
      // pressed forever, producing two simultaneously-pressed filters.
      filterButtons.forEach((btn) => {
        btn.classList.remove('active');
        btn.setAttribute('aria-pressed', 'false');
      });
      filterBadges.forEach((badge) => {
        badge.classList.remove('active');
        badge.setAttribute('aria-pressed', 'false');
      });
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filterValue = button.getAttribute('data-filter') ?? 'all';
        filterProjects(filterValue);
        button.classList.add('active');
        button.setAttribute('aria-pressed', 'true');
      });
    });

    filterBadges.forEach((badge) => {
      badge.addEventListener('click', () => {
        const filterValue = badge.getAttribute('data-filter') ?? 'all';
        filterProjects(filterValue);
        badge.classList.add('active');
        badge.setAttribute('aria-pressed', 'true');
      });
    });

    resetButton?.addEventListener('click', () => {
      filterProjects('all');
      filterButtons.forEach((btn) => {
        if (btn.getAttribute('data-filter') === 'all') {
          btn.classList.add('active');
          btn.setAttribute('aria-pressed', 'true');
        } else {
          btn.classList.remove('active');
          btn.setAttribute('aria-pressed', 'false');
        }
      });
    });
  }

  // Initial load: module scripts run after DOM parse, so the DOM is ready.
  setupProjectsFilter();

  // ClientRouter (View Transitions) swaps in new DOM but does not re-fire
  // DOMContentLoaded and does not re-execute inline module scripts. Re-run
  // setup after each swap so freshly-rendered filter buttons get listeners.
  document.addEventListener('astro:after-swap', setupProjectsFilter);
</script>

<style>
  @reference "../../styles/global.css";

  .filter-btn.active {
    @apply bg-primary-600 text-white;
  }
  .filter-btn:focus-visible {
    @apply ring-2 ring-primary-500 ring-offset-2;
  }
  .filter-badge.active {
    @apply bg-primary-600 text-white;
  }
  .filter-badge:focus-visible {
    @apply ring-2 ring-primary-500 ring-offset-2 outline-hidden;
  }
  [data-tech-stack] {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  [data-tech-stack][style*="display: none"] {
    opacity: 0;
    transform: scale(0.95);
  }
</style>
