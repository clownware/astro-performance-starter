---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Badge from "@/components/atoms/Badge.astro";
import ProjectLayout from "@/layouts/ProjectLayout.astro";
import { formatDate, formatPostMetadata } from "@/utils/formatDate";
import { withBase } from "@/utils/url-utils";

// Generate static paths for all projects
export async function getStaticPaths() {
  const entries = await getCollection(
    "projects",
    ({ data }: CollectionEntry<"projects">) => !data.draft,
  );

  return entries.map((entry: CollectionEntry<"projects">) => ({
    params: { slug: entry.id },
    props: {
      entry: entry,
      allProjects: entries.map((e: CollectionEntry<"projects">) => ({
        ...e.data,
        slug: e.id,
      })),
    },
  }));
}

// Props provided by getStaticPaths
const { entry, allProjects } = Astro.props as {
  entry: CollectionEntry<"projects">;
  allProjects: Array<CollectionEntry<"projects">["data"] & { slug: string }>;
};

// Extract project data and render content
const project = entry.data;
const { Content } = await render(entry);

// Derive hero image fallback
const heroImage = project.cover ?? withBase("/logo.svg");

// SEO meta
const pageTitle = `${project.title} - Project Showcase`;
const pageDescription = project.description;
const pageImage = project.cardImage ?? heroImage;

const projectMetadata = formatPostMetadata(project.date, project.description);

// Add slug to project for layout
const projectWithSlug = { ...project, slug: entry.id };

// Determine stats: prefer outcome metrics, fall back to reading time
const hasOutcomes = project.outcomes && project.outcomes.length > 0;
---

<ProjectLayout
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  project={projectWithSlug}
>
  <!-- Rich Content (MDX) -->
  <div class="rich-content">
    <Content />
  </div>

  <!-- Project Meta Strip -->
  <div class="project-meta-strip mt-12 p-6 bg-background-secondary rounded-xl border border-border-primary grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
    {project.client && (
      <div>
        <div class="meta-label text-xs font-semibold uppercase tracking-wider text-foreground-secondary mb-1">Client</div>
        <div class="meta-value text-sm font-medium text-foreground-primary">{project.client}</div>
      </div>
    )}
    {project.role && (
      <div>
        <div class="meta-label text-xs font-semibold uppercase tracking-wider text-foreground-secondary mb-1">Role</div>
        <div class="meta-value text-sm font-medium text-foreground-primary">{project.role}</div>
      </div>
    )}
    {project.duration && (
      <div>
        <div class="meta-label text-xs font-semibold uppercase tracking-wider text-foreground-secondary mb-1">Duration</div>
        <div class="meta-value text-sm font-medium text-foreground-primary">{project.duration}</div>
      </div>
    )}
    {project.date && (
      <div>
        <div class="meta-label text-xs font-semibold uppercase tracking-wider text-foreground-secondary mb-1">Launched</div>
        <div class="meta-value text-sm font-medium text-foreground-primary">{formatDate(project.date, 'full')}</div>
      </div>
    )}
    {!hasOutcomes && (
      <div>
        <div class="meta-label text-xs font-semibold uppercase tracking-wider text-foreground-secondary mb-1">Reading Time</div>
        <div class="meta-value text-sm font-medium text-foreground-primary">{projectMetadata.readingTime}</div>
      </div>
    )}
  </div>

  <!-- Related Projects -->
  {allProjects.filter(p => p.slug !== entry.id).length > 0 && (
    <div class="related-projects mt-12">
      <h3 class="text-xl font-semibold text-foreground-primary mb-6">More Projects</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {allProjects
          .filter(p => p.slug !== entry.id)
          .slice(0, 2)
          .map((relatedProject) => (
            <article class="related-project-card bg-background-secondary border border-border-primary rounded-xl p-6 hover:border-primary-400 transition-colors duration-200">
              <h4 class="text-base font-semibold text-foreground-primary mb-2">
                <a href={withBase(`/projects/${relatedProject.slug}/`)} class="hover:text-primary-300 dark:hover:text-primary-600 transition-colors duration-200 no-underline">
                  {relatedProject.title}
                </a>
              </h4>
              <p class="text-foreground-secondary text-sm mb-4 line-clamp-2">
                {relatedProject.description}
              </p>
              <div class="flex flex-wrap gap-2">
                {(relatedProject.technologies ?? [])
                  .slice(0, 3)
                  .map((tech: string) => (
                    <Badge class="text-xs">
                      {tech}
                    </Badge>
                  ))}
                {(relatedProject.technologies?.length ?? 0) > 3 && (
                  <span class="text-xs text-foreground-secondary self-center">
                    +{(relatedProject.technologies?.length ?? 0) - 3} more
                  </span>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  )}
</ProjectLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .related-project-card {
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .related-project-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px hsl(var(--color-foreground-primary) / 0.08);
  }
</style>
