---
interface TabItem {
  id: string;
  label: string;
}

interface Props {
  tabs: TabItem[];
  defaultTab?: string;
  class?: string;
}

const { tabs, defaultTab, class: className } = Astro.props;
const groupId = Math.random().toString(36).slice(2, 8);
const activeTab = defaultTab ?? tabs[0]?.id;
---

{/*
  CSS-only tabs using the hidden radio-button pattern. The radio inputs hold
  the selection state (so the CSS :has(...:checked) selector can show the
  matching panel without JavaScript), but the *visible* labels carry the
  role="tab" semantics. This means:

  - Screen readers see the labels as the interactive tabs (correct mental
    model — the labels are what users actually see and click).
  - Tooling like Playwright's `getByRole("tab")` resolves to the visible
    label, not a hidden sr-only input behind a sticky header.
  - Roving tabindex on the labels keeps focus inside the tablist per WCAG
    2.1; the inputs are aria-hidden and tabindex="-1" so they no longer
    appear in the focus order.

  A ~30-line inline script handles arrow-key navigation, click-to-state
  syncing, and panel id/aria wiring (panel ids depend on the runtime groupId).
*/}
<div class:list={["tabs", className]} data-tabs data-tabs-group={groupId}>
  <div class="tabs__list" role="tablist" aria-label="Tab navigation">
    {tabs.map((tab) => (
      <label
        class="tabs__tab"
        data-tab-label
        data-tab-id={tab.id}
        role="tab"
        id={`tab-${groupId}-${tab.id}`}
        aria-selected={tab.id === activeTab ? "true" : "false"}
        aria-controls={`panel-${groupId}-${tab.id}`}
        tabindex={tab.id === activeTab ? 0 : -1}
      >
        <input
          type="radio"
          name={`tabs-${groupId}`}
          value={tab.id}
          class="sr-only peer"
          checked={tab.id === activeTab}
          tabindex="-1"
          aria-hidden="true"
          data-tab-radio
        />
        <span class="tabs__tab-label peer-checked:text-primary-600 peer-checked:border-primary-600 dark:peer-checked:text-primary-400 dark:peer-checked:border-primary-400">
          {tab.label}
        </span>
      </label>
    ))}
  </div>

  {/*
    Panels are rendered via the default slot. Consumers wrap each panel in a
    <div data-tab-panel="tabId">. The CSS below (declared is:global because
    slot content lives in the parent component's scope) handles show/hide
    based on which radio is checked.
  */}
  <div class="tabs__panels">
    <slot />
  </div>
</div>

<style>
  .tabs__list {
    display: flex;
    gap: 0;
    border-bottom: 1px solid hsl(var(--color-border-primary));
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .tabs__tab {
    cursor: pointer;
    flex-shrink: 0;
  }

  /* The label is now the focusable role="tab" element. Visible focus ring on
     the label itself (the input is aria-hidden / tabindex=-1 and never
     receives keyboard focus). */
  .tabs__tab:focus-visible {
    outline: 2px solid hsl(var(--color-primary-500));
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .tabs__tab-label {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: hsl(var(--color-foreground-secondary));
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
    min-height: 2.75rem;
  }

  .tabs__tab-label:hover {
    color: hsl(var(--color-foreground-primary));
  }

  .tabs__panels {
    position: relative;
  }
</style>

{/*
  Global panel rules — slot content lives in the consumer component's scope,
  so these selectors must be is:global to cross the scoping boundary.
*/}
<style is:global>
  [data-tabs] [data-tab-panel] {
    display: none;
    padding: 1.5rem 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-tabs] [data-tab-panel] {
      animation: tab-panel-enter 0.2s ease-out;
    }

    @keyframes tab-panel-enter {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>

{/* Dynamic CSS for panel switching — generates :has() selectors per tab */}
<style is:global set:html={tabs.map(tab =>
  `[data-tabs][data-tabs-group="${groupId}"]:has(input[value="${tab.id}"]:checked) [data-tab-panel="${tab.id}"] { display: block; }`
).join('\n')} />

{/*
  Keyboard navigation + panel ARIA wiring + click-to-state syncing.

  The labels carry role="tab" and the focus order; the radios are sr-only
  state holders the CSS reads via :has(...:checked). This script keeps the
  two layers in sync without leaking the implementation detail.
*/}
<script>
  function activateTab(
    label: HTMLElement,
    labels: HTMLElement[],
    tabGroup: HTMLElement,
    focus = true,
  ) {
    const tabId = label.dataset.tabId;
    if (!tabId) return;

    // Update the underlying radio so the CSS panel selector flips.
    const radio = tabGroup.querySelector<HTMLInputElement>(
      `[data-tab-radio][value="${tabId}"]`,
    );
    if (radio && !radio.checked) {
      radio.checked = true;
      radio.dispatchEvent(new Event('change', { bubbles: true }));
    }

    // Roving tabindex + aria-selected on the labels.
    labels.forEach((l) => {
      const isActive = l === label;
      l.setAttribute('aria-selected', isActive ? 'true' : 'false');
      l.setAttribute('tabindex', isActive ? '0' : '-1');
    });

    if (focus) label.focus();
  }

  function initTabs() {
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((tabGroup) => {
      const labels = Array.from(
        tabGroup.querySelectorAll<HTMLElement>('[data-tab-label]'),
      );

      // Wire up panels: assign id, role="tabpanel", aria-labelledby, tabindex.
      // Panel ids depend on the runtime groupId, so they can't be set in the
      // template by consumers — this script bridges that gap.
      labels.forEach((label) => {
        const panelId = label.getAttribute('aria-controls');
        const tabId = label.dataset.tabId;
        if (!panelId || !tabId) return;
        const panel = tabGroup.querySelector<HTMLElement>(`[data-tab-panel="${tabId}"]`);
        if (!panel) return;
        if (!panel.id) panel.id = panelId;
        if (!panel.getAttribute('role')) panel.setAttribute('role', 'tabpanel');
        if (!panel.getAttribute('aria-labelledby')) {
          panel.setAttribute('aria-labelledby', label.id);
        }
        if (!panel.hasAttribute('tabindex')) panel.setAttribute('tabindex', '0');
      });

      // Arrow-key navigation between labels (WCAG 2.1 tablist pattern).
      tabGroup.addEventListener('keydown', (e) => {
        const target = e.target as HTMLElement;
        if (!target.matches('[data-tab-label]')) return;

        const idx = labels.indexOf(target);
        let next = -1;

        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          next = (idx + 1) % labels.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          next = (idx - 1 + labels.length) % labels.length;
        } else if (e.key === 'Home') {
          next = 0;
        } else if (e.key === 'End') {
          next = labels.length - 1;
        }

        if (next >= 0) {
          e.preventDefault();
          activateTab(labels[next], labels, tabGroup);
        }
      });

      // Click on a label (or descendant) — sync aria-selected and tabindex.
      // The HTML <label for/wraps input> contract already toggled the radio.
      tabGroup.addEventListener('click', (e) => {
        const label = (e.target as HTMLElement).closest<HTMLElement>('[data-tab-label]');
        if (!label || !tabGroup.contains(label)) return;
        activateTab(label, labels, tabGroup, false);
      });
    });
  }

  initTabs();
  document.addEventListener('astro:after-swap', initTabs);
</script>
