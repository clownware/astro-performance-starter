---
interface TabItem {
  id: string;
  label: string;
}

interface Props {
  tabs: TabItem[];
  defaultTab?: string;
  class?: string;
}

const { tabs, defaultTab, class: className } = Astro.props;
const groupId = Math.random().toString(36).slice(2, 8);
const activeTab = defaultTab ?? tabs[0]?.id;
---

{/*
  CSS-only tabs using the hidden radio-button pattern — the same technique as
  the Header's checkbox mobile menu. Radio buttons manage exclusive-selection
  state without JavaScript. A small inline script (~25 lines) wires up arrow-key
  navigation (WCAG 2.1) and assigns panel id/aria attributes that the static
  template can't compute (panel ids depend on the runtime groupId).
*/}
<div class:list={["tabs", className]} data-tabs data-tabs-group={groupId}>
  <div class="tabs__list" role="tablist" aria-label="Tab navigation">
    {tabs.map((tab) => (
      <label class="tabs__tab" data-tab-label>
        <input
          type="radio"
          name={`tabs-${groupId}`}
          value={tab.id}
          class="sr-only peer"
          checked={tab.id === activeTab}
          role="tab"
          aria-label={tab.label}
          aria-selected={tab.id === activeTab ? "true" : "false"}
          aria-controls={`panel-${groupId}-${tab.id}`}
          id={`tab-${groupId}-${tab.id}`}
          data-tab-radio
        />
        <span class="tabs__tab-label peer-checked:text-primary-600 peer-checked:border-primary-600 dark:peer-checked:text-primary-400 dark:peer-checked:border-primary-400 peer-focus-visible:ring-2 peer-focus-visible:ring-primary-500 peer-focus-visible:ring-offset-2">
          {tab.label}
        </span>
      </label>
    ))}
  </div>

  {/*
    Panels are rendered via the default slot. Consumers wrap each panel in a
    <div data-tab-panel="tabId">. The CSS below (declared is:global because
    slot content lives in the parent component's scope) handles show/hide
    based on which radio is checked.
  */}
  <div class="tabs__panels">
    <slot />
  </div>
</div>

<style>
  .tabs__list {
    display: flex;
    gap: 0;
    border-bottom: 1px solid hsl(var(--color-border-primary));
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .tabs__tab {
    cursor: pointer;
    flex-shrink: 0;
  }

  .tabs__tab-label {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: hsl(var(--color-foreground-secondary));
    border-bottom: 2px solid transparent;
    transition: color 0.15s, border-color 0.15s;
    white-space: nowrap;
    min-height: 2.75rem;
  }

  .tabs__tab-label:hover {
    color: hsl(var(--color-foreground-primary));
  }

  .tabs__panels {
    position: relative;
  }
</style>

{/*
  Global panel rules — slot content lives in the consumer component's scope,
  so these selectors must be is:global to cross the scoping boundary.
*/}
<style is:global>
  [data-tabs] [data-tab-panel] {
    display: none;
    padding: 1.5rem 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-tabs] [data-tab-panel] {
      animation: tab-panel-enter 0.2s ease-out;
    }

    @keyframes tab-panel-enter {
      from {
        opacity: 0;
        transform: translateY(4px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>

{/* Dynamic CSS for panel switching — generates :has() selectors per tab */}
<style is:global set:html={tabs.map(tab =>
  `[data-tabs][data-tabs-group="${groupId}"]:has(input[value="${tab.id}"]:checked) [data-tab-panel="${tab.id}"] { display: block; }`
).join('\n')} />

{/* Keyboard navigation + panel ARIA wiring */}
<script>
  function initTabs() {
    document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((tabGroup) => {
      const radios = Array.from(tabGroup.querySelectorAll<HTMLInputElement>('[data-tab-radio]'));

      // Wire up panels: assign id, role="tabpanel", aria-labelledby, tabindex.
      // Panel ids depend on the runtime groupId, so they can't be set in the
      // template by consumers — this script bridges that gap.
      radios.forEach((radio) => {
        const tabId = radio.value;
        const panelId = radio.getAttribute('aria-controls');
        if (!panelId) return;
        const panel = tabGroup.querySelector<HTMLElement>(`[data-tab-panel="${tabId}"]`);
        if (!panel) return;
        if (!panel.id) panel.id = panelId;
        if (!panel.getAttribute('role')) panel.setAttribute('role', 'tabpanel');
        if (!panel.getAttribute('aria-labelledby')) panel.setAttribute('aria-labelledby', radio.id);
        if (!panel.hasAttribute('tabindex')) panel.setAttribute('tabindex', '0');
      });

      // Arrow-key navigation between tabs (WCAG 2.1).
      tabGroup.addEventListener('keydown', (e) => {
        const target = e.target as HTMLInputElement;
        if (!target.matches('[data-tab-radio]')) return;

        const idx = radios.indexOf(target);
        let next = -1;

        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
          next = (idx + 1) % radios.length;
        } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
          next = (idx - 1 + radios.length) % radios.length;
        } else if (e.key === 'Home') {
          next = 0;
        } else if (e.key === 'End') {
          next = radios.length - 1;
        }

        if (next >= 0) {
          e.preventDefault();
          radios[next].checked = true;
          radios[next].focus();
          radios[next].dispatchEvent(new Event('change', { bubbles: true }));
        }
      });

      // Keep aria-selected in sync with checked state on change.
      tabGroup.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        if (!target.matches('[data-tab-radio]')) return;
        radios.forEach((r) => {
          r.setAttribute('aria-selected', r.checked ? 'true' : 'false');
        });
      });
    });
  }

  initTabs();
  document.addEventListener('astro:after-swap', initTabs);
</script>
