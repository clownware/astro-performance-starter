---
interface SectionItem {
  id: string;
  label: string;
}

interface Props {
  sections: SectionItem[];
  class?: string;
  /**
   * Accessible name for the nav landmark. Required when more than one
   * ScrollSpy renders on the same page so each landmark has a unique name.
   */
  ariaLabel?: string;
}

const { sections, class: className, ariaLabel = "Page sections" } = Astro.props;
---

{/*
  ScrollSpy — table-of-contents navigation that highlights the current section.
  Uses Intersection Observer (the one case where JS is justified for scroll-aware
  navigation state) with a tiny inline script. Falls back to a static nav list
  without JS.
*/}
<nav class:list={["scroll-spy", className]} aria-label={ariaLabel}>
  <ul class="scroll-spy__list">
    {sections.map((section) => (
      <li>
        <a
          href={`#${section.id}`}
          class="scroll-spy__link"
          data-spy-link={section.id}
        >
          {section.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .scroll-spy__list {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .scroll-spy__link {
    display: block;
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: hsl(var(--color-muted-foreground));
    text-decoration: none;
    border-left: 2px solid transparent;
    border-radius: 0;
    transition: color 0.15s, border-color 0.15s;
    min-height: 2rem;
  }

  .scroll-spy__link:hover {
    color: hsl(var(--color-foreground));
  }

  .scroll-spy__link:focus {
    outline: 2px solid hsl(var(--color-primary-500));
    outline-offset: 2px;
    border-radius: 0.25rem;
  }

  .scroll-spy__link[aria-current="true"] {
    color: hsl(var(--color-primary-600));
    border-left-color: hsl(var(--color-primary-600));
    font-weight: 600;
  }

  :global(.dark) .scroll-spy__link[aria-current="true"] {
    color: hsl(var(--color-primary-400));
    border-left-color: hsl(var(--color-primary-400));
  }

  /* Horizontal layout below the desktop breakpoint. The list scrolls
     horizontally; a mask-image fade on the right edge signals overflow
     since scrollbars are hidden. Scroll-snap keeps each item aligned
     when the user flicks. */
  @media (max-width: 1023px) {
    .scroll-spy {
      /* Soft 1.25rem fade. Wide enough to signal scrollability without
         visibly dimming an active item that lands near the right edge. */
      mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 1.25rem), transparent 100%);
      -webkit-mask-image: linear-gradient(to right, #000 0, #000 calc(100% - 1.25rem), transparent 100%);
    }

    .scroll-spy__list {
      flex-direction: row;
      gap: 0;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      scroll-snap-type: x proximity;
      scroll-padding-inline: 0.5rem;
      padding-right: 1.5rem; /* trailing space so the last item clears the fade */
    }

    .scroll-spy__list::-webkit-scrollbar {
      display: none;
    }

    .scroll-spy__link {
      white-space: nowrap;
      border-left: none;
      border-bottom: 2px solid transparent;
      padding: 0.5rem 0.75rem;
      scroll-snap-align: start;
    }

    .scroll-spy__link[aria-current="true"] {
      border-bottom-color: hsl(var(--color-primary-600));
    }

    :global(.dark) .scroll-spy__link[aria-current="true"] {
      border-bottom-color: hsl(var(--color-primary-400));
    }
  }
</style>

<script>
  function initScrollSpy() {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-spy-link]');
    if (!links.length) return;

    const ids = Array.from(links).map(link => link.dataset.spyLink!);
    const sections = ids
      .map(id => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    if (!sections.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            links.forEach(link => link.removeAttribute('aria-current'));
            const activeLink = document.querySelector(`[data-spy-link="${entry.target.id}"]`);
            activeLink?.setAttribute('aria-current', 'true');
          }
        }
      },
      { rootMargin: '-20% 0px -60% 0px', threshold: 0 }
    );

    sections.forEach(section => observer.observe(section));

    return () => observer.disconnect();
  }

  let cleanup = initScrollSpy();
  document.addEventListener('astro:after-swap', () => {
    cleanup?.();
    cleanup = initScrollSpy();
  });
</script>
