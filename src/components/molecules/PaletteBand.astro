---
/**
 * PaletteBand — renders one colour family as an 11-step (50–950) band.
 *
 * Token-driven by construction: every cell reads `hsl(var(--color-{family}-{step}))`
 * and the step ink reads a token too, so the band always portrays exactly what
 * ships in tokens/ and cannot drift. No colour values are hardcoded here.
 */
interface Props {
  /** Base palette family, e.g. "slate" | "violet" | "rose" | "amber". */
  family: string;
  /** Role + hue caption, e.g. "primary / success · 256°". */
  label: string;
  class?: string;
}
const { family, label, class: className } = Astro.props;

const steps = ["50", "100", "200", "300", "400", "500", "600", "700", "800", "900", "950"];
---

<div class:list={["palette-band", className]}>
  <div class="palette-band__head">
    <b class="palette-band__name">{family}</b>
    <span class="palette-band__label">{label}</span>
  </div>
  <div class="palette-band__scale" role="list" aria-label={`${family} colour scale, 50 to 950`}>
    {steps.map((step) => (
      <div
        role="listitem"
        class="palette-band__step"
        style={`background-color: hsl(var(--color-${family}-${step}))`}
        title={`${family}-${step}`}
      >
        <span class="palette-band__pill">{step}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .palette-band__head {
    display: flex;
    align-items: baseline;
    gap: 0.625rem;
    margin: 0 0 0.5rem;
  }
  .palette-band__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    color: hsl(var(--color-foreground));
  }
  .palette-band__label {
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.75rem;
    color: hsl(var(--color-muted-foreground));
  }
  .palette-band__scale {
    display: grid;
    grid-template-columns: repeat(11, 1fr);
    border-radius: var(--border-radius-md);
    overflow: hidden;
    border: 1px solid hsl(var(--color-border));
  }
  .palette-band__step {
    height: 3.5rem;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 0.375rem;
  }

  /*
   * The step label sits in a small solid pill (background token + muted-foreground
   * token) — a WCAG-AA gated pair — so it stays legible on ANY swatch colour
   * without per-step ink guessing.
   */
  .palette-band__pill {
    background: hsl(var(--color-background));
    color: hsl(var(--color-muted-foreground));
    padding: 0.0625rem 0.3125rem;
    border-radius: var(--border-radius-sm);
    font-family: ui-monospace, SFMono-Regular, monospace;
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.45;
  }
</style>
