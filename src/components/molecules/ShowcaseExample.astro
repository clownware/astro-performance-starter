---
type FeatureTag =
  | "zero-js"
  | "css-only"
  | "wcag-aa"
  | "popover-api"
  | "scroll-driven"
  | "css-property"
  | "starting-style"
  | "dialog"
  | "container-query"
  | "preact-signals"
  | "view-transitions"
  | "progressive-enhancement";

type CodeLang = "astro" | "html" | "tsx" | "ts" | "css" | "json" | "bash" | "md";

interface Props {
  title: string;
  description: string;
  features?: FeatureTag[];
  codeSnippet?: string;
  /**
   * Language of the code snippet for syntax-highlighting tooling. Rendered as
   * `class="language-{codeLang}"` on the inner <code> element. Defaults to
   * "astro" since most showcase samples are Astro markup.
   */
  codeLang?: CodeLang;
  class?: string;
  /**
   * Brief inline accessibility note rendered below the description (one line).
   * Use to surface specific a11y guarantees that aren't obvious from the demo
   * itself — keyboard support, focus management, motion preferences, etc.
   */
  a11yNote?: string;
}

const {
  title,
  description,
  features = [],
  codeSnippet,
  codeLang = "astro",
  class: className,
  a11yNote,
} = Astro.props;

const featureLabels: Record<FeatureTag, { label: string; color: string }> = {
  "zero-js": {
    label: "Zero JS",
    color: "bg-success/10 text-success",
  },
  "css-only": {
    label: "CSS Only",
    color: "bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-200",
  },
  "wcag-aa": {
    label: "WCAG AA",
    color: "bg-secondary-100 text-secondary-800 dark:bg-secondary-900 dark:text-secondary-200",
  },
  "popover-api": {
    label: "Popover API",
    color: "bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-200",
  },
  "scroll-driven": {
    label: "Scroll-Driven",
    color: "bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-200",
  },
  "css-property": {
    label: "CSS @property",
    color: "bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-200",
  },
  "starting-style": {
    label: "@starting-style",
    color: "bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-200",
  },
  dialog: {
    label: "<dialog>",
    color: "bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-200",
  },
  "container-query": {
    label: "Container Query",
    color: "bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-200",
  },
  "preact-signals": {
    label: "Preact Signals",
    color: "bg-warning/10 text-warning",
  },
  "view-transitions": {
    label: "View Transitions",
    color: "bg-secondary-100 text-secondary-800 dark:bg-secondary-900 dark:text-secondary-200",
  },
  "progressive-enhancement": {
    label: "Prog. Enhancement",
    color: "bg-success/10 text-success",
  },
};
---

<div class:list={["showcase-example", className]} id={title.toLowerCase().replace(/\s+/g, '-')}>
  <div class="showcase-example__header">
    <h3 class="text-lg font-semibold text-foreground">{title}</h3>
    {features.length > 0 && (
      <div class="flex flex-wrap gap-1.5">
        {features.map((feature) => {
          const { label, color } = featureLabels[feature];
          return (
            <span class:list={["inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium", color]}>
              {label}
            </span>
          );
        })}
      </div>
    )}
  </div>

  <p class="text-sm text-muted-foreground mb-2">{description}</p>

  {a11yNote && (
    <p class="showcase-example__a11y-note text-xs text-muted-foreground mb-4">
      <span class="showcase-example__a11y-icon" aria-hidden="true">a11y</span>
      {a11yNote}
    </p>
  )}

  {/* Live demo area */}
  <div class="showcase-example__demo">
    <slot />
  </div>

  {/* Expandable code snippet — uses <details> pattern from ExpandableFeatureCard.
      The toggle text includes the example title so screen-reader users navigating
      by element can distinguish between multiple "Show code" controls on the page. */}
  {codeSnippet && (
    <details class="showcase-example__code-details">
      <summary class="showcase-example__code-toggle">
        <span class="details-show">Show {title} code</span>
        <span class="details-hide">Hide {title} code</span>
        <svg
          class="size-4 transform transition-transform duration-200 details-chevron"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 9l-7 7-7-7"
          />
        </svg>
      </summary>
      <div class="showcase-example__code">
        <button
          type="button"
          class="showcase-example__copy"
          data-copy-code
          aria-label={`Copy ${title} code`}
        >
          <span class="showcase-example__copy-label" data-copy-state="idle">Copy</span>
          <span class="showcase-example__copy-label hidden" data-copy-state="copied">Copied!</span>
        </button>
        <pre><code class={`language-${codeLang}`} set:html={codeSnippet} /></pre>
      </div>
    </details>
  )}
</div>

<style>
  .showcase-example {
    padding: 1.5rem;
    border: 1px solid hsl(var(--color-border));
    border-radius: 0.75rem;
    background: hsl(var(--color-background));
  }

  .showcase-example__header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.5rem;
  }

  .showcase-example__demo {
    padding: 1.5rem;
    border: 1px dashed hsl(var(--color-border));
    border-radius: 0.5rem;
    background: hsl(var(--color-surface));
    overflow: hidden;
  }

  .showcase-example__a11y-note {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    background: hsl(var(--color-success-100));
    color: hsl(var(--color-success-700));
    font-style: italic;
  }

  .showcase-example__a11y-icon {
    font-style: normal;
    font-weight: 700;
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 0.0625rem 0.25rem;
    border-radius: 0.1875rem;
    background: hsl(var(--color-success-600) / 0.15);
  }

  :global(.dark) .showcase-example__a11y-note {
    background: hsl(var(--color-success-600) / 0.15);
    color: hsl(var(--color-success-100));
  }

  :global(.dark) .showcase-example__a11y-icon {
    background: hsl(var(--color-success-600) / 0.25);
  }

  .showcase-example__code-details {
    margin-top: 1rem;
  }

  .showcase-example__code-toggle {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: hsl(var(--color-primary-600));
    cursor: pointer;
    list-style: none;
    transition: color 0.15s;
  }

  .showcase-example__code-toggle:hover {
    color: hsl(var(--color-primary-700));
  }

  :global(.dark) .showcase-example__code-toggle {
    color: hsl(var(--color-primary-400));
  }

  :global(.dark) .showcase-example__code-toggle:hover {
    color: hsl(var(--color-primary-300));
  }

  .showcase-example__code-toggle::-webkit-details-marker {
    display: none;
  }

  .showcase-example__code-toggle::marker {
    display: none;
  }

  /* Toggle text visibility */
  .details-hide {
    display: none;
  }
  details[open] .details-show {
    display: none;
  }
  details[open] .details-hide {
    display: inline;
  }
  details[open] .details-chevron {
    transform: rotate(180deg);
  }

  .showcase-example__code {
    margin-top: 0.75rem;
    border-radius: 0.5rem;
    overflow: auto;
    position: relative;
  }

  .showcase-example__copy {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    z-index: 1;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
    font-weight: 500;
    font-family: inherit;
    color: hsl(var(--color-gray-100));
    background: hsl(var(--color-gray-700) / 0.85);
    border: 1px solid hsl(var(--color-gray-600));
    border-radius: 0.25rem;
    cursor: pointer;
    transition:
      background-color 0.15s,
      border-color 0.15s;
  }

  .showcase-example__copy:hover {
    background: hsl(var(--color-gray-600));
    border-color: hsl(var(--color-gray-500));
  }

  .showcase-example__copy:focus-visible {
    outline: 2px solid hsl(var(--color-primary-500));
    outline-offset: 2px;
  }

  .showcase-example__copy[data-copy-state="copied"] {
    background: hsl(var(--color-success-600) / 0.85);
    border-color: hsl(var(--color-success-600));
  }

  .showcase-example__copy-label.hidden {
    display: none;
  }

  .showcase-example__code pre {
    padding: 1rem;
    padding-top: 2.25rem;
    font-size: 0.8125rem;
    line-height: 1.6;
    background: hsl(var(--color-gray-900));
    color: hsl(var(--color-gray-100));
    border-radius: 0.5rem;
    overflow-x: auto;
  }

  .showcase-example__code code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  }

  @media (prefers-reduced-motion: no-preference) {
    .showcase-example__code {
      animation: slideDown 0.3s ease-out;
    }

    @keyframes slideDown {
      from {
        opacity: 0;
        transform: translateY(-0.5rem);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }
</style>

<script>
  // Event delegation: one document-level click handler serves every
  // ShowcaseExample on the page. Astro deduplicates this script across multiple
  // component instances since the content is identical.
  (() => {
    if ((window as unknown as { __showcaseCopyBound?: boolean }).__showcaseCopyBound) return;
    (window as unknown as { __showcaseCopyBound?: boolean }).__showcaseCopyBound = true;

    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      const button = target.closest<HTMLButtonElement>("[data-copy-code]");
      if (!button) return;

      const codeBlock = button.parentElement?.querySelector("pre code");
      if (!codeBlock) return;

      const text = codeBlock.textContent ?? "";
      if (!navigator.clipboard) {
        // Non-secure context or very old browsers — silently no-op rather
        // than throw. The button remains; the user can still select and copy
        // manually.
        return;
      }
      navigator.clipboard.writeText(text).then(() => {
        button.setAttribute("data-copy-state", "copied");
        for (const label of button.querySelectorAll<HTMLElement>("[data-copy-state]")) {
          label.classList.toggle("hidden", label.dataset.copyState !== "copied");
        }
        setTimeout(() => {
          button.setAttribute("data-copy-state", "idle");
          for (const label of button.querySelectorAll<HTMLElement>("[data-copy-state]")) {
            label.classList.toggle("hidden", label.dataset.copyState !== "idle");
          }
        }, 1500);
      });
    });
  })();
</script>
