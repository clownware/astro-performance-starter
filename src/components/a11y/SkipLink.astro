---
// An accessible skip link component that becomes visible on focus.
// It uses the sr-only class from Tailwind CSS for the base styles.
---

<a
  href="#main-content"
  class="sr-only left-4 top-4 z-[999] rounded-md bg-background px-4 py-2 text-foreground transition focus:not-sr-only"
>
  Skip to content
</a>
