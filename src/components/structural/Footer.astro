---
import Container from "@/components/structural/Container.astro";
import { siteLinks, socialLinks } from "@/config";
import { withBase } from "@/utils/url-utils";

const currentYear = new Date().getFullYear();
void currentYear;

const footerLinks = [
  { label: "Home", href: withBase("/") },
  { label: "Blog", href: withBase("/blog/") },
  { label: "Projects", href: withBase("/projects/") },
  { label: "About", href: withBase("/about/") },
  { label: "Contact", href: withBase("/contact/") },
];

const docsLinks = siteLinks.docs
  ? [
      { label: "Getting Started", href: `${siteLinks.docs}/getting-started/` },
      { label: "Implementation Guides", href: `${siteLinks.docs}/implementation-guides/` },
      {
        label: "Directory Structure",
        href: `${siteLinks.docs}/getting-started/directory-structure/`,
      },
      { label: "Architecture Decisions", href: `${siteLinks.docs}/adr/` },
    ]
  : [];

// Project repo + personal social profiles. Order: project repo first, then
// social profiles in display order. Empty values are filtered out so the
// section auto-hides when nothing is configured.
const externalLinks = [
  ...(siteLinks.github ? [{ label: "GitHub", href: siteLinks.github }] : []),
  ...(socialLinks.linkedin ? [{ label: "LinkedIn", href: socialLinks.linkedin }] : []),
  ...(socialLinks.twitter ? [{ label: "Twitter", href: socialLinks.twitter }] : []),
];
---

<footer class="bg-background-default">
  <Container class="py-16 sm:py-20 lg:py-24">
    <div class="grid grid-cols-1 gap-8 sm:gap-12 lg:grid-cols-4 lg:gap-12">
      <!-- Brand Section -->
      <div class="lg:col-span-1">
        <div class="mb-6">
          <img
            src={withBase("/logo.svg")}
            alt=""
            class="h-10 w-auto" 
            width="220" 
            height="60"
          />
        </div>
        <p class="text-sm text-muted-foreground leading-relaxed max-w-sm">
          Production-ready Astro template with zero-JS baseline and 95+ Lighthouse scores. Built for performance and developer experience.
        </p>
      </div>

      <!-- Navigation Links -->
      <div class="lg:col-span-1">
        <h2 class="text-sm font-semibold text-foreground mb-6 uppercase tracking-wide">Navigation</h2>
        <ul class="space-y-4">
          {footerLinks.map((link) => (
            <li>
              <a 
                href={link.href} 
                class="no-underline text-sm text-muted-foreground hover:text-link transition-all duration-200 hover:translate-x-1 flex items-center min-h-[2.75rem]"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Docs Links -->
      {docsLinks.length > 0 && (
      <div class="lg:col-span-1">
        <h2 class="text-sm font-semibold text-foreground mb-6 uppercase tracking-wide">Docs</h2>
        <ul class="space-y-4">
          {docsLinks.map((link) => (
            <li>
              <a 
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="no-underline text-sm text-muted-foreground hover:text-link transition-all duration-200 hover:translate-x-1 flex items-center gap-1 min-h-[2.75rem]"
              >
                {link.label}
                <svg class="size-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
      )}

      <!-- Social Links -->
      {externalLinks.length > 0 && (
      <div class="lg:col-span-1">
        <h2 class="text-sm font-semibold text-foreground mb-6 uppercase tracking-wide">Connect</h2>
        <ul class="space-y-4">
          {externalLinks.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="no-underline text-sm text-muted-foreground hover:text-link transition-all duration-200 inline-block group"
              >
                <span class="group-hover:translate-x-1 transition-transform duration-200 inline-block">{link.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      )}
    </div>

    <!-- Copyright -->
    <div class="border-t border-border mt-16 pt-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <p class="text-sm text-muted-foreground">
          &copy; {currentYear} <a href="https://github.com/clownware" class="no-underline hover:text-link transition-colors" target="_blank" rel="noopener noreferrer">Clownware</a>. MIT Licensed starter template.
        </p>
        <div class="flex flex-wrap items-center gap-4 text-xs">
          <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-200">
            <span aria-hidden="true">🔒</span> MIT Licensed
          </span>
          <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-secondary-100 text-secondary-800 dark:bg-secondary-900 dark:text-secondary-200">
            <span aria-hidden="true">🎆</span> Production Ready
          </span>
          <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-200">
            <span aria-hidden="true">🤖</span> Agentic Discipline
          </span>
          {siteLinks.pagespeed ? (
          <a 
            href={siteLinks.pagespeed}
            target="_blank"
            rel="noopener noreferrer"
            class="no-underline inline-flex items-center gap-1 px-2 py-1 rounded-full bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-200 hover:bg-primary-200 dark:hover:bg-primary-800 transition-colors"
            aria-label="View live Lighthouse scores"
          >
            <span aria-hidden="true">🎯</span> 95+ Lighthouse
          </a>
          ) : (
          <span class="inline-flex items-center gap-1 px-2 py-1 rounded-full bg-primary-100 text-primary-800 dark:bg-primary-900 dark:text-primary-200">
            <span aria-hidden="true">🎯</span> 95+ Lighthouse
          </span>
          )}
        </div>
      </div>
    </div>
  </Container>
</footer>
