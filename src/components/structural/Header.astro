---
import { getCollection } from "astro:content";
import Icon from "@/components/atoms/Icon.astro";
import type { NavItem } from "@/types/navigation";
import { withBase } from "@/utils/url-utils";

const navigation = await getCollection("navigation");
const navItems: NavItem[] = navigation[0]?.data.items || [];
const textNavItems = navItems.filter((item: NavItem) => !item.isExternal);
const githubItem = navItems.find((item: NavItem) => item.isExternal && item.icon === "github-logo");
---

<header
  transition:persist
  class="sticky top-0 z-50 w-full border-b border-primary bg-background-primary/95 supports-backdrop-filter:backdrop-blur-sm supports-backdrop-filter:bg-background-primary/60"
>
  <div class="container flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href={withBase("/")} class="flex items-center" aria-label="Homepage">
      <img
        src={withBase("/logo.svg")}
        alt="Astro Performance Starter"
        class="h-8 w-auto"
        width="220"
        height="60"
        transition:name="site-logo"
      />
    </a>

    <nav class="hidden lg:flex items-center gap-8" aria-label="Main navigation">
      {textNavItems.map((item: NavItem) => {
        const resolvedHref = withBase(item.href);
        return (
          <a
            href={resolvedHref}
            class="no-underline text-base font-medium text-foreground-secondary transition-all hover:text-foreground-primary hover:scale-105 focus-visible-ring px-3 py-2 rounded-md hover:bg-background-secondary"
            aria-current={Astro.url.pathname === resolvedHref ? 'page' : undefined}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <div class="flex items-center gap-2">
      {githubItem && (
        <a
          href={githubItem.href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="View on GitHub (opens in new tab)"
          class="inline-flex h-10 w-10 sm:h-9 sm:w-9 items-center justify-center rounded-md text-foreground-secondary transition hover:text-foreground-primary hover:bg-background-secondary focus-visible-ring"
        >
          <Icon name="github" class="h-5 w-5" decorative />
        </a>
      )}
      <!--
        CSS-only mobile menu toggle: hidden checkbox + label button.
        The label is keyboard-activated via the script below; aria-expanded
        is updated on `change` to reflect the checkbox's :checked state, since
        CSS alone cannot mutate DOM attributes.
      -->
      <label
        for="mobile-menu-toggle"
        tabindex="0"
        role="button"
        aria-label="Toggle menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-mobile-menu-button
        class="inline-flex h-10 w-10 sm:h-9 sm:w-9 items-center justify-center rounded-md border border-primary bg-background-primary/80 transition motion-safe:transition-colors motion-reduce:transition-none hover:bg-background-secondary focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring lg:hidden"
      >
        <span class="sr-only">Toggle menu</span>
        <!-- Hamburger icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </label>
    </div>
  </div>

  <!-- Hidden checkbox controls mobile nav visibility via peer-checked classes -->
  <input
    id="mobile-menu-toggle"
    type="checkbox"
    class="peer sr-only"
    aria-controls="mobile-menu"
    aria-label="Toggle main menu"
  />

  <script>
    function syncMobileMenuExpanded() {
      const toggle = document.getElementById('mobile-menu-toggle') as HTMLInputElement | null;
      const button = document.querySelector<HTMLElement>('[data-mobile-menu-button]');
      if (toggle && button) {
        button.setAttribute('aria-expanded', toggle.checked ? 'true' : 'false');
      }
    }

    document.addEventListener('change', (e) => {
      const target = e.target as HTMLElement;
      if (target?.id === 'mobile-menu-toggle') {
        syncMobileMenuExpanded();
      }
    });

    // After Astro view transitions, the persisted header keeps its state but
    // a freshly inserted toggle needs its expanded attribute synced.
    document.addEventListener('astro:after-swap', syncMobileMenuExpanded);

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      const toggle = document.getElementById('mobile-menu-toggle') as HTMLInputElement | null;
      // Close mobile menu when Escape is pressed
      if (e.key === 'Escape') {
        if (toggle?.checked) {
          toggle.checked = false;
          toggle.dispatchEvent(new Event('change'));
        }
        return;
      }
      // Activate mobile menu toggle via keyboard when label is focused
      const label = e.target as HTMLElement;
      if (label.matches('label[for="mobile-menu-toggle"]')) {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          if (toggle) {
            toggle.checked = !toggle.checked;
            toggle.dispatchEvent(new Event('change'));
          }
        }
      }
    });
  </script>

  <nav
    id="mobile-menu"
    class="fixed inset-0 top-16 z-40 hidden flex-col gap-6 bg-background-primary p-6 opacity-0 pointer-events-none lg:hidden motion-safe:transition-opacity motion-reduce:transition-none duration-200 peer-checked:flex peer-checked:opacity-100 peer-checked:pointer-events-auto"
    aria-label="Mobile navigation"
    aria-live="polite"
  >
    {textNavItems.map((item: NavItem) => (
      <a
        href={withBase(item.href)}
        class="no-underline text-lg font-medium text-foreground-primary transition-colors hover:text-foreground-primary focus-visible-ring"
      >
        {item.label}
      </a>
    ))}
    {githubItem && (
      <a
        href={githubItem.href}
        target="_blank"
        rel="noopener noreferrer"
        class="no-underline text-lg font-medium text-foreground-primary transition-colors hover:text-foreground-primary focus-visible-ring inline-flex items-center gap-2"
      >
        <Icon name="github" class="h-5 w-5" decorative />
        GitHub
      </a>
    )}
  </nav>
</header>
