---
import { getCollection } from "astro:content";
import ThemeSetup from "@/components/ThemeSetup.astro"; // Corrected path
import type { NavItem } from "@/types/navigation"; // Import the new type

const navigation = await getCollection("navigation");
// Explicitly type navItems to ensure type safety in the template
const navItems: NavItem[] = navigation[0]?.data.items || [];
---

<header
  class="sticky top-0 z-50 w-full border-b border-primary bg-background-primary/95 supports-backdrop-filter:backdrop-blur-sm supports-backdrop-filter:bg-background-primary/60"
>
  <div class="container flex h-16 items-center justify-between px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center" aria-label="Homepage">
      <img 
        src="/logo.svg" 
        alt="Home" 
        class="h-8 w-auto" 
        width="220" 
        height="60"
      />
    </a>

    <nav class="hidden md:flex items-center gap-8" aria-label="Main navigation">
      {navItems.map((item: NavItem) => (
        <a
          href={item.href}
          class="text-base font-medium text-foreground-secondary transition-all hover:text-foreground-primary hover:scale-105 focus-visible-ring px-3 py-2 rounded-md hover:bg-background-secondary"
          aria-current={Astro.url.pathname === item.href ? 'page' : undefined}
          target={item.isExternal ? '_blank' : undefined}
          rel={item.isExternal ? 'noopener noreferrer' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <ThemeSetup />
      <!-- CSS-only mobile menu toggle: hidden checkbox + label button -->
      <label
        for="mobile-menu-toggle"
        role="button"
        aria-label="Toggle menu"
        class="inline-flex h-10 w-10 sm:h-9 sm:w-9 items-center justify-center rounded-md border border-primary bg-background-primary/80 transition motion-safe:transition-colors motion-reduce:transition-none hover:bg-background-secondary focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring md:hidden"
      >
        <span class="sr-only">Toggle menu</span>
        <!-- Hamburger icon -->
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="h-5 w-5"
          aria-hidden="true"
        >
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </label>
    </div>
  </div>

  <!-- Hidden checkbox controls mobile nav visibility via peer-checked classes -->
  <input
    id="mobile-menu-toggle"
    type="checkbox"
    class="peer sr-only"
    aria-controls="mobile-menu"
    aria-label="Toggle main menu"
  />

  <nav
    id="mobile-menu"
    class="fixed inset-0 top-16 z-40 hidden flex-col gap-6 bg-background-primary p-6 opacity-0 pointer-events-none md:hidden motion-safe:transition-opacity motion-reduce:transition-none duration-200 peer-checked:flex peer-checked:opacity-100 peer-checked:pointer-events-auto"
    aria-label="Mobile navigation"
    aria-live="polite"
  >
    {navItems.map((item: NavItem) => (
      <a
        href={item.href}
        class="text-lg font-medium text-foreground-primary transition-colors hover:text-foreground-primary focus-visible-ring"
        target={item.isExternal ? '_blank' : undefined}
        rel={item.isExternal ? 'noopener noreferrer' : undefined}
      >
        {item.label}
      </a>
    ))}
  </nav>
</header>
