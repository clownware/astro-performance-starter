---
interface Props {
  variant?: "primary" | "secondary" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
  href?: string;
  [key: string]: any;
}

const { variant = "primary", size = "md", class: className, href, ...rest } = Astro.props as Props;

const baseStyles =
  "inline-flex items-center justify-center rounded-lg font-semibold transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-offset-2 disabled:pointer-events-none disabled:opacity-50";

const variantStyles = {
  primary:
    "bg-primary-600 text-white hover:bg-primary-700 active:bg-primary-800 focus:ring-primary-500 shadow-sm hover:shadow-md",
  secondary:
    "bg-background-secondary text-foreground-primary border border-primary hover:bg-background-primary active:bg-background-primary focus:ring-primary-500 shadow-sm hover:shadow",
  ghost:
    "text-foreground-secondary hover:bg-background-secondary hover:text-foreground-primary active:bg-background-secondary focus:ring-primary-500",
};

const sizeStyles = {
  sm: "text-xs h-8 px-3 py-1.5",
  md: "text-sm h-10 px-4 py-2",
  lg: "text-base h-12 px-6 py-3",
};

const Tag = href ? "a" : "button";
---
<Tag
  class:list={[
    baseStyles,
    variantStyles[variant],
    sizeStyles[size],
    className,
  ]}
  href={href}
  {...rest}
>
  <slot />
</Tag>
