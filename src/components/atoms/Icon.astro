  handshake:
    "M11 17l2 2a1.4 1.4 0 0 0 2 0l3-3a1.4 1.4 0 0 0 0-2l-3-3 M14 14l-3-3 M9 11l-2-2a2 2 0 0 0-2.8 2.8l3 3 M19 7l-2-2a2 2 0 0 0-2.8 0L13 6.2 M3 12v3.5a3.5 3.5 0 0 0 7 0 M21 12v3.5a3.5 3.5 0 0 1-7 0",
};

const iconPath = name !== "custom" ? icons[name] : undefined;
const isFillPath = name === "github";
const isStrokePath = !isFillPath && name !== "custom";
---

<svg
  class:list={[className]}
  fill={isStrokePath ? "none" : "currentColor"}
  stroke={isStrokePath ? "currentColor" : undefined}
  stroke-width={isStrokePath ? "2" : undefined}
  stroke-linecap={isStrokePath ? "round" : undefined}
  stroke-linejoin={isStrokePath ? "round" : undefined}
  viewBox="0 0 24 24"
  aria-hidden={decorative ? "true" : undefined}
  aria-label={ariaLabel}
  role={!decorative && ariaLabel ? "img" : undefined}
>
  {name === "custom" ? (
    <slot />
  ) : (
    <path d={iconPath} />
  )}
</svg>
