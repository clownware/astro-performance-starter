---
/**
 * Icon component for rendering inline SVG icons with consistent styling.
 *
 * Implementation:
 *  - All icons render at viewBox 24×24 with currentColor.
 *  - One filled-path icon: `github` (the solid GitHub mark).
 *  - All others are stroke-path icons (stroke-width 2, line-join/cap round).
 *  - Each entry stores a single SVG path `d` string; multi-subpath strings cover
 *    icons that would normally need multiple <path>/<circle> nodes (e.g. `bot`).
 *
 * Lucide-aligned glyph family — visually consistent line icons drawn at the
 * same weight/scale, in the same spirit as Lucide. See ADR-055 (icon system).
 *
 * @example
 * <Icon name="github" class="w-5 h-5" />
 * <Icon name="zap" class="size-6" />
 */

import type { IconName } from "@/types/icons";

interface Props {
  /** Icon name from predefined set or 'custom' for slot content */
  name: IconName;
  /** Additional CSS classes for sizing and styling */
  class?: string;
  /** Accessible label for screen readers */
  ariaLabel?: string;
  /** Whether icon is decorative (hidden from screen readers) */
  decorative?: boolean;
}

const { name, class: className = "w-5 h-5", ariaLabel, decorative = false } = Astro.props;

// Icon path definitions — currentColor, 24×24 viewBox.
// Stroke icons share stroke-width 2, round line-cap/line-join.
const icons: Record<Exclude<IconName, "custom">, string> = {
