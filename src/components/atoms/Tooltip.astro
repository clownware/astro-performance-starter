---
interface Props {
  text: string;
  position?: "top" | "bottom" | "left" | "right";
  class?: string;
}

const { text, position = "top", class: className } = Astro.props;

const positionClasses = {
  top: "bottom-full left-1/2 transform -translate-x-1/2 mb-2",
  bottom: "top-full left-1/2 transform -translate-x-1/2 mt-2",
  left: "right-full top-1/2 transform -translate-y-1/2 mr-2",
  right: "left-full top-1/2 transform -translate-y-1/2 ml-2",
};

const arrowClasses = {
  top: "top-full left-1/2 transform -translate-x-1/2 border-l-transparent border-r-transparent border-b-transparent border-t-foreground-primary",
  bottom:
    "bottom-full left-1/2 transform -translate-x-1/2 border-l-transparent border-r-transparent border-t-transparent border-b-foreground-primary",
  left: "left-full top-1/2 transform -translate-y-1/2 border-t-transparent border-b-transparent border-r-transparent border-l-foreground-primary",
  right:
    "right-full top-1/2 transform -translate-y-1/2 border-t-transparent border-b-transparent border-l-transparent border-r-foreground-primary",
};
---

<span class:list={["relative inline-block", className]} data-tooltip>
  <slot />
  <div 
    class:list={[
      "absolute z-50 px-3 py-2 text-xs text-background-primary bg-foreground-primary rounded-md shadow-lg opacity-0 pointer-events-none transition-opacity duration-200 whitespace-nowrap max-w-xs",
      positionClasses[position]
    ]}
    data-tooltip-content
    role="tooltip"
  >
    {text}
    <div 
      class:list={[
        "absolute w-0 h-0 border-4",
        arrowClasses[position]
      ]}
    ></div>
  </div>
</span>

<script>
  // Add tooltip functionality
  document.addEventListener('DOMContentLoaded', () => {
    const tooltips = document.querySelectorAll('[data-tooltip]');
    
    tooltips.forEach(tooltip => {
      const content = tooltip.querySelector('[data-tooltip-content]') as HTMLElement;
      
      tooltip.addEventListener('mouseenter', () => {
        content.classList.remove('opacity-0', 'pointer-events-none');
        content.classList.add('opacity-100');
      });
      
      tooltip.addEventListener('mouseleave', () => {
        content.classList.add('opacity-0', 'pointer-events-none');
        content.classList.remove('opacity-100');
      });
      
      // Keyboard accessibility
      tooltip.addEventListener('focus', () => {
        content.classList.remove('opacity-0', 'pointer-events-none');
        content.classList.add('opacity-100');
      });
      
      tooltip.addEventListener('blur', () => {
        content.classList.add('opacity-0', 'pointer-events-none');
        content.classList.remove('opacity-100');
      });
    });
  });
</script>
