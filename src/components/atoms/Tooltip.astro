---
interface Props {
  text: string;
  position?: "top" | "bottom" | "left" | "right";
  class?: string;
}

const { text, position = "top", class: className } = Astro.props;

const positionClasses = {
  top: "bottom-full left-1/2 transform -translate-x-1/2 mb-2",
  bottom: "top-full left-1/2 transform -translate-x-1/2 mt-2",
  left: "right-full top-1/2 transform -translate-y-1/2 mr-2",
  right: "left-full top-1/2 transform -translate-y-1/2 ml-2",
};

const arrowBase = "absolute w-0 h-0 border-4";
type Position = "top" | "bottom" | "left" | "right";
const tooltipId = `tooltip-${Math.random().toString(36).slice(2, 10)}`;

function getArrowClasses(pos: Position) {
  const map: Record<Position, string> = {
    top: "top-full left-1/2 transform -translate-x-1/2 border-l-transparent border-r-transparent border-b-transparent border-t-background-secondary",
    bottom:
      "bottom-full left-1/2 transform -translate-x-1/2 border-l-transparent border-r-transparent border-t-transparent border-b-background-secondary",
    left: "left-full top-1/2 transform -translate-y-1/2 border-t-transparent border-b-transparent border-r-transparent border-l-background-secondary",
    right:
      "right-full top-1/2 transform -translate-y-1/2 border-t-transparent border-b-transparent border-l-transparent border-r-background-secondary",
  };
  return `${arrowBase} ${map[pos]}`;
}
---

{/*
  Tooltip with Popover API progressive enhancement.
  Base: CSS group-hover/group-focus-within (works everywhere).
  Enhancement: popover="hint" adds auto-dismiss, Escape-to-close, and proper
  stacking context — replacing tippy.js/Floating UI with zero JavaScript.
*/}
<span class:list={["tooltip-trigger relative inline-block group", className]} data-tooltip tabindex="0" aria-describedby={tooltipId}>
  <slot />
  <div
    class:list={[
      "tooltip-content absolute z-50 px-3 py-2 text-[0.8125rem] sm:text-xs text-foreground-primary bg-background-secondary rounded-md shadow-lg opacity-0 invisible pointer-events-none transition-opacity duration-200 motion-reduce:transition-none whitespace-normal wrap-break-word max-w-[80vw] sm:max-w-xs group-hover:opacity-100 group-focus-within:opacity-100 group-hover:visible group-focus-within:visible group-hover:pointer-events-auto group-focus-within:pointer-events-auto",
      positionClasses[position]
    ]}
    popover="hint"
    data-tooltip-content
    id={tooltipId}
    role="tooltip"
  >
    {text}
    <div
      class:list={[ getArrowClasses(position) ]}
      aria-hidden="true"
    ></div>
  </div>
</span>

<style>
  @media (prefers-reduced-motion: reduce) {
    [data-tooltip-content] {
      transition: none !important;
    }
  }

  /*
   * Popover API enhancement: when supported, the browser manages show/hide
   * via popover="hint", providing auto-dismiss and Escape-to-close behavior.
   * The existing CSS hover/focus fallback remains for browsers without support.
   */
  @supports selector(:popover-open) {
    .tooltip-content {
      /* Reset absolute positioning — popover uses the top layer */
      position: fixed;
      inset: unset;
      margin: 0;
      border: none;
      padding: 0.5rem 0.75rem;
      background: hsl(var(--color-background-secondary));
      color: hsl(var(--color-foreground-primary));
      border-radius: 0.375rem;
      box-shadow: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
      font-size: 0.8125rem;
      max-width: min(80vw, 20rem);
      white-space: normal;
      overflow-wrap: break-word;
    }

    /* Hide the CSS-only arrow when using popover (top-layer positioning differs) */
    .tooltip-content:popover-open [aria-hidden="true"] {
      display: none;
    }

    .tooltip-content:popover-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    @media (prefers-reduced-motion: no-preference) {
      .tooltip-content {
        transition:
          opacity 0.15s ease-out,
          display 0.15s ease-out allow-discrete,
          overlay 0.15s ease-out allow-discrete;
      }

      @starting-style {
        .tooltip-content:popover-open {
          opacity: 0;
        }
      }
    }
  }
</style>
