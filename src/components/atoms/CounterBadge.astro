---
interface Props {
  value: number;
  suffix?: string;
  prefix?: string;
  label: string;
  class?: string;
}

const { value, suffix = "", prefix = "", label, class: className } = Astro.props;

// Single accessible name for the whole badge — the visual children below are
// decorative (animated counter) and hidden from assistive tech via aria-hidden.
// Following ADR-019: meaningful aggregate content gets one role="img" + aria-label.
const accessibleName = `${prefix}${value}${suffix} ${label}`;
---

{/*
  CSS-only animated counter using @property with <integer> type.
  The number counts up from 0 to the target value using pure CSS animation,
  triggered by scroll-driven animation when supported. Falls back to a
  time-based animation on browsers without scroll-driven support.
*/}
<div
  class:list={["counter-badge", className]}
  role="img"
  aria-label={accessibleName}
>
  <span
    class="counter-badge__value"
    style={`--counter-target: ${value}`}
    aria-hidden="true"
    data-prefix={prefix || undefined}
    data-suffix={suffix || undefined}
  ></span>
  <span class="counter-badge__label" aria-hidden="true">{label}</span>
</div>

<style>
  @property --num {
    syntax: "<integer>";
    initial-value: 0;
    inherits: false;
  }

  .counter-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .counter-badge__value {
    --counter-target: 0;
    --num: 0;
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1;
    color: hsl(var(--color-primary-600));
    font-variant-numeric: tabular-nums;
    counter-reset: num var(--num);
  }

  .counter-badge__value::before {
    content: attr(data-prefix) counter(num) attr(data-suffix);
  }

  /*
    Time-based fallback: applies in every browser. Browsers that ignore
    `animation-timeline` (Safari ≤ 18.3) keep the 1.5s on-load animation.
    Browsers that support it override the timeline below.
  */
  @media (prefers-reduced-motion: no-preference) {
    .counter-badge__value {
      animation: count-up 1.5s ease-out forwards;
    }
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .counter-badge__value {
        animation-timeline: view();
        animation-range: entry 0% cover 30%;
      }
    }
  }

  /* When motion is reduced, jump straight to the final value (no animation). */
  @media (prefers-reduced-motion: reduce) {
    .counter-badge__value {
      --num: var(--counter-target);
    }
  }

  @keyframes count-up {
    to {
      --num: var(--counter-target);
    }
  }

  .counter-badge__label {
    font-size: 0.875rem;
    font-weight: 500;
    color: hsl(var(--color-foreground-secondary));
    text-align: center;
  }

  :global(.dark) .counter-badge__value {
    color: hsl(var(--color-primary-400));
  }
</style>
