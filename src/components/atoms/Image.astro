---
import { Image as AstroImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { resolveImageFormat } from "@/utils/resolveImageFormat";

interface Props {
  src: ImageMetadata | string | Promise<{ default: ImageMetadata }>;
  alt: string;
  class?: string;
  format?: "avif" | "webp" | "png" | "jpeg" | "jpg" | "svg" | "gif";
  quality?: number | "low" | "mid" | "high" | "max";
  width?: number;
  height?: number;
  sizes?: string;
  widths?: number[];
  loading?: "lazy" | "eager";
  decoding?: "async" | "sync" | "auto";
  /**
   * Responsive layout (ADR-030). Defaults to the global `image.layout`
   * ("constrained"); pass "full-width" for hero banners or "none" to opt a
   * raster out of srcset/sizes generation. Under any layout other than
   * "none", Astro derives `widths` and `sizes` when the caller gives none.
   * (There is no `densities` prop: Astro ignores densities under any layout
   * and its Props type forbids combining them with `layout`.)
   */
  layout?: "constrained" | "fixed" | "full-width" | "none";
  /** Optional shadow styles for performance modularity */
  hasShadow?: boolean;
}

const props = Astro.props as Props;
const {
  src,
  alt,
  class: className,
  format,
  quality,
  width,
  height,
  sizes,
  widths: widthsProp,
  loading,
  decoding,
  layout,
  hasShadow = false,
} = props;

// Normalize src to ImageMetadata when possible
let resolvedSrc: ImageMetadata | null = null;
if (typeof src === "string") {
  resolvedSrc = null; // Fallback to native <img> below
} else if (src && typeof (src as any).then === "function") {
  const mod = await (src as Promise<{ default: ImageMetadata }>);
  resolvedSrc = mod.default;
} else {
  resolvedSrc = src as ImageMetadata;
}

// The wrapper no longer invents srcset candidates: the global constrained
// layout (astro.config.mjs, ADR-030) derives `widths` and `sizes` from the
// rendered width, so a caller's explicit `widths` or `sizes` override that
// derivation and nothing else does.

// SVG sources pass through unprocessed (Astro 6.4+ disables SVG
// rasterization, and a vector should stay a vector anyway) and stay outside
// the responsive layout: a vector has no widths to generate.
const isSvgSource = resolvedSrc?.format === "svg";

const qualityMap = { low: 40, mid: 60, high: 75, max: 90 } as const;
const normalizedQuality: number =
  typeof quality === "number"
    ? quality
    : qualityMap[(quality ?? "high") as keyof typeof qualityMap];

// Base defaults
const baseDefaults = {
  format: resolveImageFormat(format, resolvedSrc?.format),
  quality: normalizedQuality,
  loading: (loading ?? "lazy") as "lazy" | "eager",
  decoding: (decoding ?? "async") as "async" | "sync" | "auto",
};

// Compose classes with optional shadow styles
const baseClasses = ["rounded-lg", "transition-all", "duration-300", "ease-in-out"];
const shadowClasses = hasShadow ? ["shadow-md", "hover:shadow-xl"] : [];
const composedClass = [...baseClasses, ...shadowClasses, className].filter(Boolean).join(" ");

// No object spread to satisfy AstroImage's discriminated union typing
---

{resolvedSrc ? (
  isSvgSource ? (
    <AstroImage
      src={resolvedSrc as ImageMetadata}
      alt={alt}
      class={composedClass}
      format="svg"
      loading={baseDefaults.loading}
      decoding={baseDefaults.decoding}
      width={width}
      height={height}
      layout="none"
    />
  ) : (
    <AstroImage
      src={resolvedSrc as ImageMetadata}
      alt={alt}
      class={composedClass}
      format={baseDefaults.format}
      quality={baseDefaults.quality}
      loading={baseDefaults.loading}
      decoding={baseDefaults.decoding}
      width={width}
      height={height}
      sizes={sizes}
      widths={widthsProp}
      layout={layout}
    />
  )
) : (
  // Fallback for string src paths – native <img>
  <img
    src={src as string}
    alt={alt}
    class={composedClass}
    loading={baseDefaults.loading}
    decoding={baseDefaults.decoding}
  />
)}
