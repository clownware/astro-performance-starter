---
import type { HTMLAttributes } from "astro/types";

export interface Props extends HTMLAttributes<"figure"> {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption, ...figureAttrs } = Astro.props;
---

<figure {...figureAttrs}>
  <img src={src} alt={alt} />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
