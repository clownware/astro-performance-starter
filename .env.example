# Environment Variables Template
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Site Configuration
# For production builds, set SITE_URL (preferred) or PUBLIC_SITE_URL to your canonical domain.
# Example:
# SITE_URL="https://astro-starter-template.com"
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_SITE_TITLE="Astro Performance Starter"
PUBLIC_SITE_DESCRIPTION="High-performance website built with Astro"

# Analytics (optional) - See docs/implementation-guides/06-optional-features/01-analytics.md
# Uncomment and set the appropriate variable for your chosen provider.
# PUBLIC_PLAUSIBLE_DOMAIN="your-domain.com"
# PUBLIC_FATHOM_SITE_ID="YOUR_FATHOM_SITE_ID"

# API Keys (if needed)
# API_KEY=your-api-key-here

# Development
DEV_MODE=true
DEBUG=false
