---
// Custom theme toggle component with enhanced UX
---

<script>
  // Theme toggle functionality with smooth transitions
  const initTheme = () => {
    const toggle = document.querySelector('[data-theme-toggle]');
    const root = document.documentElement;
    
    if (!toggle) return;
    
    // Get saved theme or default to system preference
    const savedTheme = localStorage.getItem('starlight-theme');
    const systemTheme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    const currentTheme = savedTheme || systemTheme;
    
    // Apply theme
    root.setAttribute('data-theme', currentTheme);
    updateToggleState(toggle, currentTheme);
    
    // Toggle handler with smooth transition
    toggle.addEventListener('click', () => {
      const newTheme = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
      
      // Add transition class
      root.classList.add('theme-transitioning');
      
      // Update theme
      root.setAttribute('data-theme', newTheme);
      localStorage.setItem('starlight-theme', newTheme);
      updateToggleState(toggle, newTheme);
      
      // Remove transition class after animation
      setTimeout(() => {
        root.classList.remove('theme-transitioning');
      }, 300);
    });
    
    // Listen for system theme changes
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
      if (!localStorage.getItem('starlight-theme')) {
        const newTheme = e.matches ? 'dark' : 'light';
        root.setAttribute('data-theme', newTheme);
        updateToggleState(toggle, newTheme);
      }
    });
  };
  
  function updateToggleState(toggle: Element, theme: string) {
    const isDark = theme === 'dark';
    toggle.setAttribute('aria-pressed', String(isDark));
    toggle.setAttribute('title', `Switch to ${isDark ? 'light' : 'dark'} theme`);
    
    // Update icon
    const sunIcon = toggle.querySelector('.sun-icon');
    const moonIcon = toggle.querySelector('.moon-icon');
    if (sunIcon && moonIcon) {
      if (isDark) {
        sunIcon.classList.add('hidden');
        moonIcon.classList.remove('hidden');
      } else {
        sunIcon.classList.remove('hidden');
        moonIcon.classList.add('hidden');
      }
    }
  }
  
  // Initialize on load
  document.addEventListener('DOMContentLoaded', initTheme);
  // Also init on Astro page transitions
  document.addEventListener('astro:page-load', initTheme);
</script>

<button
  data-theme-toggle
  type="button"
  aria-label="Toggle theme"
  class="theme-toggle"
>
  <svg class="sun-icon" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
    <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" />
  </svg>
  <svg class="moon-icon hidden" width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
    <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z" />
  </svg>
</button>

<style>
  .theme-toggle {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 2px solid var(--sl-color-gray-3);
    border-radius: 50%;
    background-color: var(--sl-color-white);
    color: var(--sl-color-gray-6);
    cursor: pointer;
    box-shadow: var(--sl-shadow-md);
    transition: all var(--sl-transition-base);
  }
  
  .theme-toggle:hover {
    transform: scale(1.05);
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent);
    box-shadow: var(--sl-shadow-lg);
  }
  
  .theme-toggle:active {
    transform: scale(0.95);
  }
  
  .theme-toggle svg {
    width: 1.25rem;
    height: 1.25rem;
    transition: all var(--sl-transition-base);
  }
  
  .theme-toggle .hidden {
    display: none;
  }
  
  /* Theme transition styles */
  :global(.theme-transitioning) {
    transition: background-color var(--sl-transition-slow), color var(--sl-transition-slow) !important;
  }
  
  :global(.theme-transitioning *) {
    transition: background-color var(--sl-transition-slow), color var(--sl-transition-slow), border-color var(--sl-transition-slow) !important;
  }
  
  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }
    
    :global(.theme-transitioning),
    :global(.theme-transitioning *) {
      transition: none !important;
    }
  }
  
  /* Mobile positioning */
  @media (max-width: 768px) {
    .theme-toggle {
      bottom: 1rem;
      right: 1rem;
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
