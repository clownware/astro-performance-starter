{
  "permissions": {
    "allow": [
      "Bash(pnpm run:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm exec biome:*)"
    ],
    "ask": [
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)",
      "Edit(/checks/**)",
      "Edit(/scripts/src/enforcement-checks.ts)",
      "Edit(/scripts/src/run-enforcement.ts)",
      "Edit(/scripts/src/adr-guard.ts)",
      "Edit(/scripts/src/adr-append-only.ts)",
      "Edit(/scripts/src/stop-gate.ts)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/src/adr-guard.ts"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/src/stop-gate.ts"
          }
        ]
      }
    ]
  }
}
