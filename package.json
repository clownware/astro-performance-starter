{
  "name": "astro-performance-starter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "dev:debug": "astro dev --verbose",
    "build": "pnpm run tokens:build && astro build",
    "build:full": "pnpm run tokens:build && astro build",
    "build:ci": "pnpm run tokens:build && astro build --verbose",
    "tokens:build": "tsx scripts/src/build-tokens.ts",
    "docs:sync": "tsx scripts/src/sync-docs.ts",
    "docs:update": "tsx scripts/src/sync-docs.ts --update-versions",
    "docs:components": "astrobook dev",
    "docs:components:build": "astrobook build",
    "preview": "pnpm run build:full && astro preview",
    "clean": "rm -rf dist .astro tokens/dist",
    "clean:all": "rm -rf dist .astro tokens/dist node_modules/.cache",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"**/*.mdx\"",
    "lint:md:fix": "markdownlint-cli2 \"**/*.md\" \"**/*.mdx\" --fix",
    "check": "astro check",
    "check:types": "tsc --noEmit",
    "quality": "pnpm run format && pnpm run lint && pnpm run lint:md && pnpm run check",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test --grep=\"@a11y\"",
    "roadmap:update": "tsx scripts/src/update-roadmap-status.ts",
    "images:analyze": "tsx scripts/src/optimize-images.ts",
    "images:optimize": "tsx scripts/src/optimize-images-interactive.ts",
    "bundle:analyze": "pnpm run build && tsx scripts/src/analyze-bundle.ts",
    "perf:budgets": "tsx scripts/src/track-performance-budgets.ts",
    "perf:baseline": "tsx scripts/src/baseline-performance.ts",
    "perf:lighthouse": "lighthouse http://localhost:4321 --output=html --output-path=./lighthouse-report.html",
    "perf:lighthouse:ci": "lighthouse http://localhost:4321 --output=json --output-path=./lighthouse-report.json --chrome-flags=\"--headless\"",
    "design:validate": "tsx scripts/src/validate-contrast.ts",
    "budgets:validate": "tsx scripts/src/validate-budget-overrides.ts",
    "audit": "pnpm audit --production",
    "audit:ci": "tsx scripts/src/audit-filter.ts",
    "prepare": "husky install"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.3.6",
    "@astrojs/preact": "^4.1.1",
    "@astrojs/prefetch": "^0.4.1",
    "@astrojs/sitemap": "^3.6.0",
    "@astrojs/tailwind": "^6.0.2",
    "@fontsource-variable/inter": "^5.2.8",
    "astro-expressive-code": "^0.41.3",
    "preact": "^10.27.2",
    "sharp": "^0.34.4",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/ts-plugin": "^1.10.4",
    "@biomejs/biome": "^2.2.4",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.55.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.6.0",
    "astro": "^5.14.1",
    "astrobook": "^0.8.10",
    "chalk": "^5.6.2",
    "glob": "^11.0.3",
    "globby": "^14.1.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.0",
    "jsdom": "^27.0.0",
    "lighthouse": "^12.8.2",
    "lint-staged": "^15.5.2",
    "markdownlint-cli2": "^0.18.1",
    "remark": "^15.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sharp-cli": "^5.2.0",
    "to-vfile": "^8.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vfile-reporter": "^8.1.1",
    "vitest": "^2.1.9"
  },
  "optionalDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "style-dictionary": "^5.0.4",
    "tailwindcss-themer": "^4.1.1"
  },
  "lint-staged": {
    "*.{astro,ts,tsx,js,jsx,json,yml,yaml}": "biome check --write --no-errors-on-unmatched",
    "*.{md,mdx}": "markdownlint-cli2 --fix"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
