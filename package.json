{
  "name": "astro-performance-starter",
  "version": "0.2.0",
  "description": "Production-ready Astro starter with zero-JS baseline, 95+ Lighthouse scores, design tokens, and AI-optimized documentation.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": ""
  },
  "author": "",
  "license": "MIT",
  "homepage": "",
  "bugs": {
    "url": ""
  },
  "keywords": [
    "astro",
    "starter",
    "template",
    "performance",
    "typescript",
    "tailwindcss",
    "biome",
    "lighthouse",
    "accessibility",
    "wcag"
  ],
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "predev": "pnpm run tokens:build",
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "dev:debug": "astro dev --verbose",
    "build": "pnpm run env:validate && pnpm run tokens:build && astro build",
    "build:ci": "pnpm run env:validate && pnpm run tokens:build && astro build --verbose",
    "tokens:build": "tsx scripts/src/build-tokens.ts",
    "docs:sync": "tsx scripts/src/sync-docs.ts",
    "docs:update": "tsx scripts/src/sync-docs.ts --update-versions",
    "docs:components": "astrobook dev",
    "docs:components:build": "astrobook build",
    "preview": "astro preview",
    "preview:build": "pnpm run build && astro preview",
    "clean": "rm -rf dist .astro tokens/dist",
    "clean:all": "rm -rf dist .astro tokens/dist node_modules/.cache",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "lint": "biome check .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"**/*.mdx\"",
    "lint:md:fix": "markdownlint-cli2 \"**/*.md\" \"**/*.mdx\" --fix",
    "check": "SITE_URL=${SITE_URL:-http://localhost:4321} astro check",
    "check:types": "tsc --noEmit",
    "quality": "pnpm run format && pnpm run lint && pnpm run lint:md && pnpm run check",
    "quality:ci": "pnpm run format:check && pnpm run lint && pnpm run lint:md && pnpm run check && pnpm run test:unit && pnpm run agents:check",
    "test": "SITE_URL=http://localhost:4321 vitest",
    "test:unit": "SITE_URL=http://localhost:4321 vitest run",
    "test:coverage": "SITE_URL=http://localhost:4321 vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test --grep=\"@a11y\"",
    "test:mutate": "SITE_URL=http://localhost:4321 stryker run",
    "roadmap:update": "tsx scripts/src/update-roadmap-status.ts",
    "images:analyze": "tsx scripts/src/optimize-images.ts",
    "images:optimize": "tsx scripts/src/optimize-images-interactive.ts",
    "bundle:analyze": "pnpm run build && tsx scripts/src/analyze-bundle.ts",
    "perf:budgets": "tsx scripts/src/track-performance-budgets.ts",
    "perf:baseline": "tsx scripts/src/baseline-performance.ts",
    "perf:lighthouse": "lighthouse http://localhost:4321 --output=html --output-path=./lighthouse-report.html",
    "perf:lighthouse:ci": "lighthouse http://localhost:4321 --output=json --output-path=./lighthouse-report.json --chrome-flags=\"--headless\"",
    "design:validate": "tsx scripts/src/validate-contrast.ts",
    "budgets:validate": "tsx scripts/src/validate-budget-overrides.ts",
    "env:validate": "tsx scripts/src/validate-env.ts",
    "agents:build": "tsx scripts/src/build-agents-md.ts build",
    "agents:check": "tsx scripts/src/build-agents-md.ts check",
    "audit": "pnpm audit --production",
    "audit:ci": "tsx scripts/src/audit-filter.ts",
    "release:changelog": "changelogen --output CHANGELOG.md",
    "release:changelog:dry": "changelogen --dry",
    "prepare": "husky install"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.2",
    "@astrojs/preact": "^5.1.3",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@preact/signals": "^2.9.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro-expressive-code": "^0.41.7",
    "preact": "^10.29.0",
    "sharp": "^0.34.5",
    "tailwindcss": "4.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/ts-plugin": "^1.10.7",
    "@biomejs/biome": "^2.4.11",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@playwright/test": "^1.59.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.6.0",
    "@vitest/coverage-v8": "^4.1.6",
    "astro": "^6.0.8",
    "astrobook": "^0.13.0",
    "chalk": "^5.6.2",
    "changelogen": "^0.6.2",
    "glob": "^11.0.3",
    "globby": "^14.1.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "js-yaml": "^4.1.1",
    "jsdom": "^29.1.1",
    "lighthouse": "^13.0.3",
    "lint-staged": "^16.4.0",
    "markdownlint-cli2": "^0.22.0",
    "remark": "^15.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "sharp-cli": "^5.2.0",
    "to-vfile": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile-reporter": "^8.1.1",
    "vitest": "^4.1.6"
  },
  "optionalDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "style-dictionary": "^5.4.0",
    "tailwindcss-themer": "^4.1.1"
  },
  "lint-staged": {
    "*.{astro,ts,tsx,js,jsx,json,yml,yaml}": "biome check --write --no-errors-on-unmatched",
    "*.{md,mdx}": "markdownlint-cli2 --fix"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  }
}
