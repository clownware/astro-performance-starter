{
  "ignorePatterns": [
    {
      "pattern": "^(?!https?://)"
    },
    {
      "pattern": "^https?://localhost"
    },
    {
      "pattern": "YOUR_ORG|YOUR_REPO|yourdomain\\.com"
    },
    {
      "pattern": "\\$\\{"
    },
    {
      "pattern": "shields\\.io"
    },
    {
      "pattern": "github\\.com/\\.\\.\\."
    },
    {
      "pattern": "github\\.com/username/"
    }
  ],
  "aliveStatusCodes": [200, 206, 403, 429, 999],
  "timeout": "10s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s"
}
