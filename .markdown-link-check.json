{
  "ignorePatterns": [
    {
      "pattern": "^(?!https?://)"
    },
    {
      "pattern": "github\\.com/YOUR_ORG/YOUR_REPO/issues"
    },
    {
      "pattern": "github\\.com/YOUR_ORG/YOUR_REPO/discussions"
    },
    {
      "pattern": "\\$\\{"
    },
    {
      "pattern": "shields\\.io"
    },
    {
      "pattern": "github\\.com/\\.\\.\\."
    },
    {
      "pattern": "github\\.com/username/"
    }
  ],
  "aliveStatusCodes": [200, 206, 999],
  "timeout": "10s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s"
}
