# ============================================
# Astro Performance Starter - .gitignore
# ============================================

# ---------------------------------------------
# Node.js & Package Managers
# ---------------------------------------------
node_modules/
.pnpm/
.pnpm-store/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.pnpm-debug.log
package-lock.json
yarn.lock

# ---------------------------------------------
# Build Output
# ---------------------------------------------
dist/
.astro/
.next/
out/
.vercel/
.vite/

# Design Tokens (generated)
tokens/dist/

# ---------------------------------------------
# Environment Variables
# ---------------------------------------------
.env
.env.*
!.env.example

# ---------------------------------------------
# TypeScript
# ---------------------------------------------
*.tsbuildinfo

# ---------------------------------------------
# Testing
# ---------------------------------------------
# Vitest
coverage/

# Playwright
playwright-report/
test-results/
playwright/.cache/

# Lighthouse
lighthouse-report.html
lighthouse-report.json
.lighthouseci/
lighthouse-ci-reports/

# ---------------------------------------------
# Image Processing
# ---------------------------------------------
.sharp-cache
src/assets/images/processed/*
.backups/

# ---------------------------------------------
# Linting & Formatting
# ---------------------------------------------
.eslintcache
.stylelintcache

# ---------------------------------------------
# Build Artifacts
# ---------------------------------------------
frontmatter-report.json

# ---------------------------------------------
# IDE & Editor Files
# ---------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ---------------------------------------------
# Claude Code (personal/ephemeral files)
# ---------------------------------------------
.claude/settings.local.json
.claude/plans/
.claude/worktrees/

# ---------------------------------------------
# Operating System Files
# ---------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini

# Linux
.directory
.Trash-*

# ---------------------------------------------
# Temporary & Cache Files
# ---------------------------------------------
.cache/
.parcel-cache/
*.tmp
*.temp

# ---------------------------------------------
# Mutation Testing (Stryker) — see ADR-042
# ---------------------------------------------
.stryker-tmp/
reports/mutation/
